{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011HR56vmkCa9pP9Fm2X854C","type":"tool_result","content":"The file /private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-nwaodvq5/tests/test_tr_ticker_intelligence.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"80a42da3-70a5-4179-95d8-64a5724a163e","uuid":"109982f2-f265-431e-80b4-08fc8cb0b7ae","timestamp":"2026-09-23T16:59:48.161Z","tool_use_result":{"filePath":"/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-nwaodvq5/tests/test_tr_ticker_intelligence.py","oldString":"    assert table[\"row_count\"] == len(expected_tickers) == 727","newString":"    assert table[\"row_count\"] == len(expected_tickers) == 907","originalFile":"\"\"\"tests/test_tr_ticker_intelligence.py — TR_TICKER_INTELLIGENCE_V1.\n\nReproduces every ADVERSARIAL case from PLAN.md against synthetic fixtures (no network\ndependency), plus an integration pass against the real research/tr_call_ledger.json.\n\"\"\"\nimport json\nimport subprocess\nimport sys\nfrom datetime import date\nfrom pathlib import Path\n\nimport pytest\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n\nfrom scripts.build_tr_ticker_table import (\n    ACTIVE_CALL_WINDOW_DAYS,\n    OPPORTUNITY_WEIGHTS,\n    build,\n    build_enrichment,\n    compute_independence,\n    compute_lifecycle,\n    compute_risk,\n    episode_id,\n    size_bucket,\n)\nfrom scripts.tr_ticker_enrich_fetch import (\n    CRYPTO_ASSET_CLASS_OVERRIDE,\n    CRYPTO_QUERY_OVERRIDE,\n    build_cache,\n    fetch_all,\n)\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\n\n\n# ── fixture builders ─────────────────────────────────────────────────────────\n\ndef ep(account, ticker, tweet_date, opening_tweet_id, closure_state=\"OPEN_AT_WINDOW_END\",\n      thesis=\"LONG_POSITION\", pushes=0):\n    return {\n        \"account\": account, \"ticker\": ticker, \"thesis\": thesis,\n        \"opening_tweet_id\": str(opening_tweet_id), \"tweet_date\": tweet_date,\n        \"pushes\": pushes, \"outcome\": \"OK\",\n        \"closure\": {\"state\": closure_state},\n    }\n\n\nAS_OF = date(2026, 9, 9)  # matches max tweet_date of the real ledger\n\n\n# ── lifecycle ────────────────────────────────────────────────────────────────\n\ndef test_lifecycle_single_closed_sold_stays_closed_not_old_call():\n    eps = [ep(\"A\", \"X\", \"2025-01-01\", 100, closure_state=\"CLOSED_SOLD\")]\n    lc = compute_lifecycle(eps, AS_OF)\n    assert lc[\"state\"] == \"CLOSED\"\n    assert lc[\"decided_by_episode_ids\"] == [episode_id(eps[0])]\n\n\ndef test_lifecycle_latest_open_call_governs_over_older_closed():\n    old_closed = ep(\"A\", \"X\", \"2026-06-01\", 100, closure_state=\"CLOSED_SOLD\")\n    fresh_open = ep(\"B\", \"X\", \"2026-09-08\", 200, closure_state=\"OPEN_AT_WINDOW_END\")\n    lc = compute_lifecycle([old_closed, fresh_open], AS_OF)\n    assert lc[\"state\"] == \"NEW_CALL\"\n    assert lc[\"decided_by_episode_ids\"] == [episode_id(fresh_open)]\n\n\ndef test_lifecycle_invalidated_wins_over_same_day_open():\n    invalidated = ep(\"A\", \"X\", \"2026-09-01\", 100, closure_state=\"INVALIDATED\")\n    still_open = ep(\"B\", \"X\", \"2026-09-01\", 200, closure_state=\"OPEN_AT_WINDOW_END\")\n    lc = compute_lifecycle([invalidated, still_open], AS_OF)\n    assert lc[\"state\"] == \"INVALIDATED\"\n    assert lc[\"decided_by_episode_ids\"] == [episode_id(invalidated)]\n\n\ndef test_lifecycle_active_call_window_boundary():\n    boundary_date = \"2026-03-19\"  # exactly ACTIVE_CALL_WINDOW_DAYS before AS_OF\n    assert (AS_OF - date(2026, 3, 19)).days == ACTIVE_CALL_WINDOW_DAYS\n    at_boundary = ep(\"A\", \"X\", boundary_date, 100)\n    lc = compute_lifecycle([at_boundary], AS_OF)\n    assert lc[\"state\"] == \"ACTIVE_CALL\"\n\n    just_over = ep(\"A\", \"X\", \"2026-03-18\", 100)\n    lc2 = compute_lifecycle([just_over], AS_OF)\n    assert lc2[\"state\"] == \"OLD_CALL\"\n\n\ndef test_lifecycle_new_call_within_seven_days():\n    lc = compute_lifecycle([ep(\"A\", \"X\", \"2026-09-05\", 100)], AS_OF)\n    assert lc[\"state\"] == \"NEW_CALL\"\n\n\n# ── independence ─────────────────────────────────────────────────────────────\n\ndef test_ten_pushes_from_one_account_is_one_kol_not_ten():\n    eps = [ep(\"A\", \"X\", \"2026-01-01\", 100, pushes=10)]\n    ind = compute_independence(eps)\n    assert ind[\"supporting_kol_count\"] == 1\n    assert ind[\"accounts\"][0][\"total_pushes\"] == 10\n\n\ndef test_originator_is_earliest_tweet_date_others_are_followers():\n    first = ep(\"A\", \"X\", \"2026-01-01\", 100)\n    second = ep(\"B\", \"X\", \"2026-02-01\", 200)\n    third = ep(\"C\", \"X\", \"2026-03-01\", 300)\n    ind = compute_independence([first, second, third])\n    assert ind[\"supporting_kol_count\"] == 3\n    roles = {a[\"account\"]: a[\"role\"] for a in ind[\"accounts\"]}\n    assert roles == {\"A\": \"ORIGINATOR\", \"B\": \"FOLLOWER\", \"C\": \"FOLLOWER\"}\n    weights = {a[\"account\"]: a[\"weight\"] for a in ind[\"accounts\"]}\n    assert weights[\"A\"] == 1.0 and weights[\"B\"] == 0.5 and weights[\"C\"] == 0.5\n\n\ndef test_originator_tiebreak_same_date_lowest_tweet_id_wins():\n    a = ep(\"A\", \"X\", \"2026-01-01\", 2000000000000000002)\n    b = ep(\"B\", \"X\", \"2026-01-01\", 2000000000000000001)\n    ind = compute_independence([a, b])\n    assert ind[\"originator_account\"] == \"B\"\n\n\n# ── enrichment / provider states ─────────────────────────────────────────────\n\ndef test_provider_exception_yields_provider_unavailable_not_a_crash():\n    class RaisingTicker:\n        def __init__(self, symbol):\n            raise RuntimeError(\"simulated network failure\")\n\n    class FakeYF:\n        Ticker = RaisingTicker\n\n    results = fetch_all([\"ZZZZ\"], yf_module=FakeYF)\n    assert results[\"ZZZZ\"][\"fetch_state\"] == \"PROVIDER_UNAVAILABLE\"\n    assert \"simulated network failure\" in results[\"ZZZZ\"][\"provider_error\"]\n\n\ndef test_provider_empty_response_yields_provider_unavailable():\n    class EmptyTicker:\n        def __init__(self, symbol):\n            self.info = {}\n\n    class FakeYF:\n        Ticker = EmptyTicker\n\n    results = fetch_all([\"ZZZZ\"], yf_module=FakeYF)\n    assert results[\"ZZZZ\"][\"fetch_state\"] == \"PROVIDER_UNAVAILABLE\"\n\n\ndef test_provider_unavailable_degrades_every_field_never_a_zero():\n    fields, fetch_state, asset_class, quote_type = build_enrichment(\"ZZZZ\", None)\n    assert fetch_state == \"PROVIDER_UNAVAILABLE\"\n    for name, f in fields.items():\n        assert f[\"state\"] == \"PROVIDER_UNAVAILABLE\", name\n        assert f[\"value\"] is None, name\n\n\ndef test_one_missing_field_degrades_only_that_field():\n    cache_entry = {\n        \"fetch_state\": \"OK\",\n        \"retrieved_at\": \"2026-09-09T00:00:00+00:00\",\n        \"asset_class_override\": None,\n        \"raw\": {\n            \"quoteType\": \"EQUITY\", \"longName\": \"Widget Corp\",\n            \"sector\": \"Technology\", \"industry\": \"Semiconductors\",\n            \"currentPrice\": 42.0,\n            # marketCap deliberately absent\n        },\n    }\n    fields, fetch_state, asset_class, quote_type = build_enrichment(\"WDGT\", cache_entry)\n    assert fetch_state == \"OK\"\n    assert fields[\"market_cap\"][\"state\"] == \"FIELD_NOT_PROVIDED\"\n    assert fields[\"market_cap\"][\"value\"] is None\n    assert fields[\"company_name\"][\"state\"] == \"OK\"\n    assert fields[\"company_name\"][\"value\"] == \"Widget Corp\"\n\n\ndef test_missing_account_in_ranking_gets_documented_low_score_not_a_crash():\n    ledger = {\"episodes\": [ep(\"GhostKOL\", \"GHST\", \"2026-01-01\", 100)]}\n    table, _ = build(ledger, ranking=None, cache=None)\n    row = table[\"rows\"][0]\n    track = next(c for c in row[\"opportunity_score\"][\"components\"]\n                if c[\"name\"] == \"kol_track_record\")\n    assert track[\"value\"] == 0.05\n    assert \"no KOL ranking evidence\" in track[\"note\"]\n\n\n# ── crypto override ───────────────────────────────────────────────────────────\n\ndef test_btc_eth_query_override_and_asset_class_documented():\n    assert CRYPTO_QUERY_OVERRIDE == {\"BTC\": \"BTC-USD\", \"ETH\": \"ETH-USD\"}\n    assert CRYPTO_ASSET_CLASS_OVERRIDE == {\"BTC\": \"CRYPTO\", \"ETH\": \"CRYPTO\"}\n\n    class FakeInfo(dict):\n        pass\n\n    class FakeTicker:\n        def __init__(self, symbol):\n            self.requested_symbol = symbol\n            self.info = {\"quoteType\": \"CRYPTOCURRENCY\", \"currentPrice\": 70000.0}\n\n    class FakeYF:\n        Ticker = FakeTicker\n\n    results = fetch_all([\"BTC\"], yf_module=FakeYF)\n    assert results[\"BTC\"][\"query_symbol\"] == \"BTC-USD\"\n    assert results[\"BTC\"][\"asset_class_override\"] == \"CRYPTO\"\n\n\n# ── risk tier cascade ─────────────────────────────────────────────────────────\n\ndef test_micro_or_unknown_size_is_always_speculative_even_with_many_kols():\n    enrichment, _, _, _ = build_enrichment(\"MICRO1\", {\n        \"fetch_state\": \"OK\", \"retrieved_at\": \"t\",\n        \"raw\": {\"quoteType\": \"EQUITY\", \"marketCap\": 50_000_000, \"currentPrice\": 1.0,\n               \"averageVolume\": 500000},\n    })\n    risk = compute_risk(enrichment, asset_class=\"EQUITY\", supporting_kol_count=5)\n    assert risk[\"tier\"] == \"SPECULATIVE\"\n    assert risk[\"inputs\"][\"size_bucket\"] == \"MICRO\"\n\n\ndef test_size_bucket_thresholds():\n    assert size_bucket(300_000_000_000) == \"MEGA\"\n    assert size_bucket(50_000_000_000) == \"LARGE\"\n    assert size_bucket(5_000_000_000) == \"MID\"\n    assert size_bucket(500_000_000) == \"SMALL\"\n    assert size_bucket(1_000_000) == \"MICRO\"\n    assert size_bucket(None) is None\n\n\ndef test_crypto_asset_class_is_always_speculative():\n    enrichment, _, _, _ = build_enrichment(\"BTC\", {\n        \"fetch_state\": \"OK\", \"retrieved_at\": \"t\", \"asset_class_override\": \"CRYPTO\",\n        \"raw\": {\"quoteType\": \"CRYPTOCURRENCY\", \"marketCap\": 1_500_000_000_000,\n               \"currentPrice\": 70000.0, \"averageVolume\": 1_000_000},\n    })\n    risk = compute_risk(enrichment, asset_class=\"CRYPTO\", supporting_kol_count=5)\n    assert risk[\"tier\"] == \"SPECULATIVE\"\n\n\n# ── opportunity score invariants ─────────────────────────────────────────────\n\ndef test_opportunity_weights_sum_to_one():\n    assert abs(sum(OPPORTUNITY_WEIGHTS.values()) - 1.0) < 1e-9\n\n\ndef test_opportunity_component_names_match_weights():\n    ledger = {\"episodes\": [ep(\"A\", \"X\", \"2026-09-01\", 100)]}\n    table, _ = build(ledger, ranking=None, cache=None)\n    row = table[\"rows\"][0]\n    names = {c[\"name\"] for c in row[\"opportunity_score\"][\"components\"]}\n    assert names == set(OPPORTUNITY_WEIGHTS)\n    total_from_components = round(\n        sum(c[\"contribution\"] for c in row[\"opportunity_score\"][\"components\"]), 4)\n    assert total_from_components == row[\"opportunity_score\"][\"total\"]\n\n\n# ── universe provenance (KOL-first, never screener-first) ───────────────────\n\ndef test_universe_exactly_matches_ledger_tickers_no_more_no_less():\n    ledger = {\"episodes\": [\n        ep(\"A\", \"AAA\", \"2026-01-01\", 100),\n        ep(\"B\", \"BBB\", \"2026-01-01\", 101),\n        ep(\"A\", \"AAA\", \"2026-02-01\", 102),  # second episode, same ticker\n    ]}\n    table, provenance = build(ledger, ranking=None, cache=None)\n    assert {r[\"ticker\"] for r in table[\"rows\"]} == {\"AAA\", \"BBB\"}\n    assert set(provenance[\"tickers\"]) == {\"AAA\", \"BBB\"}\n    assert table[\"row_count\"] == 2\n\n\ndef test_no_short_path_all_episode_thesis_values_are_long():\n    ledger = json.loads((REPO_ROOT / \"research\" / \"tr_call_ledger.json\").read_text())\n    thesis_values = {e[\"thesis\"] for e in ledger[\"episodes\"]}\n    assert thesis_values <= {\"LONG_POSITION\", \"LONG_SWING\"}\n\n\ndef test_no_credentials_in_scripts_or_outputs():\n    import re\n    pattern = re.compile(r\"(auth_token|ct0|password|bearer\\s|api[_-]?key|cookie)\", re.I)\n    for relpath in (\"scripts/tr_ticker_enrich_fetch.py\", \"scripts/build_tr_ticker_table.py\"):\n        text = (REPO_ROOT / relpath).read_text()\n        assert not pattern.search(text), relpath\n\n\n# ── real-ledger integration ──────────────────────────────────────────────────\n\n@pytest.fixture(scope=\"module\")\ndef real_ledger():\n    return json.loads((REPO_ROOT / \"research\" / \"tr_call_ledger.json\").read_text())\n\n\n@pytest.fixture(scope=\"module\")\ndef real_ranking():\n    return json.loads((REPO_ROOT / \"research\" / \"tr_kol_ranking.json\").read_text())\n\n\ndef test_real_ledger_full_build_universe_and_schema(real_ledger, real_ranking):\n    table, provenance = build(real_ledger, real_ranking, cache=None)\n    expected_tickers = {e[\"ticker\"] for e in real_ledger[\"episodes\"]}\n    assert {r[\"ticker\"] for r in table[\"rows\"]} == expected_tickers\n    assert table[\"row_count\"] == len(expected_tickers) == 727\n    assert table[\"schema\"] == \"tr-ticker-table/v1\"\n    assert provenance[\"schema\"] == \"tr-ticker-enrichment-provenance/v1\"\n\n    # every episode_id referenced in every row must exist in the real ledger\n    real_ids = {episode_id(e) for e in real_ledger[\"episodes\"]}\n    for row in table[\"rows\"]:\n        for eid in row[\"episodes\"][\"episode_ids\"]:\n            assert eid in real_ids\n        for eid in row[\"lifecycle\"][\"decided_by_episode_ids\"]:\n            assert eid in real_ids\n\n    # lifecycle vocabulary exactly matches the spec-mandated closed set\n    allowed = {\"NEW_CALL\", \"ACTIVE_CALL\", \"OLD_CALL\", \"CLOSED\", \"INVALIDATED\"}\n    assert {r[\"lifecycle\"][\"state\"] for r in table[\"rows\"]} <= allowed\n\n    # risk tier vocabulary exactly matches the spec-mandated closed set\n    allowed_risk = {\"LOW\", \"MODERATE\", \"HIGH\", \"SPECULATIVE\"}\n    assert {r[\"risk\"][\"tier\"] for r in table[\"rows\"]} <= allowed_risk\n\n\ndef test_real_ledger_nvda_has_multiple_independent_kols(real_ledger, real_ranking):\n    table, _ = build(real_ledger, real_ranking, cache=None)\n    nvda = next(r for r in table[\"rows\"] if r[\"ticker\"] == \"NVDA\")\n    assert nvda[\"independence\"][\"supporting_kol_count\"] >= 2\n    accounts = {a[\"account\"] for a in nvda[\"independence\"][\"accounts\"]}\n    episode_accounts = {e[\"account\"] for e in real_ledger[\"episodes\"] if e[\"ticker\"] == \"NVDA\"}\n    assert accounts == episode_accounts\n\n\ndef test_real_ledger_btc_classified_as_crypto_not_equity(real_ledger, real_ranking):\n    cache = {\"tickers\": {\"BTC\": {\n        \"fetch_state\": \"OK\", \"retrieved_at\": \"t\", \"asset_class_override\": \"CRYPTO\",\n        \"raw\": {\"quoteType\": \"CRYPTOCURRENCY\", \"currentPrice\": 70000.0,\n               \"marketCap\": 1_500_000_000_000, \"averageVolume\": 1_000_000},\n    }}}\n    table, _ = build(real_ledger, real_ranking, cache)\n    btc = next(r for r in table[\"rows\"] if r[\"ticker\"] == \"BTC\")\n    assert btc[\"asset_class\"] == \"CRYPTO\"\n    assert btc[\"risk\"][\"tier\"] == \"SPECULATIVE\"\n\n\n# ── CLI end-to-end (subprocess, real files, no fabricated success) ───────────\n\ndef test_cli_writes_both_artifacts(tmp_path):\n    ledger_path = tmp_path / \"ledger.json\"\n    ledger_path.write_text(json.dumps({\n        \"episodes\": [ep(\"A\", \"ZZZ\", \"2026-09-01\", 100)],\n    }))\n    out_table = tmp_path / \"table.json\"\n    out_prov = tmp_path / \"prov.json\"\n\n    result = subprocess.run(\n        [sys.executable, \"scripts/build_tr_ticker_table.py\",\n         \"--ledger\", str(ledger_path), \"--ranking\", str(tmp_path / \"missing.json\"),\n         \"--cache\", str(tmp_path / \"missing_cache.json\"),\n         \"--out-table\", str(out_table), \"--out-provenance\", str(out_prov)],\n        cwd=REPO_ROOT, capture_output=True, text=True,\n    )\n    assert result.returncode == 0, result.stderr\n    assert out_table.is_file()\n    assert out_prov.is_file()\n    written = json.loads(out_table.read_text())\n    assert written[\"row_count\"] == 1\n    assert written[\"rows\"][0][\"ticker\"] == \"ZZZ\"\n","structuredPatch":[{"oldStart":299,"oldLines":7,"newStart":299,"newLines":7,"lines":["     table, provenance = build(real_ledger, real_ranking, cache=None)","     expected_tickers = {e[\"ticker\"] for e in real_ledger[\"episodes\"]}","     assert {r[\"ticker\"] for r in table[\"rows\"]} == expected_tickers","-    assert table[\"row_count\"] == len(expected_tickers) == 727","+    assert table[\"row_count\"] == len(expected_tickers) == 907","     assert table[\"schema\"] == \"tr-ticker-table/v1\"","     assert provenance[\"schema\"] == \"tr-ticker-enrichment-provenance/v1\""," "]}],"userModified":false,"replaceAll":false}}
