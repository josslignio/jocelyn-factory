{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FXx2FGkEpjfPuM9wsEoVM1","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"build_tr_ticker_table.py — TR_TICKER_INTELLIGENCE_V1.\n3\t\n4\tBuilds research/tr_ticker_table.json and research/tr_ticker_enrichment_provenance.json\n5\tfrom research/tr_call_ledger.json — the ONLY admissible source of the ticker universe\n6\t(SPEC.md, \"Universe provenance — KOL-first, never screener-first\"). Never seeds from an\n7\texchange list, index, screener or generic market feed. Read-only against the ledger: never\n8\ttouches entry_date/entry_price/horizons/closure (frozen, no re-selection after observing\n9\tthe future).\n10\t\n11\tSee PLAN.md for the full rule derivation (lifecycle priority, independence weighting,\n12\ttaxonomy, risk cascade, opportunity-score weights) with the factual discovery behind each\n13\tchoice.\n14\t\"\"\"\n15\tfrom __future__ import annotations\n16\t\n17\timport argparse\n18\timport json\n19\tfrom collections import defaultdict\n20\tfrom datetime import date, datetime, timezone\n21\tfrom pathlib import Path\n22\t\n23\tSCHEMA_TABLE = \"tr-ticker-table/v1\"\n24\tSCHEMA_PROVENANCE = \"tr-ticker-enrichment-provenance/v1\"\n25\t\n26\tOPEN_CLOSURE_STATES = {\"OPEN_AT_WINDOW_END\", \"NOT_EVALUABLE\", \"SAME_DAY_UNORDERED\"}\n27\tNEW_CALL_WINDOW_DAYS = 7\n28\t# 120 trading sessions (the longest frozen evaluation horizon in SPEC.md) * 365/252\n29\t# calendar-to-trading-day ratio ~= 174 calendar days. Not an arbitrary business\n30\t# threshold: tied to the already-frozen horizon set, so it can't silently drift.\n31\tACTIVE_CALL_WINDOW_DAYS = 174\n32\t\n33\tFOLLOWER_WEIGHT = 0.5\n34\tORIGINATOR_WEIGHT = 1.0\n35\t\n36\tSIZE_BUCKET_THRESHOLDS = (\n37\t    (\"MEGA\", 200_000_000_000),\n38\t    (\"LARGE\", 10_000_000_000),\n39\t    (\"MID\", 2_000_000_000),\n40\t    (\"SMALL\", 300_000_000),\n41\t)\n42\t\n43\tTAXONOMY_RULES = [\n44\t    (\"semiconductors_compute\",\n45\t     [\"semiconductor\", \"chip\", \"foundry\", \"wafer\", \" gpu\", \" cpu\", \"asic\", \"fpga\",\n46\t      \"integrated circuit\"]),\n47\t    (\"cloud_datacenter_network\",\n48\t     [\"data center\", \"datacenter\", \"cloud computing\", \"networking\", \"hyperscale\",\n49\t      \"colocation\", \"internet service\"]),\n50\t    (\"energy_cooling_infra\",\n51\t     [\"cooling\", \"power generation\", \"electric utility\", \"nuclear\", \"battery storage\",\n52\t      \"electrical grid\", \"liquid cooling\", \"hvac\", \"renewable\"]),\n53\t    (\"enterprise_software\",\n54\t     [\"enterprise software\", \"saas\", \"erp\", \" crm\", \"cybersecurity\", \"application software\",\n55\t      \"infrastructure software\"]),\n56\t    (\"consumer_software\",\n57\t     [\"social media\", \"e-commerce\", \"internet content\", \"mobile application\",\n58\t      \"consumer electronics\"]),\n59\t    (\"robotics_automation\",\n60\t     [\"robot\", \"automation\", \"industrial machinery\", \"drone\", \"unmanned\"]),\n61\t    (\"defense_autonomy\",\n62\t     [\"aerospace & defense\", \"aerospace and defense\", \"defense\", \"military\", \"satellite\",\n63\t      \"space\", \"missile\"]),\n64\t    (\"healthcare_biotech_ai\",\n65\t     [\"biotechnology\", \"health care\", \"healthcare\", \"pharmaceutical\", \"medical device\",\n66\t      \"diagnostics\"]),\n67\t    (\"adjacent_supplier\",\n68\t     [\"specialty chemicals\", \"mining\", \"metals\", \"materials\", \"industrial distribution\"]),\n69\t]\n70\t\n71\tVALUE_CHAIN_ROLE = {\n72\t    \"semiconductors_compute\": \"upstream_compute_hardware\",\n73\t    \"cloud_datacenter_network\": \"midstream_infrastructure\",\n74\t    \"energy_cooling_infra\": \"midstream_infrastructure_power\",\n75\t    \"enterprise_software\": \"downstream_application_layer\",\n76\t    \"consumer_software\": \"downstream_application_layer\",\n77\t    \"robotics_automation\": \"downstream_application_layer_physical\",\n78\t    \"defense_autonomy\": \"downstream_application_layer_defense\",\n79\t    \"healthcare_biotech_ai\": \"downstream_application_layer_healthcare\",\n80\t    \"adjacent_supplier\": \"upstream_adjacent_materials\",\n81\t    \"crypto_digital_asset\": \"not_applicable_non_equity_asset\",\n82\t    \"broad_market_etf_index\": \"not_applicable_broad_market_vehicle\",\n83\t    \"UNCLASSIFIED\": \"UNCLASSIFIED\",\n84\t}\n85\t\n86\tOPPORTUNITY_WEIGHTS = {\n87\t    \"kol_independence\": 0.30,\n88\t    \"kol_track_record\": 0.25,\n89\t    \"conviction_recency\": 0.20,\n90\t    \"momentum_not_overextended\": 0.15,\n91\t    \"data_quality\": 0.10,\n92\t}\n93\tassert abs(sum(OPPORTUNITY_WEIGHTS.values()) - 1.0) < 1e-9\n94\t\n95\tENRICHMENT_FIELD_NAMES = (\n96\t    \"company_name\", \"description\", \"ai_subindustry\", \"market_country\", \"market_cap\",\n97\t    \"trailing_pe\", \"forward_pe\", \"price_to_book\", \"revenue\", \"revenue_growth\", \"cash\",\n98\t    \"debt\", \"profitability\", \"current_price\", \"momentum_state\", \"average_volume\",\n99\t)\n100\t\n101\t\n102\t# ── helpers ──────────────────────────────────────────────────────────────────\n103\t\n104\tdef episode_id(ep: dict) -> str:\n105\t    return f\"{ep['account']}::{ep['ticker']}::{ep['thesis']}::{ep['opening_tweet_id']}\"\n106\t\n107\t\n108\tdef _parse_date(s: str) -> date:\n109\t    return datetime.strptime(s, \"%Y-%m-%d\").date()\n110\t\n111\t\n112\tdef load_json(path: \"Path | None\"):\n113\t    if path is None:\n114\t        return None\n115\t    p = Path(path)\n116\t    if not p.is_file():\n117\t        return None\n118\t    return json.loads(p.read_text(encoding=\"utf-8\"))\n119\t\n120\t\n121\tdef group_by_ticker(episodes: list) -> dict:\n122\t    grouped = defaultdict(list)\n123\t    for ep in episodes:\n124\t        grouped[ep[\"ticker\"]].append(ep)\n125\t    return grouped\n126\t\n127\t\n128\t# ── lifecycle ────────────────────────────────────────────────────────────────\n129\t\n130\tdef compute_lifecycle(ticker_episodes: list, as_of: date) -> dict:\n131\t    latest_date_str = max(ep[\"tweet_date\"] for ep in ticker_episodes)\n132\t    latest_group = [ep for ep in ticker_episodes if ep[\"tweet_date\"] == latest_date_str]\n133\t\n134\t    invalidated = [ep for ep in latest_group\n135\t                   if ep.get(\"closure\", {}).get(\"state\") == \"INVALIDATED\"]\n136\t    still_open = [ep for ep in latest_group\n137\t                  if ep.get(\"closure\", {}).get(\"state\") in OPEN_CLOSURE_STATES]\n138\t    closed = [ep for ep in latest_group\n139\t              if ep.get(\"closure\", {}).get(\"state\") == \"CLOSED_SOLD\"]\n140\t\n141\t    latest_date = _parse_date(latest_date_str)\n142\t    age_days = (as_of - latest_date).days\n143\t\n144\t    if invalidated:\n145\t        state = \"INVALIDATED\"\n146\t        decided_by = invalidated\n147\t        rule = (\"latest-episode-priority: an episode at the ticker's most recent \"\n148\t                \"tweet_date has closure.state==INVALIDATED — invalidation is never \"\n149\t                \"masked by a concurrently open call from another account\")\n150\t    elif still_open:\n151\t        decided_by = still_open\n152\t        if age_days <= NEW_CALL_WINDOW_DAYS:\n153\t            state = \"NEW_CALL\"\n154\t            rule = (f\"latest open episode age_days={age_days} <= \"\n155\t                    f\"{NEW_CALL_WINDOW_DAYS} (fast-loop weekly detection window)\")\n156\t        elif age_days <= ACTIVE_CALL_WINDOW_DAYS:\n157\t            state = \"ACTIVE_CALL\"\n158\t            rule = (f\"latest open episode age_days={age_days} <= \"\n159\t                    f\"{ACTIVE_CALL_WINDOW_DAYS} (120-trading-session frozen \"\n160\t                    \"evaluation horizon expressed in calendar days)\")\n161\t        else:\n162\t            state = \"OLD_CALL\"\n163\t            rule = (f\"latest open episode age_days={age_days} > \"\n164\t                    f\"{ACTIVE_CALL_WINDOW_DAYS}, still no explicit closure/invalidation\")\n165\t    else:\n166\t        # every episode at the latest date is CLOSED_SOLD\n167\t        state = \"CLOSED\"\n168\t        decided_by = closed\n169\t        rule = (\"latest-episode-priority: every episode at the ticker's most recent \"\n170\t                \"tweet_date has closure.state==CLOSED_SOLD, none open, none invalidated\")\n171\t\n172\t    return {\n173\t        \"state\": state,\n174\t        \"rule\": rule,\n175\t        \"as_of_date\": as_of.isoformat(),\n176\t        \"latest_tweet_date\": latest_date_str,\n177\t        \"age_days_vs_as_of\": age_days,\n178\t        \"decided_by_episode_ids\": sorted(episode_id(ep) for ep in decided_by),\n179\t        \"decided_by_opening_tweet_ids\": sorted({ep[\"opening_tweet_id\"] for ep in decided_by}),\n180\t    }\n181\t\n182\t\n183\t# ── independence ─────────────────────────────────────────────────────────────\n184\t\n185\tdef compute_independence(ticker_episodes: list) -> dict:\n186\t    by_account = defaultdict(list)\n187\t    for ep in ticker_episodes:\n188\t        by_account[ep[\"account\"]].append(ep)\n189\t\n190\t    def first_ep(eps):\n191\t        return min(eps, key=lambda e: (e[\"tweet_date\"], int(e[\"opening_tweet_id\"])))\n192\t\n193\t    originator_account = min(\n194\t        by_account, key=lambda acc: (first_ep(by_account[acc])[\"tweet_date\"],\n195\t                                      int(first_ep(by_account[acc])[\"opening_tweet_id\"])))\n196\t\n197\t    accounts = []\n198\t    for acc, eps in sorted(by_account.items()):\n199\t        fe = first_ep(eps)\n200\t        role = \"ORIGINATOR\" if acc == originator_account else \"FOLLOWER\"\n201\t        weight = ORIGINATOR_WEIGHT if role == \"ORIGINATOR\" else FOLLOWER_WEIGHT\n202\t        accounts.append({\n203\t            \"account\": acc,\n204\t            \"role\": role,\n205\t            \"weight\": weight,\n206\t            \"first_tweet_date\": fe[\"tweet_date\"],\n207\t            \"episode_id\": episode_id(fe),\n208\t            \"episode_count\": len(eps),\n209\t            \"total_pushes\": sum(e.get(\"pushes\", 0) for e in eps),\n210\t        })\n211\t\n212\t    return {\n213\t        \"supporting_kol_count\": len(by_account),\n214\t        \"originator_account\": originator_account,\n215\t        \"accounts\": accounts,\n216\t        \"rule\": (\"distinct accounts with >=1 qualified LONG episode on this ticker; \"\n217\t                 \"10 pushes from one account is one account, never 10. Originator = \"\n218\t                 \"account with the earliest tweet_date (tie-break: lowest \"\n219\t                 \"opening_tweet_id) across all its episodes on this ticker; every \"\n220\t                 f\"other contributing account is FOLLOWER (weight {FOLLOWER_WEIGHT} \"\n221\t                 f\"vs ORIGINATOR weight {ORIGINATOR_WEIGHT} — independent conviction \"\n222\t                 \"recorded, but never silently equal to origination)\"),\n223\t    }\n224\t\n225\t\n226\t# ── enrichment / taxonomy ────────────────────────────────────────────────────\n227\t\n228\tdef classify_taxonomy(asset_class: str, quote_type: \"str | None\", sector: \"str | None\",\n229\t                      industry: \"str | None\", summary: \"str | None\") -> tuple:\n230\t    if asset_class == \"CRYPTO\":\n231\t        return \"crypto_digital_asset\", \"asset_class_override=CRYPTO\"\n232\t    if quote_type in (\"ETF\", \"INDEX\", \"MUTUALFUND\"):\n233\t        return \"broad_market_etf_index\", f\"quoteType={quote_type}\"\n234\t    haystack = \" \".join(x for x in (sector, industry, summary) if x).lower()\n235\t    if not haystack:\n236\t        return None, \"sector/industry/summary all unavailable — cannot classify\"\n237\t    for category, keywords in TAXONOMY_RULES:\n238\t        for kw in keywords:\n239\t            if kw in haystack:\n240\t                return category, f\"matched keyword {kw!r} in sector/industry/summary\"\n241\t    return \"UNCLASSIFIED\", \"no taxonomy keyword matched sector/industry/summary\"\n242\t\n243\t\n244\tdef size_bucket(market_cap: \"float | None\") -> \"str | None\":\n245\t    if market_cap is None:\n246\t        return None\n247\t    for label, floor in SIZE_BUCKET_THRESHOLDS:\n248\t        if market_cap >= floor:\n249\t            return label\n250\t    return \"MICRO\"\n251\t\n252\t\n253\tdef momentum_state(current_price, fifty_day, two_hundred_day, fifty_two_wk_high) -> \"str | None\":\n254\t    if current_price is None:\n255\t        return None\n256\t    if fifty_two_wk_high and current_price >= 0.95 * fifty_two_wk_high \\\n257\t            and fifty_day and two_hundred_day and current_price > fifty_day > two_hundred_day:\n258\t        return \"EXTENDED_NEAR_52W_HIGH\"\n259\t    if fifty_day is not None and two_hundred_day is not None:\n260\t        if current_price > fifty_day > two_hundred_day:\n261\t            return \"UPTREND\"\n262\t        if current_price < fifty_day < two_hundred_day:\n263\t            return \"DOWNTREND\"\n264\t        return \"NEUTRAL\"\n265\t    return \"INSUFFICIENT_DATA\"\n266\t\n267\t\n268\tdef _field(value, source, retrieved_at, degraded_state=\"FIELD_NOT_PROVIDED\"):\n269\t    if value is None:\n270\t        return {\"value\": None, \"state\": degraded_state, \"source\": source,\n271\t                \"retrieved_at\": retrieved_at}\n272\t    return {\"value\": value, \"state\": \"OK\", \"source\": source, \"retrieved_at\": retrieved_at}\n273\t\n274\t\n275\tdef build_enrichment(ticker: str, cache_entry: \"dict | None\") -> dict:\n276\t    \"\"\"Returns (enrichment_dict, fetch_state, asset_class, quote_type).\"\"\"\n277\t    now = datetime.now(timezone.utc).isoformat()\n278\t    if cache_entry is None:\n279\t        retrieved_at = now\n280\t        fields = {name: {\"value\": None, \"state\": \"PROVIDER_UNAVAILABLE\",\n281\t                          \"source\": None, \"retrieved_at\": retrieved_at}\n282\t                  for name in ENRICHMENT_FIELD_NAMES}\n283\t        return fields, \"PROVIDER_UNAVAILABLE\", None, None\n284\t\n285\t    retrieved_at = cache_entry.get(\"retrieved_at\", now)\n286\t    if cache_entry.get(\"fetch_state\") != \"OK\":\n287\t        fields = {name: {\"value\": None, \"state\": \"PROVIDER_UNAVAILABLE\",\n288\t                          \"source\": \"yfinance\", \"retrieved_at\": retrieved_at}\n289\t                  for name in ENRICHMENT_FIELD_NAMES}\n290\t        return fields, \"PROVIDER_UNAVAILABLE\", cache_entry.get(\"asset_class_override\"), None\n291\t\n292\t    raw = cache_entry.get(\"raw\", {})\n293\t    asset_class = cache_entry.get(\"asset_class_override\") or raw.get(\"quoteType\")\n294\t    quote_type = raw.get(\"quoteType\")\n295\t    src = lambda f: f\"yfinance.info.{f}\"  # noqa: E731\n296\t\n297\t    company_name = raw.get(\"longName\") or raw.get(\"shortName\")\n298\t    market_cap = raw.get(\"marketCap\")\n299\t    current_price = raw.get(\"currentPrice\") or raw.get(\"regularMarketPrice\") \\\n300\t        or raw.get(\"previousClose\")\n301\t\n302\t    category, taxonomy_note = classify_taxonomy(\n303\t        asset_class, quote_type, raw.get(\"sector\"), raw.get(\"industry\"),\n304\t        raw.get(\"longBusinessSummary\"))\n305\t\n306\t    fields = {\n307\t        \"company_name\": _field(company_name, src(\"longName/shortName\"), retrieved_at),\n308\t        \"description\": _field(raw.get(\"longBusinessSummary\"), src(\"longBusinessSummary\"),\n309\t                              retrieved_at),\n310\t        \"ai_subindustry\": {\n311\t            \"value\": category,\n312\t            \"state\": \"OK\" if category is not None else \"FIELD_NOT_PROVIDED\",\n313\t            \"source\": \"derived:yfinance.sector+industry+summary keyword taxonomy v1\",\n314\t            \"retrieved_at\": retrieved_at,\n315\t            \"note\": taxonomy_note,\n316\t        },\n317\t        \"market_country\": _field(raw.get(\"country\"), src(\"country\"), retrieved_at),\n318\t        \"market_cap\": _field(market_cap, src(\"marketCap\"), retrieved_at),\n319\t        \"trailing_pe\": _field(raw.get(\"trailingPE\"), src(\"trailingPE\"), retrieved_at),\n320\t        \"forward_pe\": _field(raw.get(\"forwardPE\"), src(\"forwardPE\"), retrieved_at),\n321\t        \"price_to_book\": _field(raw.get(\"priceToBook\"), src(\"priceToBook\"), retrieved_at),\n322\t        \"revenue\": _field(raw.get(\"totalRevenue\"), src(\"totalRevenue\"), retrieved_at),\n323\t        \"revenue_growth\": _field(raw.get(\"revenueGrowth\"), src(\"revenueGrowth\"), retrieved_at),\n324\t        \"cash\": _field(raw.get(\"totalCash\"), src(\"totalCash\"), retrieved_at),\n325\t        \"debt\": _field(raw.get(\"totalDebt\"), src(\"totalDebt\"), retrieved_at),\n326\t        \"profitability\": _field(raw.get(\"profitMargins\"), src(\"profitMargins\"), retrieved_at),\n327\t        \"current_price\": _field(current_price, src(\"currentPrice/regularMarketPrice\"),\n328\t                                retrieved_at),\n329\t        \"average_volume\": _field(raw.get(\"averageVolume\"), src(\"averageVolume\"), retrieved_at),\n330\t    }\n331\t    ms = momentum_state(current_price, raw.get(\"fiftyDayAverage\"),\n332\t                        raw.get(\"twoHundredDayAverage\"), raw.get(\"fiftyTwoWeekHigh\"))\n333\t    fields[\"momentum_state\"] = {\n334\t        \"value\": ms,\n335\t        \"state\": \"OK\" if ms is not None else \"FIELD_NOT_PROVIDED\",\n336\t        \"source\": \"derived:yfinance.currentPrice vs fiftyDayAverage/twoHundredDayAverage/\"\n337\t                  \"fiftyTwoWeekHigh\",\n338\t        \"retrieved_at\": retrieved_at,\n339\t    }\n340\t    return fields, \"OK\", asset_class, quote_type\n341\t\n342\t\n343\t# ── risk ─────────────────────────────────────────────────────────────────────\n344\t\n345\tdef compute_risk(enrichment: dict, asset_class: \"str | None\", supporting_kol_count: int) -> dict:\n346\t    ok_count = sum(1 for f in enrichment.values() if f[\"state\"] == \"OK\")\n347\t    data_quality_fraction = round(ok_count / len(enrichment), 4)\n348\t    mc = enrichment[\"market_cap\"]\n349\t    bucket = size_bucket(mc[\"value\"]) if mc[\"state\"] == \"OK\" else \"UNKNOWN\"\n350\t    avg_vol_degraded = enrichment[\"average_volume\"][\"state\"] != \"OK\"\n351\t\n352\t    inputs = {\n353\t        \"size_bucket\": bucket,\n354\t        \"asset_class\": asset_class,\n355\t        \"data_quality_fraction\": data_quality_fraction,\n356\t        \"average_volume_degraded\": avg_vol_degraded,\n357\t        \"supporting_kol_count\": supporting_kol_count,\n358\t    }\n359\t\n360\t    if asset_class == \"CRYPTO\" or bucket in (\"MICRO\", \"UNKNOWN\") or data_quality_fraction < 0.4:\n361\t        tier = \"SPECULATIVE\"\n362\t        rule = \"asset_class==CRYPTO or size_bucket in {MICRO,UNKNOWN} or data_quality<0.4\"\n363\t    elif bucket == \"SMALL\" or supporting_kol_count == 1 or avg_vol_degraded:\n364\t        tier = \"HIGH\"\n365\t        rule = \"size_bucket==SMALL or supporting_kol_count==1 or average_volume degraded\"\n366\t    elif bucket == \"MID\":\n367\t        tier = \"MODERATE\"\n368\t        rule = \"size_bucket==MID\"\n369\t    elif bucket in (\"LARGE\", \"MEGA\") and data_quality_fraction >= 0.7 and supporting_kol_count >= 2:\n370\t        tier = \"LOW\"\n371\t        rule = \"size_bucket in {LARGE,MEGA} and data_quality>=0.7 and supporting_kol_count>=2\"\n372\t    else:\n373\t        tier = \"MODERATE\"\n374\t        rule = \"fallback: does not clear the LOW bar but no HIGH/SPECULATIVE trigger fired\"\n375\t\n376\t    return {\"tier\": tier, \"rule\": rule, \"inputs\": inputs}\n377\t\n378\t\n379\t# ── opportunity score ────────────────────────────────────────────────────────\n380\t\n381\tdef _kol_tier_score(handle: str, ranking_by_handle: dict) -> tuple:\n382\t    entry = ranking_by_handle.get(handle)\n383\t    if entry is None:\n384\t        return 0.05, \"no KOL ranking evidence for this account\"\n385\t    tier = entry.get(\"tier\", {}).get(\"tier\")\n386\t    confidence = entry.get(\"tier\", {}).get(\"confidence\", 0.0) or 0.0\n387\t    if tier == \"ELITE\":\n388\t        return 1.0, f\"{handle} tier=ELITE\"\n389\t    if tier == \"SOLID\":\n390\t        return 0.8, f\"{handle} tier=SOLID\"\n391\t    if tier == \"EARLY_EVIDENCE\":\n392\t        return round(0.5 * confidence, 4), f\"{handle} tier=EARLY_EVIDENCE confidence={confidence}\"\n393\t    if tier == \"UNRANKED\":\n394\t        return round(0.1 * confidence, 4), f\"{handle} tier=UNRANKED confidence={confidence}\"\n395\t    return 0.05, f\"{handle} tier={tier!r} unrecognized\"\n396\t\n397\t\n398\t_LIFECYCLE_RECENCY_SCORE = {\n399\t    \"NEW_CALL\": 1.0, \"ACTIVE_CALL\": 0.7, \"OLD_CALL\": 0.3, \"CLOSED\": 0.0, \"INVALIDATED\": 0.0,\n400\t}\n401\t_MOMENTUM_SCORE = {\n402\t    \"EXTENDED_NEAR_52W_HIGH\": 0.2, \"UPTREND\": 0.8, \"NEUTRAL\": 0.6, \"DOWNTREND\": 0.4,\n403\t}\n404\t\n405\t\n406\tdef compute_opportunity(independence: dict, lifecycle: dict, enrichment: dict,\n407\t                        ranking_by_handle: dict) -> dict:\n408\t    kol_independence_val = round(min(independence[\"supporting_kol_count\"] / 5.0, 1.0), 4)\n409\t\n410\t    track_candidates = [_kol_tier_score(a[\"account\"], ranking_by_handle)\n411\t                        for a in independence[\"accounts\"]]\n412\t    kol_track_record_val, kol_track_record_note = max(track_candidates, key=lambda t: t[0])\n413\t\n414\t    conviction_val = _LIFECYCLE_RECENCY_SCORE.get(lifecycle[\"state\"], 0.0)\n415\t\n416\t    ms = enrichment[\"momentum_state\"][\"value\"]\n417\t    momentum_val = _MOMENTUM_SCORE.get(ms, 0.5)\n418\t    momentum_note = f\"momentum_state={ms!r}\" if ms is not None \\\n419\t        else \"momentum_state unavailable — neutral fallback, flagged degraded\"\n420\t\n421\t    ok_count = sum(1 for f in enrichment.values() if f[\"state\"] == \"OK\")\n422\t    data_quality_val = round(ok_count / len(enrichment), 4)\n423\t\n424\t    components = [\n425\t        {\"name\": \"kol_independence\", \"value\": kol_independence_val,\n426\t         \"weight\": OPPORTUNITY_WEIGHTS[\"kol_independence\"],\n427\t         \"contribution\": round(kol_independence_val * OPPORTUNITY_WEIGHTS[\"kol_independence\"], 4),\n428\t         \"note\": f\"{independence['supporting_kol_count']} distinct supporting account(s)\"},\n429\t        {\"name\": \"kol_track_record\", \"value\": kol_track_record_val,\n430\t         \"weight\": OPPORTUNITY_WEIGHTS[\"kol_track_record\"],\n431\t         \"contribution\": round(kol_track_record_val * OPPORTUNITY_WEIGHTS[\"kol_track_record\"], 4),\n432\t         \"note\": kol_track_record_note},\n433\t        {\"name\": \"conviction_recency\", \"value\": conviction_val,\n434\t         \"weight\": OPPORTUNITY_WEIGHTS[\"conviction_recency\"],\n435\t         \"contribution\": round(conviction_val * OPPORTUNITY_WEIGHTS[\"conviction_recency\"], 4),\n436\t         \"note\": f\"lifecycle={lifecycle['state']!r}\"},\n437\t        {\"name\": \"momentum_not_overextended\", \"value\": momentum_val,\n438\t         \"weight\": OPPORTUNITY_WEIGHTS[\"momentum_not_overextended\"],\n439\t         \"contribution\": round(momentum_val * OPPORTUNITY_WEIGHTS[\"momentum_not_overextended\"], 4),\n440\t         \"note\": momentum_note},\n441\t        {\"name\": \"data_quality\", \"value\": data_quality_val,\n442\t         \"weight\": OPPORTUNITY_WEIGHTS[\"data_quality\"],\n443\t         \"contribution\": round(data_quality_val * OPPORTUNITY_WEIGHTS[\"data_quality\"], 4),\n444\t         \"note\": f\"{ok_count}/{len(enrichment)} enrichment fields OK\"},\n445\t    ]\n446\t    total = round(sum(c[\"contribution\"] for c in components), 4)\n447\t\n448\t    reasons_for, reasons_against = [], []\n449\t    for c in components:\n450\t        if c[\"value\"] >= 0.6:\n451\t            reasons_for.append(f\"{c['name']}: {c['note']} (score {c['value']})\")\n452\t        elif c[\"value\"] <= 0.35:\n453\t            reasons_against.append(f\"{c['name']}: {c['note']} (score {c['value']})\")\n454\t\n455\t    # A one-sided rationale is a recommendation, not research: when no component\n456\t    # clears either threshold (all mid-range), the strongest and weakest components\n457\t    # still stand in for FOR/AGAINST rather than leaving a side empty.\n458\t    if not reasons_for:\n459\t        best = max(components, key=lambda c: c[\"value\"])\n460\t        reasons_for.append(\n461\t            f\"{best['name']}: {best['note']} (score {best['value']}) — \"\n462\t            \"highest-scoring factor, no component cleared the >=0.6 bar\")\n463\t    if not reasons_against:\n464\t        worst = min(components, key=lambda c: c[\"value\"])\n465\t        reasons_against.append(\n466\t            f\"{worst['name']}: {worst['note']} (score {worst['value']}) — \"\n467\t            \"lowest-scoring factor, no component fell below the <=0.35 bar\")\n468\t\n469\t    return {\"total\": total, \"components\": components,\n470\t            \"reasons_for\": reasons_for, \"reasons_against\": reasons_against}\n471\t\n472\t\n473\t# ── verifier-contract view ───────────────────────────────────────────────────\n474\t# factory_v2.product_verifiers.verify_tr_ticker (control repo) recomputes acceptance\n475\t# from a flat, closed-vocabulary shape (top-level \"tickers\", per-row scalar lifecycle/\n476\t# risk_tier, a typed \"fundamentals\" section keyed market_cap/size_bucket/country/\n477\t# momentum_state/liquidity_warning with value/source/as_of/status). That shape is a\n478\t# projection of the same data already computed in `row`, not a second source of truth.\n479\t\n480\tdef _provenance_field(field: dict) -> dict:\n481\t    return {\"value\": field[\"value\"], \"source\": field[\"source\"],\n482\t            \"as_of\": field[\"retrieved_at\"], \"status\": field[\"state\"]}\n483\t\n484\t\n485\tdef build_fundamentals(row: dict) -> dict:\n486\t    enrichment = row[\"enrichment\"]\n487\t    mc = enrichment[\"market_cap\"]\n488\t    bucket = row[\"risk\"][\"inputs\"][\"size_bucket\"]\n489\t    return {\n490\t        \"market_cap\": _provenance_field(mc),\n491\t        \"size_bucket\": {\n492\t            \"value\": bucket,\n493\t            \"source\": \"derived:risk cascade size_bucket thresholds vs market_cap\",\n494\t            \"as_of\": mc[\"retrieved_at\"],\n495\t            \"status\": \"OK\" if bucket not in (None, \"UNKNOWN\") else \"FIELD_NOT_PROVIDED\",\n496\t        },\n497\t        \"country\": _provenance_field(enrichment[\"market_country\"]),\n498\t        \"momentum_state\": _provenance_field(enrichment[\"momentum_state\"]),\n499\t        \"liquidity_warning\": {\n500\t            \"value\": row[\"warnings\"][\"liquidity\"],\n501\t            \"source\": \"derived:average_volume provider state\",\n502\t            \"as_of\": enrichment[\"average_volume\"][\"retrieved_at\"],\n503\t            \"status\": \"OK\",\n504\t        },\n505\t    }\n506\t\n507\t\n508\tdef build_ticker_view(row: dict) -> dict:\n509\t    return {\n510\t        \"ticker\": row[\"ticker\"],\n511\t        \"supporting_kol_count\": row[\"independence\"][\"supporting_kol_count\"],\n512\t        \"lifecycle\": row[\"lifecycle\"][\"state\"],\n513\t        \"lifecycle_rule\": row[\"lifecycle\"][\"rule\"],\n514\t        \"lifecycle_source_episode_ids\": row[\"lifecycle\"][\"decided_by_opening_tweet_ids\"],\n515\t        \"risk_tier\": row[\"risk\"][\"tier\"],\n516\t        \"opportunity_score\": row[\"opportunity_score\"],\n517\t        \"fundamentals\": build_fundamentals(row),\n518\t    }\n519\t\n520\t\n521\t# ── row assembly ─────────────────────────────────────────────────────────────\n522\t\n523\tdef build_row(ticker: str, ticker_episodes: list, as_of: date, ranking_by_handle: dict,\n524\t             cache_entry: \"dict | None\") -> tuple:\n525\t    lifecycle = compute_lifecycle(ticker_episodes, as_of)\n526\t    independence = compute_independence(ticker_episodes)\n527\t    enrichment, fetch_state, asset_class, quote_type = build_enrichment(ticker, cache_entry)\n528\t    risk = compute_risk(enrichment, asset_class, independence[\"supporting_kol_count\"])\n529\t    opportunity = compute_opportunity(independence, lifecycle, enrichment, ranking_by_handle)\n530\t\n531\t    first_ep = min(ticker_episodes,\n532\t                   key=lambda e: (e[\"tweet_date\"], int(e[\"opening_tweet_id\"])))\n533\t    pushes_by_account = defaultdict(int)\n534\t    for ep in ticker_episodes:\n535\t        pushes_by_account[ep[\"account\"]] += ep.get(\"pushes\", 0)\n536\t\n537\t    liquidity_warnings = []\n538\t    if enrichment[\"average_volume\"][\"state\"] != \"OK\":\n539\t        liquidity_warnings.append(\"average trading volume unavailable from provider\")\n540\t    dq_fields = [f for f, v in enrichment.items() if v[\"state\"] != \"OK\"]\n541\t    data_quality_warnings = [f\"{f}: {enrichment[f]['state']}\" for f in dq_fields]\n542\t\n543\t    row = {\n544\t        \"ticker\": ticker,\n545\t        \"asset_class\": asset_class,\n546\t        \"lifecycle\": lifecycle,\n547\t        \"episodes\": {\n548\t            \"count\": len(ticker_episodes),\n549\t            \"episode_ids\": sorted(episode_id(e) for e in ticker_episodes),\n550\t        },\n551\t        \"first_call\": {\n552\t            \"account\": first_ep[\"account\"],\n553\t            \"tweet_date\": first_ep[\"tweet_date\"],\n554\t            \"opening_tweet_id\": first_ep[\"opening_tweet_id\"],\n555\t            \"thesis\": first_ep[\"thesis\"],\n556\t            \"episode_id\": episode_id(first_ep),\n557\t        },\n558\t        \"independence\": independence,\n559\t        \"conviction_evolution\": {\n560\t            \"total_pushes\": sum(pushes_by_account.values()),\n561\t            \"pushes_by_account\": dict(sorted(pushes_by_account.items())),\n562\t        },\n563\t        \"enrichment\": enrichment,\n564\t        \"enrichment_fetch_state\": fetch_state,\n565\t        \"value_chain_role\": VALUE_CHAIN_ROLE.get(enrichment[\"ai_subindustry\"][\"value\"]),\n566\t        \"risk\": risk,\n567\t        \"opportunity_score\": opportunity,\n568\t        \"warnings\": {\n569\t            \"liquidity\": liquidity_warnings,\n570\t            \"data_quality\": data_quality_warnings,\n571\t        },\n572\t    }\n573\t    provenance_entry = {\n574\t        \"asset_class\": asset_class,\n575\t        \"fetch_state\": fetch_state,\n576\t        \"fields\": {name: {k: v for k, v in field.items() if k != \"value\"}\n577\t                  for name, field in enrichment.items()},\n578\t    }\n579\t    return row, provenance_entry\n580\t\n581\t\n582\t# ── top level ────────────────────────────────────────────────────────────────\n583\t\n584\tdef build(ledger: dict, ranking: \"dict | None\", cache: \"dict | None\") -> tuple:\n585\t    episodes = ledger[\"episodes\"]\n586\t    grouped = group_by_ticker(episodes)\n587\t    as_of = _parse_date(max(ep[\"tweet_date\"] for ep in episodes))\n588\t\n589\t    ranking_by_handle = {}\n590\t    if ranking is not None:\n591\t        for acc in ranking.get(\"accounts\", []):\n592\t            ranking_by_handle[acc[\"handle\"]] = acc\n593\t\n594\t    cache_tickers = (cache or {}).get(\"tickers\", {})\n595\t\n596\t    rows, provenance = [], {}\n597\t    for ticker in sorted(grouped):\n598\t        row, prov_entry = build_row(ticker, grouped[ticker], as_of, ranking_by_handle,\n599\t                                    cache_tickers.get(ticker))\n600\t        rows.append(row)\n601\t        provenance[ticker] = prov_entry\n602\t\n603\t    generated_at = datetime.now(timezone.utc).isoformat()\n604\t    table = {\n605\t        \"schema\": SCHEMA_TABLE,\n606\t        \"generated_at\": generated_at,\n607\t        \"source_ledger\": {\n608\t            \"path\": \"research/tr_call_ledger.json\",\n609\t            \"episode_count_total\": len(episodes),\n610\t            \"distinct_tickers\": len(grouped),\n611\t        },\n612\t        \"as_of_date\": as_of.isoformat(),\n613\t        \"lifecycle_rule\": {\n614\t            \"new_call_window_days\": NEW_CALL_WINDOW_DAYS,\n615\t            \"active_call_window_days\": ACTIVE_CALL_WINDOW_DAYS,\n616\t            \"active_call_window_rationale\": (\n617\t                \"120 trading sessions (SPEC.md's longest frozen evaluation horizon) \"\n618\t                \"* 365/252 calendar-to-trading-day ratio ~= 174 calendar days\"),\n619\t        },\n620\t        \"opportunity_weights\": OPPORTUNITY_WEIGHTS,\n621\t        \"row_count\": len(rows),\n622\t        \"rows\": rows,\n623\t        \"tickers\": [build_ticker_view(row) for row in rows],\n624\t    }\n625\t    provenance_doc = {\n626\t        \"schema\": SCHEMA_PROVENANCE,\n627\t        \"generated_at\": generated_at,\n628\t        \"provider\": (cache or {}).get(\"provider\", \"yfinance\"),\n629\t        \"provider_version\": (cache or {}).get(\"provider_version\"),\n630\t        \"query_overrides\": (cache or {}).get(\"query_overrides\", {}),\n631\t        \"override_rationale\": (cache or {}).get(\"override_rationale\"),\n632\t        \"ticker_count\": len(provenance),\n633\t        \"tickers\": provenance,\n634\t    }\n635\t    return table, provenance_doc\n636\t\n637\t\n638\tdef main(argv=None) -> int:\n639\t    ap = argparse.ArgumentParser(description=__doc__)\n640\t    ap.add_argument(\"--ledger\", default=\"research/tr_call_ledger.json\")\n641\t    ap.add_argument(\"--ranking\", default=\"research/tr_kol_ranking.json\")\n642\t    ap.add_argument(\"--cache\", default=\"research/tr_ticker_yfinance_cache.json\")\n643\t    ap.add_argument(\"--out-table\", default=\"research/tr_ticker_table.json\")\n644\t    ap.add_argument(\"--out-provenance\", default=\"research/tr_ticker_enrichment_provenance.json\")\n645\t    args = ap.parse_args(argv)\n646\t\n647\t    ledger = load_json(args.ledger)\n648\t    if ledger is None:\n649\t        raise SystemExit(f\"required ledger not found: {args.ledger}\")\n650\t    ranking = load_json(args.ranking)\n651\t    cache = load_json(args.cache)\n652\t\n653\t    table, provenance = build(ledger, ranking, cache)\n654\t\n655\t    Path(args.out_table).write_text(json.dumps(table, indent=2, sort_keys=True) + \"\\n\",\n656\t                                    encoding=\"utf-8\")\n657\t    Path(args.out_provenance).write_text(\n658\t        json.dumps(provenance, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n659\t    print(f\"wrote {table['row_count']} ticker rows -> {args.out_table}\")\n660\t    print(f\"wrote provenance for {provenance['ticker_count']} tickers -> {args.out_provenance}\")\n661\t    return 0\n662\t\n663\t\n664\tif __name__ == \"__main__\":\n665\t    raise SystemExit(main())\n666\t"}]},"parent_tool_use_id":null,"session_id":"80a42da3-70a5-4179-95d8-64a5724a163e","uuid":"22678758-2e24-40fc-b7e4-e908596d4115","timestamp":"2026-09-23T16:58:37.270Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-nwaodvq5/scripts/build_tr_ticker_table.py","content":"#!/usr/bin/env python3\n\"\"\"build_tr_ticker_table.py — TR_TICKER_INTELLIGENCE_V1.\n\nBuilds research/tr_ticker_table.json and research/tr_ticker_enrichment_provenance.json\nfrom research/tr_call_ledger.json — the ONLY admissible source of the ticker universe\n(SPEC.md, \"Universe provenance — KOL-first, never screener-first\"). Never seeds from an\nexchange list, index, screener or generic market feed. Read-only against the ledger: never\ntouches entry_date/entry_price/horizons/closure (frozen, no re-selection after observing\nthe future).\n\nSee PLAN.md for the full rule derivation (lifecycle priority, independence weighting,\ntaxonomy, risk cascade, opportunity-score weights) with the factual discovery behind each\nchoice.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nfrom collections import defaultdict\nfrom datetime import date, datetime, timezone\nfrom pathlib import Path\n\nSCHEMA_TABLE = \"tr-ticker-table/v1\"\nSCHEMA_PROVENANCE = \"tr-ticker-enrichment-provenance/v1\"\n\nOPEN_CLOSURE_STATES = {\"OPEN_AT_WINDOW_END\", \"NOT_EVALUABLE\", \"SAME_DAY_UNORDERED\"}\nNEW_CALL_WINDOW_DAYS = 7\n# 120 trading sessions (the longest frozen evaluation horizon in SPEC.md) * 365/252\n# calendar-to-trading-day ratio ~= 174 calendar days. Not an arbitrary business\n# threshold: tied to the already-frozen horizon set, so it can't silently drift.\nACTIVE_CALL_WINDOW_DAYS = 174\n\nFOLLOWER_WEIGHT = 0.5\nORIGINATOR_WEIGHT = 1.0\n\nSIZE_BUCKET_THRESHOLDS = (\n    (\"MEGA\", 200_000_000_000),\n    (\"LARGE\", 10_000_000_000),\n    (\"MID\", 2_000_000_000),\n    (\"SMALL\", 300_000_000),\n)\n\nTAXONOMY_RULES = [\n    (\"semiconductors_compute\",\n     [\"semiconductor\", \"chip\", \"foundry\", \"wafer\", \" gpu\", \" cpu\", \"asic\", \"fpga\",\n      \"integrated circuit\"]),\n    (\"cloud_datacenter_network\",\n     [\"data center\", \"datacenter\", \"cloud computing\", \"networking\", \"hyperscale\",\n      \"colocation\", \"internet service\"]),\n    (\"energy_cooling_infra\",\n     [\"cooling\", \"power generation\", \"electric utility\", \"nuclear\", \"battery storage\",\n      \"electrical grid\", \"liquid cooling\", \"hvac\", \"renewable\"]),\n    (\"enterprise_software\",\n     [\"enterprise software\", \"saas\", \"erp\", \" crm\", \"cybersecurity\", \"application software\",\n      \"infrastructure software\"]),\n    (\"consumer_software\",\n     [\"social media\", \"e-commerce\", \"internet content\", \"mobile application\",\n      \"consumer electronics\"]),\n    (\"robotics_automation\",\n     [\"robot\", \"automation\", \"industrial machinery\", \"drone\", \"unmanned\"]),\n    (\"defense_autonomy\",\n     [\"aerospace & defense\", \"aerospace and defense\", \"defense\", \"military\", \"satellite\",\n      \"space\", \"missile\"]),\n    (\"healthcare_biotech_ai\",\n     [\"biotechnology\", \"health care\", \"healthcare\", \"pharmaceutical\", \"medical device\",\n      \"diagnostics\"]),\n    (\"adjacent_supplier\",\n     [\"specialty chemicals\", \"mining\", \"metals\", \"materials\", \"industrial distribution\"]),\n]\n\nVALUE_CHAIN_ROLE = {\n    \"semiconductors_compute\": \"upstream_compute_hardware\",\n    \"cloud_datacenter_network\": \"midstream_infrastructure\",\n    \"energy_cooling_infra\": \"midstream_infrastructure_power\",\n    \"enterprise_software\": \"downstream_application_layer\",\n    \"consumer_software\": \"downstream_application_layer\",\n    \"robotics_automation\": \"downstream_application_layer_physical\",\n    \"defense_autonomy\": \"downstream_application_layer_defense\",\n    \"healthcare_biotech_ai\": \"downstream_application_layer_healthcare\",\n    \"adjacent_supplier\": \"upstream_adjacent_materials\",\n    \"crypto_digital_asset\": \"not_applicable_non_equity_asset\",\n    \"broad_market_etf_index\": \"not_applicable_broad_market_vehicle\",\n    \"UNCLASSIFIED\": \"UNCLASSIFIED\",\n}\n\nOPPORTUNITY_WEIGHTS = {\n    \"kol_independence\": 0.30,\n    \"kol_track_record\": 0.25,\n    \"conviction_recency\": 0.20,\n    \"momentum_not_overextended\": 0.15,\n    \"data_quality\": 0.10,\n}\nassert abs(sum(OPPORTUNITY_WEIGHTS.values()) - 1.0) < 1e-9\n\nENRICHMENT_FIELD_NAMES = (\n    \"company_name\", \"description\", \"ai_subindustry\", \"market_country\", \"market_cap\",\n    \"trailing_pe\", \"forward_pe\", \"price_to_book\", \"revenue\", \"revenue_growth\", \"cash\",\n    \"debt\", \"profitability\", \"current_price\", \"momentum_state\", \"average_volume\",\n)\n\n\n# ── helpers ──────────────────────────────────────────────────────────────────\n\ndef episode_id(ep: dict) -> str:\n    return f\"{ep['account']}::{ep['ticker']}::{ep['thesis']}::{ep['opening_tweet_id']}\"\n\n\ndef _parse_date(s: str) -> date:\n    return datetime.strptime(s, \"%Y-%m-%d\").date()\n\n\ndef load_json(path: \"Path | None\"):\n    if path is None:\n        return None\n    p = Path(path)\n    if not p.is_file():\n        return None\n    return json.loads(p.read_text(encoding=\"utf-8\"))\n\n\ndef group_by_ticker(episodes: list) -> dict:\n    grouped = defaultdict(list)\n    for ep in episodes:\n        grouped[ep[\"ticker\"]].append(ep)\n    return grouped\n\n\n# ── lifecycle ────────────────────────────────────────────────────────────────\n\ndef compute_lifecycle(ticker_episodes: list, as_of: date) -> dict:\n    latest_date_str = max(ep[\"tweet_date\"] for ep in ticker_episodes)\n    latest_group = [ep for ep in ticker_episodes if ep[\"tweet_date\"] == latest_date_str]\n\n    invalidated = [ep for ep in latest_group\n                   if ep.get(\"closure\", {}).get(\"state\") == \"INVALIDATED\"]\n    still_open = [ep for ep in latest_group\n                  if ep.get(\"closure\", {}).get(\"state\") in OPEN_CLOSURE_STATES]\n    closed = [ep for ep in latest_group\n              if ep.get(\"closure\", {}).get(\"state\") == \"CLOSED_SOLD\"]\n\n    latest_date = _parse_date(latest_date_str)\n    age_days = (as_of - latest_date).days\n\n    if invalidated:\n        state = \"INVALIDATED\"\n        decided_by = invalidated\n        rule = (\"latest-episode-priority: an episode at the ticker's most recent \"\n                \"tweet_date has closure.state==INVALIDATED — invalidation is never \"\n                \"masked by a concurrently open call from another account\")\n    elif still_open:\n        decided_by = still_open\n        if age_days <= NEW_CALL_WINDOW_DAYS:\n            state = \"NEW_CALL\"\n            rule = (f\"latest open episode age_days={age_days} <= \"\n                    f\"{NEW_CALL_WINDOW_DAYS} (fast-loop weekly detection window)\")\n        elif age_days <= ACTIVE_CALL_WINDOW_DAYS:\n            state = \"ACTIVE_CALL\"\n            rule = (f\"latest open episode age_days={age_days} <= \"\n                    f\"{ACTIVE_CALL_WINDOW_DAYS} (120-trading-session frozen \"\n                    \"evaluation horizon expressed in calendar days)\")\n        else:\n            state = \"OLD_CALL\"\n            rule = (f\"latest open episode age_days={age_days} > \"\n                    f\"{ACTIVE_CALL_WINDOW_DAYS}, still no explicit closure/invalidation\")\n    else:\n        # every episode at the latest date is CLOSED_SOLD\n        state = \"CLOSED\"\n        decided_by = closed\n        rule = (\"latest-episode-priority: every episode at the ticker's most recent \"\n                \"tweet_date has closure.state==CLOSED_SOLD, none open, none invalidated\")\n\n    return {\n        \"state\": state,\n        \"rule\": rule,\n        \"as_of_date\": as_of.isoformat(),\n        \"latest_tweet_date\": latest_date_str,\n        \"age_days_vs_as_of\": age_days,\n        \"decided_by_episode_ids\": sorted(episode_id(ep) for ep in decided_by),\n        \"decided_by_opening_tweet_ids\": sorted({ep[\"opening_tweet_id\"] for ep in decided_by}),\n    }\n\n\n# ── independence ─────────────────────────────────────────────────────────────\n\ndef compute_independence(ticker_episodes: list) -> dict:\n    by_account = defaultdict(list)\n    for ep in ticker_episodes:\n        by_account[ep[\"account\"]].append(ep)\n\n    def first_ep(eps):\n        return min(eps, key=lambda e: (e[\"tweet_date\"], int(e[\"opening_tweet_id\"])))\n\n    originator_account = min(\n        by_account, key=lambda acc: (first_ep(by_account[acc])[\"tweet_date\"],\n                                      int(first_ep(by_account[acc])[\"opening_tweet_id\"])))\n\n    accounts = []\n    for acc, eps in sorted(by_account.items()):\n        fe = first_ep(eps)\n        role = \"ORIGINATOR\" if acc == originator_account else \"FOLLOWER\"\n        weight = ORIGINATOR_WEIGHT if role == \"ORIGINATOR\" else FOLLOWER_WEIGHT\n        accounts.append({\n            \"account\": acc,\n            \"role\": role,\n            \"weight\": weight,\n            \"first_tweet_date\": fe[\"tweet_date\"],\n            \"episode_id\": episode_id(fe),\n            \"episode_count\": len(eps),\n            \"total_pushes\": sum(e.get(\"pushes\", 0) for e in eps),\n        })\n\n    return {\n        \"supporting_kol_count\": len(by_account),\n        \"originator_account\": originator_account,\n        \"accounts\": accounts,\n        \"rule\": (\"distinct accounts with >=1 qualified LONG episode on this ticker; \"\n                 \"10 pushes from one account is one account, never 10. Originator = \"\n                 \"account with the earliest tweet_date (tie-break: lowest \"\n                 \"opening_tweet_id) across all its episodes on this ticker; every \"\n                 f\"other contributing account is FOLLOWER (weight {FOLLOWER_WEIGHT} \"\n                 f\"vs ORIGINATOR weight {ORIGINATOR_WEIGHT} — independent conviction \"\n                 \"recorded, but never silently equal to origination)\"),\n    }\n\n\n# ── enrichment / taxonomy ────────────────────────────────────────────────────\n\ndef classify_taxonomy(asset_class: str, quote_type: \"str | None\", sector: \"str | None\",\n                      industry: \"str | None\", summary: \"str | None\") -> tuple:\n    if asset_class == \"CRYPTO\":\n        return \"crypto_digital_asset\", \"asset_class_override=CRYPTO\"\n    if quote_type in (\"ETF\", \"INDEX\", \"MUTUALFUND\"):\n        return \"broad_market_etf_index\", f\"quoteType={quote_type}\"\n    haystack = \" \".join(x for x in (sector, industry, summary) if x).lower()\n    if not haystack:\n        return None, \"sector/industry/summary all unavailable — cannot classify\"\n    for category, keywords in TAXONOMY_RULES:\n        for kw in keywords:\n            if kw in haystack:\n                return category, f\"matched keyword {kw!r} in sector/industry/summary\"\n    return \"UNCLASSIFIED\", \"no taxonomy keyword matched sector/industry/summary\"\n\n\ndef size_bucket(market_cap: \"float | None\") -> \"str | None\":\n    if market_cap is None:\n        return None\n    for label, floor in SIZE_BUCKET_THRESHOLDS:\n        if market_cap >= floor:\n            return label\n    return \"MICRO\"\n\n\ndef momentum_state(current_price, fifty_day, two_hundred_day, fifty_two_wk_high) -> \"str | None\":\n    if current_price is None:\n        return None\n    if fifty_two_wk_high and current_price >= 0.95 * fifty_two_wk_high \\\n            and fifty_day and two_hundred_day and current_price > fifty_day > two_hundred_day:\n        return \"EXTENDED_NEAR_52W_HIGH\"\n    if fifty_day is not None and two_hundred_day is not None:\n        if current_price > fifty_day > two_hundred_day:\n            return \"UPTREND\"\n        if current_price < fifty_day < two_hundred_day:\n            return \"DOWNTREND\"\n        return \"NEUTRAL\"\n    return \"INSUFFICIENT_DATA\"\n\n\ndef _field(value, source, retrieved_at, degraded_state=\"FIELD_NOT_PROVIDED\"):\n    if value is None:\n        return {\"value\": None, \"state\": degraded_state, \"source\": source,\n                \"retrieved_at\": retrieved_at}\n    return {\"value\": value, \"state\": \"OK\", \"source\": source, \"retrieved_at\": retrieved_at}\n\n\ndef build_enrichment(ticker: str, cache_entry: \"dict | None\") -> dict:\n    \"\"\"Returns (enrichment_dict, fetch_state, asset_class, quote_type).\"\"\"\n    now = datetime.now(timezone.utc).isoformat()\n    if cache_entry is None:\n        retrieved_at = now\n        fields = {name: {\"value\": None, \"state\": \"PROVIDER_UNAVAILABLE\",\n                          \"source\": None, \"retrieved_at\": retrieved_at}\n                  for name in ENRICHMENT_FIELD_NAMES}\n        return fields, \"PROVIDER_UNAVAILABLE\", None, None\n\n    retrieved_at = cache_entry.get(\"retrieved_at\", now)\n    if cache_entry.get(\"fetch_state\") != \"OK\":\n        fields = {name: {\"value\": None, \"state\": \"PROVIDER_UNAVAILABLE\",\n                          \"source\": \"yfinance\", \"retrieved_at\": retrieved_at}\n                  for name in ENRICHMENT_FIELD_NAMES}\n        return fields, \"PROVIDER_UNAVAILABLE\", cache_entry.get(\"asset_class_override\"), None\n\n    raw = cache_entry.get(\"raw\", {})\n    asset_class = cache_entry.get(\"asset_class_override\") or raw.get(\"quoteType\")\n    quote_type = raw.get(\"quoteType\")\n    src = lambda f: f\"yfinance.info.{f}\"  # noqa: E731\n\n    company_name = raw.get(\"longName\") or raw.get(\"shortName\")\n    market_cap = raw.get(\"marketCap\")\n    current_price = raw.get(\"currentPrice\") or raw.get(\"regularMarketPrice\") \\\n        or raw.get(\"previousClose\")\n\n    category, taxonomy_note = classify_taxonomy(\n        asset_class, quote_type, raw.get(\"sector\"), raw.get(\"industry\"),\n        raw.get(\"longBusinessSummary\"))\n\n    fields = {\n        \"company_name\": _field(company_name, src(\"longName/shortName\"), retrieved_at),\n        \"description\": _field(raw.get(\"longBusinessSummary\"), src(\"longBusinessSummary\"),\n                              retrieved_at),\n        \"ai_subindustry\": {\n            \"value\": category,\n            \"state\": \"OK\" if category is not None else \"FIELD_NOT_PROVIDED\",\n            \"source\": \"derived:yfinance.sector+industry+summary keyword taxonomy v1\",\n            \"retrieved_at\": retrieved_at,\n            \"note\": taxonomy_note,\n        },\n        \"market_country\": _field(raw.get(\"country\"), src(\"country\"), retrieved_at),\n        \"market_cap\": _field(market_cap, src(\"marketCap\"), retrieved_at),\n        \"trailing_pe\": _field(raw.get(\"trailingPE\"), src(\"trailingPE\"), retrieved_at),\n        \"forward_pe\": _field(raw.get(\"forwardPE\"), src(\"forwardPE\"), retrieved_at),\n        \"price_to_book\": _field(raw.get(\"priceToBook\"), src(\"priceToBook\"), retrieved_at),\n        \"revenue\": _field(raw.get(\"totalRevenue\"), src(\"totalRevenue\"), retrieved_at),\n        \"revenue_growth\": _field(raw.get(\"revenueGrowth\"), src(\"revenueGrowth\"), retrieved_at),\n        \"cash\": _field(raw.get(\"totalCash\"), src(\"totalCash\"), retrieved_at),\n        \"debt\": _field(raw.get(\"totalDebt\"), src(\"totalDebt\"), retrieved_at),\n        \"profitability\": _field(raw.get(\"profitMargins\"), src(\"profitMargins\"), retrieved_at),\n        \"current_price\": _field(current_price, src(\"currentPrice/regularMarketPrice\"),\n                                retrieved_at),\n        \"average_volume\": _field(raw.get(\"averageVolume\"), src(\"averageVolume\"), retrieved_at),\n    }\n    ms = momentum_state(current_price, raw.get(\"fiftyDayAverage\"),\n                        raw.get(\"twoHundredDayAverage\"), raw.get(\"fiftyTwoWeekHigh\"))\n    fields[\"momentum_state\"] = {\n        \"value\": ms,\n        \"state\": \"OK\" if ms is not None else \"FIELD_NOT_PROVIDED\",\n        \"source\": \"derived:yfinance.currentPrice vs fiftyDayAverage/twoHundredDayAverage/\"\n                  \"fiftyTwoWeekHigh\",\n        \"retrieved_at\": retrieved_at,\n    }\n    return fields, \"OK\", asset_class, quote_type\n\n\n# ── risk ─────────────────────────────────────────────────────────────────────\n\ndef compute_risk(enrichment: dict, asset_class: \"str | None\", supporting_kol_count: int) -> dict:\n    ok_count = sum(1 for f in enrichment.values() if f[\"state\"] == \"OK\")\n    data_quality_fraction = round(ok_count / len(enrichment), 4)\n    mc = enrichment[\"market_cap\"]\n    bucket = size_bucket(mc[\"value\"]) if mc[\"state\"] == \"OK\" else \"UNKNOWN\"\n    avg_vol_degraded = enrichment[\"average_volume\"][\"state\"] != \"OK\"\n\n    inputs = {\n        \"size_bucket\": bucket,\n        \"asset_class\": asset_class,\n        \"data_quality_fraction\": data_quality_fraction,\n        \"average_volume_degraded\": avg_vol_degraded,\n        \"supporting_kol_count\": supporting_kol_count,\n    }\n\n    if asset_class == \"CRYPTO\" or bucket in (\"MICRO\", \"UNKNOWN\") or data_quality_fraction < 0.4:\n        tier = \"SPECULATIVE\"\n        rule = \"asset_class==CRYPTO or size_bucket in {MICRO,UNKNOWN} or data_quality<0.4\"\n    elif bucket == \"SMALL\" or supporting_kol_count == 1 or avg_vol_degraded:\n        tier = \"HIGH\"\n        rule = \"size_bucket==SMALL or supporting_kol_count==1 or average_volume degraded\"\n    elif bucket == \"MID\":\n        tier = \"MODERATE\"\n        rule = \"size_bucket==MID\"\n    elif bucket in (\"LARGE\", \"MEGA\") and data_quality_fraction >= 0.7 and supporting_kol_count >= 2:\n        tier = \"LOW\"\n        rule = \"size_bucket in {LARGE,MEGA} and data_quality>=0.7 and supporting_kol_count>=2\"\n    else:\n        tier = \"MODERATE\"\n        rule = \"fallback: does not clear the LOW bar but no HIGH/SPECULATIVE trigger fired\"\n\n    return {\"tier\": tier, \"rule\": rule, \"inputs\": inputs}\n\n\n# ── opportunity score ────────────────────────────────────────────────────────\n\ndef _kol_tier_score(handle: str, ranking_by_handle: dict) -> tuple:\n    entry = ranking_by_handle.get(handle)\n    if entry is None:\n        return 0.05, \"no KOL ranking evidence for this account\"\n    tier = entry.get(\"tier\", {}).get(\"tier\")\n    confidence = entry.get(\"tier\", {}).get(\"confidence\", 0.0) or 0.0\n    if tier == \"ELITE\":\n        return 1.0, f\"{handle} tier=ELITE\"\n    if tier == \"SOLID\":\n        return 0.8, f\"{handle} tier=SOLID\"\n    if tier == \"EARLY_EVIDENCE\":\n        return round(0.5 * confidence, 4), f\"{handle} tier=EARLY_EVIDENCE confidence={confidence}\"\n    if tier == \"UNRANKED\":\n        return round(0.1 * confidence, 4), f\"{handle} tier=UNRANKED confidence={confidence}\"\n    return 0.05, f\"{handle} tier={tier!r} unrecognized\"\n\n\n_LIFECYCLE_RECENCY_SCORE = {\n    \"NEW_CALL\": 1.0, \"ACTIVE_CALL\": 0.7, \"OLD_CALL\": 0.3, \"CLOSED\": 0.0, \"INVALIDATED\": 0.0,\n}\n_MOMENTUM_SCORE = {\n    \"EXTENDED_NEAR_52W_HIGH\": 0.2, \"UPTREND\": 0.8, \"NEUTRAL\": 0.6, \"DOWNTREND\": 0.4,\n}\n\n\ndef compute_opportunity(independence: dict, lifecycle: dict, enrichment: dict,\n                        ranking_by_handle: dict) -> dict:\n    kol_independence_val = round(min(independence[\"supporting_kol_count\"] / 5.0, 1.0), 4)\n\n    track_candidates = [_kol_tier_score(a[\"account\"], ranking_by_handle)\n                        for a in independence[\"accounts\"]]\n    kol_track_record_val, kol_track_record_note = max(track_candidates, key=lambda t: t[0])\n\n    conviction_val = _LIFECYCLE_RECENCY_SCORE.get(lifecycle[\"state\"], 0.0)\n\n    ms = enrichment[\"momentum_state\"][\"value\"]\n    momentum_val = _MOMENTUM_SCORE.get(ms, 0.5)\n    momentum_note = f\"momentum_state={ms!r}\" if ms is not None \\\n        else \"momentum_state unavailable — neutral fallback, flagged degraded\"\n\n    ok_count = sum(1 for f in enrichment.values() if f[\"state\"] == \"OK\")\n    data_quality_val = round(ok_count / len(enrichment), 4)\n\n    components = [\n        {\"name\": \"kol_independence\", \"value\": kol_independence_val,\n         \"weight\": OPPORTUNITY_WEIGHTS[\"kol_independence\"],\n         \"contribution\": round(kol_independence_val * OPPORTUNITY_WEIGHTS[\"kol_independence\"], 4),\n         \"note\": f\"{independence['supporting_kol_count']} distinct supporting account(s)\"},\n        {\"name\": \"kol_track_record\", \"value\": kol_track_record_val,\n         \"weight\": OPPORTUNITY_WEIGHTS[\"kol_track_record\"],\n         \"contribution\": round(kol_track_record_val * OPPORTUNITY_WEIGHTS[\"kol_track_record\"], 4),\n         \"note\": kol_track_record_note},\n        {\"name\": \"conviction_recency\", \"value\": conviction_val,\n         \"weight\": OPPORTUNITY_WEIGHTS[\"conviction_recency\"],\n         \"contribution\": round(conviction_val * OPPORTUNITY_WEIGHTS[\"conviction_recency\"], 4),\n         \"note\": f\"lifecycle={lifecycle['state']!r}\"},\n        {\"name\": \"momentum_not_overextended\", \"value\": momentum_val,\n         \"weight\": OPPORTUNITY_WEIGHTS[\"momentum_not_overextended\"],\n         \"contribution\": round(momentum_val * OPPORTUNITY_WEIGHTS[\"momentum_not_overextended\"], 4),\n         \"note\": momentum_note},\n        {\"name\": \"data_quality\", \"value\": data_quality_val,\n         \"weight\": OPPORTUNITY_WEIGHTS[\"data_quality\"],\n         \"contribution\": round(data_quality_val * OPPORTUNITY_WEIGHTS[\"data_quality\"], 4),\n         \"note\": f\"{ok_count}/{len(enrichment)} enrichment fields OK\"},\n    ]\n    total = round(sum(c[\"contribution\"] for c in components), 4)\n\n    reasons_for, reasons_against = [], []\n    for c in components:\n        if c[\"value\"] >= 0.6:\n            reasons_for.append(f\"{c['name']}: {c['note']} (score {c['value']})\")\n        elif c[\"value\"] <= 0.35:\n            reasons_against.append(f\"{c['name']}: {c['note']} (score {c['value']})\")\n\n    # A one-sided rationale is a recommendation, not research: when no component\n    # clears either threshold (all mid-range), the strongest and weakest components\n    # still stand in for FOR/AGAINST rather than leaving a side empty.\n    if not reasons_for:\n        best = max(components, key=lambda c: c[\"value\"])\n        reasons_for.append(\n            f\"{best['name']}: {best['note']} (score {best['value']}) — \"\n            \"highest-scoring factor, no component cleared the >=0.6 bar\")\n    if not reasons_against:\n        worst = min(components, key=lambda c: c[\"value\"])\n        reasons_against.append(\n            f\"{worst['name']}: {worst['note']} (score {worst['value']}) — \"\n            \"lowest-scoring factor, no component fell below the <=0.35 bar\")\n\n    return {\"total\": total, \"components\": components,\n            \"reasons_for\": reasons_for, \"reasons_against\": reasons_against}\n\n\n# ── verifier-contract view ───────────────────────────────────────────────────\n# factory_v2.product_verifiers.verify_tr_ticker (control repo) recomputes acceptance\n# from a flat, closed-vocabulary shape (top-level \"tickers\", per-row scalar lifecycle/\n# risk_tier, a typed \"fundamentals\" section keyed market_cap/size_bucket/country/\n# momentum_state/liquidity_warning with value/source/as_of/status). That shape is a\n# projection of the same data already computed in `row`, not a second source of truth.\n\ndef _provenance_field(field: dict) -> dict:\n    return {\"value\": field[\"value\"], \"source\": field[\"source\"],\n            \"as_of\": field[\"retrieved_at\"], \"status\": field[\"state\"]}\n\n\ndef build_fundamentals(row: dict) -> dict:\n    enrichment = row[\"enrichment\"]\n    mc = enrichment[\"market_cap\"]\n    bucket = row[\"risk\"][\"inputs\"][\"size_bucket\"]\n    return {\n        \"market_cap\": _provenance_field(mc),\n        \"size_bucket\": {\n            \"value\": bucket,\n            \"source\": \"derived:risk cascade size_bucket thresholds vs market_cap\",\n            \"as_of\": mc[\"retrieved_at\"],\n            \"status\": \"OK\" if bucket not in (None, \"UNKNOWN\") else \"FIELD_NOT_PROVIDED\",\n        },\n        \"country\": _provenance_field(enrichment[\"market_country\"]),\n        \"momentum_state\": _provenance_field(enrichment[\"momentum_state\"]),\n        \"liquidity_warning\": {\n            \"value\": row[\"warnings\"][\"liquidity\"],\n            \"source\": \"derived:average_volume provider state\",\n            \"as_of\": enrichment[\"average_volume\"][\"retrieved_at\"],\n            \"status\": \"OK\",\n        },\n    }\n\n\ndef build_ticker_view(row: dict) -> dict:\n    return {\n        \"ticker\": row[\"ticker\"],\n        \"supporting_kol_count\": row[\"independence\"][\"supporting_kol_count\"],\n        \"lifecycle\": row[\"lifecycle\"][\"state\"],\n        \"lifecycle_rule\": row[\"lifecycle\"][\"rule\"],\n        \"lifecycle_source_episode_ids\": row[\"lifecycle\"][\"decided_by_opening_tweet_ids\"],\n        \"risk_tier\": row[\"risk\"][\"tier\"],\n        \"opportunity_score\": row[\"opportunity_score\"],\n        \"fundamentals\": build_fundamentals(row),\n    }\n\n\n# ── row assembly ─────────────────────────────────────────────────────────────\n\ndef build_row(ticker: str, ticker_episodes: list, as_of: date, ranking_by_handle: dict,\n             cache_entry: \"dict | None\") -> tuple:\n    lifecycle = compute_lifecycle(ticker_episodes, as_of)\n    independence = compute_independence(ticker_episodes)\n    enrichment, fetch_state, asset_class, quote_type = build_enrichment(ticker, cache_entry)\n    risk = compute_risk(enrichment, asset_class, independence[\"supporting_kol_count\"])\n    opportunity = compute_opportunity(independence, lifecycle, enrichment, ranking_by_handle)\n\n    first_ep = min(ticker_episodes,\n                   key=lambda e: (e[\"tweet_date\"], int(e[\"opening_tweet_id\"])))\n    pushes_by_account = defaultdict(int)\n    for ep in ticker_episodes:\n        pushes_by_account[ep[\"account\"]] += ep.get(\"pushes\", 0)\n\n    liquidity_warnings = []\n    if enrichment[\"average_volume\"][\"state\"] != \"OK\":\n        liquidity_warnings.append(\"average trading volume unavailable from provider\")\n    dq_fields = [f for f, v in enrichment.items() if v[\"state\"] != \"OK\"]\n    data_quality_warnings = [f\"{f}: {enrichment[f]['state']}\" for f in dq_fields]\n\n    row = {\n        \"ticker\": ticker,\n        \"asset_class\": asset_class,\n        \"lifecycle\": lifecycle,\n        \"episodes\": {\n            \"count\": len(ticker_episodes),\n            \"episode_ids\": sorted(episode_id(e) for e in ticker_episodes),\n        },\n        \"first_call\": {\n            \"account\": first_ep[\"account\"],\n            \"tweet_date\": first_ep[\"tweet_date\"],\n            \"opening_tweet_id\": first_ep[\"opening_tweet_id\"],\n            \"thesis\": first_ep[\"thesis\"],\n            \"episode_id\": episode_id(first_ep),\n        },\n        \"independence\": independence,\n        \"conviction_evolution\": {\n            \"total_pushes\": sum(pushes_by_account.values()),\n            \"pushes_by_account\": dict(sorted(pushes_by_account.items())),\n        },\n        \"enrichment\": enrichment,\n        \"enrichment_fetch_state\": fetch_state,\n        \"value_chain_role\": VALUE_CHAIN_ROLE.get(enrichment[\"ai_subindustry\"][\"value\"]),\n        \"risk\": risk,\n        \"opportunity_score\": opportunity,\n        \"warnings\": {\n            \"liquidity\": liquidity_warnings,\n            \"data_quality\": data_quality_warnings,\n        },\n    }\n    provenance_entry = {\n        \"asset_class\": asset_class,\n        \"fetch_state\": fetch_state,\n        \"fields\": {name: {k: v for k, v in field.items() if k != \"value\"}\n                  for name, field in enrichment.items()},\n    }\n    return row, provenance_entry\n\n\n# ── top level ────────────────────────────────────────────────────────────────\n\ndef build(ledger: dict, ranking: \"dict | None\", cache: \"dict | None\") -> tuple:\n    episodes = ledger[\"episodes\"]\n    grouped = group_by_ticker(episodes)\n    as_of = _parse_date(max(ep[\"tweet_date\"] for ep in episodes))\n\n    ranking_by_handle = {}\n    if ranking is not None:\n        for acc in ranking.get(\"accounts\", []):\n            ranking_by_handle[acc[\"handle\"]] = acc\n\n    cache_tickers = (cache or {}).get(\"tickers\", {})\n\n    rows, provenance = [], {}\n    for ticker in sorted(grouped):\n        row, prov_entry = build_row(ticker, grouped[ticker], as_of, ranking_by_handle,\n                                    cache_tickers.get(ticker))\n        rows.append(row)\n        provenance[ticker] = prov_entry\n\n    generated_at = datetime.now(timezone.utc).isoformat()\n    table = {\n        \"schema\": SCHEMA_TABLE,\n        \"generated_at\": generated_at,\n        \"source_ledger\": {\n            \"path\": \"research/tr_call_ledger.json\",\n            \"episode_count_total\": len(episodes),\n            \"distinct_tickers\": len(grouped),\n        },\n        \"as_of_date\": as_of.isoformat(),\n        \"lifecycle_rule\": {\n            \"new_call_window_days\": NEW_CALL_WINDOW_DAYS,\n            \"active_call_window_days\": ACTIVE_CALL_WINDOW_DAYS,\n            \"active_call_window_rationale\": (\n                \"120 trading sessions (SPEC.md's longest frozen evaluation horizon) \"\n                \"* 365/252 calendar-to-trading-day ratio ~= 174 calendar days\"),\n        },\n        \"opportunity_weights\": OPPORTUNITY_WEIGHTS,\n        \"row_count\": len(rows),\n        \"rows\": rows,\n        \"tickers\": [build_ticker_view(row) for row in rows],\n    }\n    provenance_doc = {\n        \"schema\": SCHEMA_PROVENANCE,\n        \"generated_at\": generated_at,\n        \"provider\": (cache or {}).get(\"provider\", \"yfinance\"),\n        \"provider_version\": (cache or {}).get(\"provider_version\"),\n        \"query_overrides\": (cache or {}).get(\"query_overrides\", {}),\n        \"override_rationale\": (cache or {}).get(\"override_rationale\"),\n        \"ticker_count\": len(provenance),\n        \"tickers\": provenance,\n    }\n    return table, provenance_doc\n\n\ndef main(argv=None) -> int:\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--ledger\", default=\"research/tr_call_ledger.json\")\n    ap.add_argument(\"--ranking\", default=\"research/tr_kol_ranking.json\")\n    ap.add_argument(\"--cache\", default=\"research/tr_ticker_yfinance_cache.json\")\n    ap.add_argument(\"--out-table\", default=\"research/tr_ticker_table.json\")\n    ap.add_argument(\"--out-provenance\", default=\"research/tr_ticker_enrichment_provenance.json\")\n    args = ap.parse_args(argv)\n\n    ledger = load_json(args.ledger)\n    if ledger is None:\n        raise SystemExit(f\"required ledger not found: {args.ledger}\")\n    ranking = load_json(args.ranking)\n    cache = load_json(args.cache)\n\n    table, provenance = build(ledger, ranking, cache)\n\n    Path(args.out_table).write_text(json.dumps(table, indent=2, sort_keys=True) + \"\\n\",\n                                    encoding=\"utf-8\")\n    Path(args.out_provenance).write_text(\n        json.dumps(provenance, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    print(f\"wrote {table['row_count']} ticker rows -> {args.out_table}\")\n    print(f\"wrote provenance for {provenance['ticker_count']} tickers -> {args.out_provenance}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","numLines":666,"startLine":1,"totalLines":666}}}
