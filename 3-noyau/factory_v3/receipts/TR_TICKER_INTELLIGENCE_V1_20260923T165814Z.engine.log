{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011cVVD2LqpTrrMd8BvwNHy1","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"tr_ticker_enrich_fetch.py — real yfinance fetch for every ticker in the TR call\n3\tledger, written to a typed raw cache consumed by build_tr_ticker_table.py.\n4\t\n5\tKept separate from the aggregation script so the pytest suite can run against a\n6\tsynthetic cache fixture with zero network dependency, while this script performs\n7\tthe one real fetch that produces the delivered artifact.\n8\t\n9\tTyped states, never invented values:\n10\t  PROVIDER_UNAVAILABLE — the fetch raised, or returned no quoteType and no price\n11\t                          field at all (ticker not found / rate limited).\n12\t  OK                    — the fetch itself succeeded; individual missing fields\n13\t                          are typed FIELD_NOT_PROVIDED downstream, not here.\n14\t\n15\tUsage:\n16\t    python3 scripts/tr_ticker_enrich_fetch.py \\\n17\t        --ledger research/tr_call_ledger.json \\\n18\t        --out research/tr_ticker_yfinance_cache.json\n19\t\"\"\"\n20\tfrom __future__ import annotations\n21\t\n22\timport argparse\n23\timport json\n24\timport sys\n25\timport time\n26\tfrom datetime import datetime, timezone\n27\tfrom pathlib import Path\n28\t\n29\t# BTC/ETH on plain yfinance symbols resolve to Grayscale Mini Trust ETFs (quoteType\n30\t# ETF, live price ~$34 / ~$23) -- NOT the cryptocurrency. tr_call_ledger.json's\n31\t# frozen entry/exit prices for these tickers (e.g. BTC close=68078.5547 on\n32\t# 2026-04-01, matching real BTC-USD spot magnitude) come from the market CSV that\n33\t# priced them as the crypto asset. Verified live 2026-09-10: yf.Ticker(\"BTC-USD\")\n34\t# ~= 78240, yf.Ticker(\"BTC\") (Grayscale ETF) ~= 34.59 -- a real symbol collision,\n35\t# not an assumption. Override documented in the provenance output, never silent.\n36\tCRYPTO_QUERY_OVERRIDE = {\"BTC\": \"BTC-USD\", \"ETH\": \"ETH-USD\"}\n37\tCRYPTO_ASSET_CLASS_OVERRIDE = {\"BTC\": \"CRYPTO\", \"ETH\": \"CRYPTO\"}\n38\t\n39\tRAW_FIELDS = (\n40\t    \"quoteType\", \"longName\", \"shortName\", \"longBusinessSummary\", \"sector\",\n41\t    \"industry\", \"country\", \"fullTimeEmployees\", \"marketCap\", \"trailingPE\",\n42\t    \"forwardPE\", \"priceToBook\", \"totalRevenue\", \"revenueGrowth\", \"totalCash\",\n43\t    \"totalDebt\", \"profitMargins\", \"currentPrice\", \"regularMarketPrice\",\n44\t    \"previousClose\", \"fiftyDayAverage\", \"twoHundredDayAverage\",\n45\t    \"fiftyTwoWeekHigh\", \"fiftyTwoWeekLow\", \"averageVolume\",\n46\t    \"averageDailyVolume10Day\", \"currency\", \"exchange\",\n47\t)\n48\t\n49\t_PRICE_FIELDS = (\"currentPrice\", \"regularMarketPrice\", \"previousClose\")\n50\t\n51\t\n52\tdef load_ledger_tickers(ledger_path: Path) -> list:\n53\t    ledger = json.loads(ledger_path.read_text(encoding=\"utf-8\"))\n54\t    return sorted({ep[\"ticker\"] for ep in ledger[\"episodes\"]})\n55\t\n56\t\n57\tdef _fetch_one(ticker: str, yf_module) -> dict:\n58\t    query_symbol = CRYPTO_QUERY_OVERRIDE.get(ticker, ticker)\n59\t    asset_class_override = CRYPTO_ASSET_CLASS_OVERRIDE.get(ticker)\n60\t    retrieved_at = datetime.now(timezone.utc).isoformat()\n61\t    try:\n62\t        info = yf_module.Ticker(query_symbol).info\n63\t    except Exception as exc:  # network / rate-limit / provider errors — typed, not raised\n64\t        return {\n65\t            \"query_symbol\": query_symbol,\n66\t            \"asset_class_override\": asset_class_override,\n67\t            \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n68\t            \"provider_error\": f\"{type(exc).__name__}: {exc}\",\n69\t            \"retrieved_at\": retrieved_at,\n70\t            \"raw\": {},\n71\t        }\n72\t    if not isinstance(info, dict) or not info:\n73\t        return {\n74\t            \"query_symbol\": query_symbol,\n75\t            \"asset_class_override\": asset_class_override,\n76\t            \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n77\t            \"provider_error\": \"empty response\",\n78\t            \"retrieved_at\": retrieved_at,\n79\t            \"raw\": {},\n80\t        }\n81\t    has_quote_type = bool(info.get(\"quoteType\"))\n82\t    has_price = any(info.get(f) is not None for f in _PRICE_FIELDS)\n83\t    if not has_quote_type and not has_price:\n84\t        return {\n85\t            \"query_symbol\": query_symbol,\n86\t            \"asset_class_override\": asset_class_override,\n87\t            \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n88\t            \"provider_error\": \"no quoteType and no price field — ticker likely not found\",\n89\t            \"retrieved_at\": retrieved_at,\n90\t            \"raw\": {},\n91\t        }\n92\t    raw = {f: info.get(f) for f in RAW_FIELDS if info.get(f) is not None}\n93\t    return {\n94\t        \"query_symbol\": query_symbol,\n95\t        \"asset_class_override\": asset_class_override,\n96\t        \"fetch_state\": \"OK\",\n97\t        \"retrieved_at\": retrieved_at,\n98\t        \"raw\": raw,\n99\t    }\n100\t\n101\t\n102\tdef fetch_all(tickers: list, sleep_s: float = 0.0, yf_module=None) -> dict:\n103\t    if yf_module is None:\n104\t        import yfinance as yf_module  # deferred: keeps this importable without the dep in tests\n105\t    results = {}\n106\t    for i, ticker in enumerate(tickers):\n107\t        results[ticker] = _fetch_one(ticker, yf_module)\n108\t        if sleep_s and i < len(tickers) - 1:\n109\t            time.sleep(sleep_s)\n110\t    return results\n111\t\n112\t\n113\tdef build_cache(ledger_path: Path, sleep_s: float = 0.0, yf_module=None,\n114\t                tickers: \"list | None\" = None) -> dict:\n115\t    ts = tickers if tickers is not None else load_ledger_tickers(ledger_path)\n116\t    fetched = fetch_all(ts, sleep_s=sleep_s, yf_module=yf_module)\n117\t    ok = sum(1 for v in fetched.values() if v[\"fetch_state\"] == \"OK\")\n118\t    return {\n119\t        \"schema\": \"tr-ticker-yfinance-cache/v1\",\n120\t        \"generated_at\": datetime.now(timezone.utc).isoformat(),\n121\t        \"provider\": \"yfinance\",\n122\t        \"provider_version\": _yfinance_version(yf_module),\n123\t        \"source_ledger\": str(ledger_path),\n124\t        \"query_overrides\": CRYPTO_QUERY_OVERRIDE,\n125\t        \"asset_class_overrides\": CRYPTO_ASSET_CLASS_OVERRIDE,\n126\t        \"override_rationale\": (\n127\t            \"BTC/ETH plain symbols resolve on yfinance to Grayscale Mini Trust ETFs \"\n128\t            \"(quoteType=ETF), not the cryptocurrency. tr_call_ledger.json's frozen \"\n129\t            \"entry/exit prices for BTC/ETH match real spot crypto price magnitude \"\n130\t            \"(verified against the market CSV it was built from), not the ETF's. \"\n131\t            \"Queried as BTC-USD/ETH-USD instead; asset_class forced to CRYPTO.\"\n132\t        ),\n133\t        \"ticker_count\": len(ts),\n134\t        \"fetch_ok_count\": ok,\n135\t        \"fetch_unavailable_count\": len(ts) - ok,\n136\t        \"tickers\": fetched,\n137\t    }\n138\t\n139\t\n140\tdef _yfinance_version(yf_module) -> str:\n141\t    try:\n142\t        if yf_module is None:\n143\t            import yfinance as yf_module  # noqa: F811\n144\t        return getattr(yf_module, \"__version__\", \"unknown\")\n145\t    except Exception:\n146\t        return \"unknown\"\n147\t\n148\t\n149\tdef main(argv=None) -> int:\n150\t    ap = argparse.ArgumentParser(description=__doc__)\n151\t    ap.add_argument(\"--ledger\", default=\"research/tr_call_ledger.json\")\n152\t    ap.add_argument(\"--out\", default=\"research/tr_ticker_yfinance_cache.json\")\n153\t    ap.add_argument(\"--sleep\", type=float, default=0.0,\n154\t                     help=\"courtesy delay in seconds between requests\")\n155\t    args = ap.parse_args(argv)\n156\t\n157\t    ledger_path = Path(args.ledger)\n158\t    cache = build_cache(ledger_path, sleep_s=args.sleep)\n159\t    out_path = Path(args.out)\n160\t    out_path.write_text(json.dumps(cache, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n161\t    print(f\"fetched {cache['ticker_count']} tickers: \"\n162\t          f\"{cache['fetch_ok_count']} OK, {cache['fetch_unavailable_count']} PROVIDER_UNAVAILABLE \"\n163\t          f\"-> {out_path}\")\n164\t    return 0\n165\t\n166\t\n167\tif __name__ == \"__main__\":\n168\t    sys.exit(main())\n169\t"}]},"parent_tool_use_id":null,"session_id":"80a42da3-70a5-4179-95d8-64a5724a163e","uuid":"84873c53-4b7f-490e-a1d3-82cf65b3caad","timestamp":"2026-09-23T16:58:37.443Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-nwaodvq5/scripts/tr_ticker_enrich_fetch.py","content":"#!/usr/bin/env python3\n\"\"\"tr_ticker_enrich_fetch.py — real yfinance fetch for every ticker in the TR call\nledger, written to a typed raw cache consumed by build_tr_ticker_table.py.\n\nKept separate from the aggregation script so the pytest suite can run against a\nsynthetic cache fixture with zero network dependency, while this script performs\nthe one real fetch that produces the delivered artifact.\n\nTyped states, never invented values:\n  PROVIDER_UNAVAILABLE — the fetch raised, or returned no quoteType and no price\n                          field at all (ticker not found / rate limited).\n  OK                    — the fetch itself succeeded; individual missing fields\n                          are typed FIELD_NOT_PROVIDED downstream, not here.\n\nUsage:\n    python3 scripts/tr_ticker_enrich_fetch.py \\\n        --ledger research/tr_call_ledger.json \\\n        --out research/tr_ticker_yfinance_cache.json\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\n# BTC/ETH on plain yfinance symbols resolve to Grayscale Mini Trust ETFs (quoteType\n# ETF, live price ~$34 / ~$23) -- NOT the cryptocurrency. tr_call_ledger.json's\n# frozen entry/exit prices for these tickers (e.g. BTC close=68078.5547 on\n# 2026-04-01, matching real BTC-USD spot magnitude) come from the market CSV that\n# priced them as the crypto asset. Verified live 2026-09-10: yf.Ticker(\"BTC-USD\")\n# ~= 78240, yf.Ticker(\"BTC\") (Grayscale ETF) ~= 34.59 -- a real symbol collision,\n# not an assumption. Override documented in the provenance output, never silent.\nCRYPTO_QUERY_OVERRIDE = {\"BTC\": \"BTC-USD\", \"ETH\": \"ETH-USD\"}\nCRYPTO_ASSET_CLASS_OVERRIDE = {\"BTC\": \"CRYPTO\", \"ETH\": \"CRYPTO\"}\n\nRAW_FIELDS = (\n    \"quoteType\", \"longName\", \"shortName\", \"longBusinessSummary\", \"sector\",\n    \"industry\", \"country\", \"fullTimeEmployees\", \"marketCap\", \"trailingPE\",\n    \"forwardPE\", \"priceToBook\", \"totalRevenue\", \"revenueGrowth\", \"totalCash\",\n    \"totalDebt\", \"profitMargins\", \"currentPrice\", \"regularMarketPrice\",\n    \"previousClose\", \"fiftyDayAverage\", \"twoHundredDayAverage\",\n    \"fiftyTwoWeekHigh\", \"fiftyTwoWeekLow\", \"averageVolume\",\n    \"averageDailyVolume10Day\", \"currency\", \"exchange\",\n)\n\n_PRICE_FIELDS = (\"currentPrice\", \"regularMarketPrice\", \"previousClose\")\n\n\ndef load_ledger_tickers(ledger_path: Path) -> list:\n    ledger = json.loads(ledger_path.read_text(encoding=\"utf-8\"))\n    return sorted({ep[\"ticker\"] for ep in ledger[\"episodes\"]})\n\n\ndef _fetch_one(ticker: str, yf_module) -> dict:\n    query_symbol = CRYPTO_QUERY_OVERRIDE.get(ticker, ticker)\n    asset_class_override = CRYPTO_ASSET_CLASS_OVERRIDE.get(ticker)\n    retrieved_at = datetime.now(timezone.utc).isoformat()\n    try:\n        info = yf_module.Ticker(query_symbol).info\n    except Exception as exc:  # network / rate-limit / provider errors — typed, not raised\n        return {\n            \"query_symbol\": query_symbol,\n            \"asset_class_override\": asset_class_override,\n            \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n            \"provider_error\": f\"{type(exc).__name__}: {exc}\",\n            \"retrieved_at\": retrieved_at,\n            \"raw\": {},\n        }\n    if not isinstance(info, dict) or not info:\n        return {\n            \"query_symbol\": query_symbol,\n            \"asset_class_override\": asset_class_override,\n            \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n            \"provider_error\": \"empty response\",\n            \"retrieved_at\": retrieved_at,\n            \"raw\": {},\n        }\n    has_quote_type = bool(info.get(\"quoteType\"))\n    has_price = any(info.get(f) is not None for f in _PRICE_FIELDS)\n    if not has_quote_type and not has_price:\n        return {\n            \"query_symbol\": query_symbol,\n            \"asset_class_override\": asset_class_override,\n            \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n            \"provider_error\": \"no quoteType and no price field — ticker likely not found\",\n            \"retrieved_at\": retrieved_at,\n            \"raw\": {},\n        }\n    raw = {f: info.get(f) for f in RAW_FIELDS if info.get(f) is not None}\n    return {\n        \"query_symbol\": query_symbol,\n        \"asset_class_override\": asset_class_override,\n        \"fetch_state\": \"OK\",\n        \"retrieved_at\": retrieved_at,\n        \"raw\": raw,\n    }\n\n\ndef fetch_all(tickers: list, sleep_s: float = 0.0, yf_module=None) -> dict:\n    if yf_module is None:\n        import yfinance as yf_module  # deferred: keeps this importable without the dep in tests\n    results = {}\n    for i, ticker in enumerate(tickers):\n        results[ticker] = _fetch_one(ticker, yf_module)\n        if sleep_s and i < len(tickers) - 1:\n            time.sleep(sleep_s)\n    return results\n\n\ndef build_cache(ledger_path: Path, sleep_s: float = 0.0, yf_module=None,\n                tickers: \"list | None\" = None) -> dict:\n    ts = tickers if tickers is not None else load_ledger_tickers(ledger_path)\n    fetched = fetch_all(ts, sleep_s=sleep_s, yf_module=yf_module)\n    ok = sum(1 for v in fetched.values() if v[\"fetch_state\"] == \"OK\")\n    return {\n        \"schema\": \"tr-ticker-yfinance-cache/v1\",\n        \"generated_at\": datetime.now(timezone.utc).isoformat(),\n        \"provider\": \"yfinance\",\n        \"provider_version\": _yfinance_version(yf_module),\n        \"source_ledger\": str(ledger_path),\n        \"query_overrides\": CRYPTO_QUERY_OVERRIDE,\n        \"asset_class_overrides\": CRYPTO_ASSET_CLASS_OVERRIDE,\n        \"override_rationale\": (\n            \"BTC/ETH plain symbols resolve on yfinance to Grayscale Mini Trust ETFs \"\n            \"(quoteType=ETF), not the cryptocurrency. tr_call_ledger.json's frozen \"\n            \"entry/exit prices for BTC/ETH match real spot crypto price magnitude \"\n            \"(verified against the market CSV it was built from), not the ETF's. \"\n            \"Queried as BTC-USD/ETH-USD instead; asset_class forced to CRYPTO.\"\n        ),\n        \"ticker_count\": len(ts),\n        \"fetch_ok_count\": ok,\n        \"fetch_unavailable_count\": len(ts) - ok,\n        \"tickers\": fetched,\n    }\n\n\ndef _yfinance_version(yf_module) -> str:\n    try:\n        if yf_module is None:\n            import yfinance as yf_module  # noqa: F811\n        return getattr(yf_module, \"__version__\", \"unknown\")\n    except Exception:\n        return \"unknown\"\n\n\ndef main(argv=None) -> int:\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--ledger\", default=\"research/tr_call_ledger.json\")\n    ap.add_argument(\"--out\", default=\"research/tr_ticker_yfinance_cache.json\")\n    ap.add_argument(\"--sleep\", type=float, default=0.0,\n                     help=\"courtesy delay in seconds between requests\")\n    args = ap.parse_args(argv)\n\n    ledger_path = Path(args.ledger)\n    cache = build_cache(ledger_path, sleep_s=args.sleep)\n    out_path = Path(args.out)\n    out_path.write_text(json.dumps(cache, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    print(f\"fetched {cache['ticker_count']} tickers: \"\n          f\"{cache['fetch_ok_count']} OK, {cache['fetch_unavailable_count']} PROVIDER_UNAVAILABLE \"\n          f\"-> {out_path}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":169,"startLine":1,"totalLines":169}}}
