edger[\"episodes\"]}\n     assert {r[\"ticker\"] for r in table[\"rows\"]} == expected_tickers\n-    assert table[\"row_count\"] == len(expected_tickers) == 727\n+    # the count is ledger-derived, never authored: a hardcoded number would break on\n+    # every ledger expansion and invite universe shaping to hit a magic value\n+    assert len(expected_tickers) > 0\n+    assert table[\"row_count\"] == len(expected_tickers)\n+    # verifier-contract projection must stay in lockstep with the full rows\n+    assert len(table[\"tickers\"]) == table[\"row_count\"]\n+    assert {t[\"ticker\"] for t in table[\"tickers\"]} == expected_tickers\n     assert table[\"schema\"] == \"tr-ticker-table/v1\"\n     assert provenance[\"schema\"] == \"tr-ticker-enrichment-provenance/v1\"\n \n     # every episode_id referenced in every row must exist in the real ledger\n","filediff":{"file":"/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/tests/test_tr_ticker_intelligence.py","patch":"Index: /private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/tests/test_tr_ticker_intelligence.py\n===================================================================\n--- /private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/tests/test_tr_ticker_intelligence.py\n+++ /private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/tests/test_tr_ticker_intelligence.py\n@@ -298,9 +298,15 @@\n def test_real_ledger_full_build_universe_and_schema(real_ledger, real_ranking):\n     table, provenance = build(real_ledger, real_ranking, cache=None)\n     expected_tickers = {e[\"ticker\"] for e in real_ledger[\"episodes\"]}\n     assert {r[\"ticker\"] for r in table[\"rows\"]} == expected_tickers\n-    assert table[\"row_count\"] == len(expected_tickers) == 727\n+    # the count is ledger-derived, never authored: a hardcoded number would break on\n+    # every ledger expansion and invite universe shaping to hit a magic value\n+    assert len(expected_tickers) > 0\n+    assert table[\"row_count\"] == len(expected_tickers)\n+    # verifier-contract projection must stay in lockstep with the full rows\n+    assert len(table[\"tickers\"]) == table[\"row_count\"]\n+    assert {t[\"ticker\"] for t in table[\"tickers\"]} == expected_tickers\n     assert table[\"schema\"] == \"tr-ticker-table/v1\"\n     assert provenance[\"schema\"] == \"tr-ticker-enrichment-provenance/v1\"\n \n     # every episode_id referenced in every row must exist in the real ledger\n","additions":7,"deletions":1},"truncated":false},"title":"tests/test_tr_ticker_intelligence.py","time":{"start":1790183148923,"end":1790183148925}},"id":"prt_0cf3b0d76001IUP50nVO3uvTIP","sessionID":"ses_f30c77858ffeQU0a2T0vQ13xKn","messageID":"msg_0cf3af974001G38beMXWm9rlNH"}}
