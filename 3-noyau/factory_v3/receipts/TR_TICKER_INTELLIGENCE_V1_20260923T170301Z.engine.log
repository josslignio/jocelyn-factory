{"type":"tool_use","timestamp":1790183079482,"sessionID":"ses_f30c77858ffeQU0a2T0vQ13xKn","part":{"type":"tool","tool":"read","callID":"call_18d97530b69e43648fd87a7d","state":{"status":"completed","input":{"filePath":"/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/scripts/tr_ticker_enrich_fetch.py"},"output":"<path>/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/scripts/tr_ticker_enrich_fetch.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"tr_ticker_enrich_fetch.py — real yfinance fetch for every ticker in the TR call\n3: ledger, written to a typed raw cache consumed by build_tr_ticker_table.py.\n4: \n5: Kept separate from the aggregation script so the pytest suite can run against a\n6: synthetic cache fixture with zero network dependency, while this script performs\n7: the one real fetch that produces the delivered artifact.\n8: \n9: Typed states, never invented values:\n10:   PROVIDER_UNAVAILABLE — the fetch raised, or returned no quoteType and no price\n11:                           field at all (ticker not found / rate limited).\n12:   OK                    — the fetch itself succeeded; individual missing fields\n13:                           are typed FIELD_NOT_PROVIDED downstream, not here.\n14: \n15: Usage:\n16:     python3 scripts/tr_ticker_enrich_fetch.py \\\n17:         --ledger research/tr_call_ledger.json \\\n18:         --out research/tr_ticker_yfinance_cache.json\n19: \"\"\"\n20: from __future__ import annotations\n21: \n22: import argparse\n23: import json\n24: import sys\n25: import time\n26: from datetime import datetime, timezone\n27: from pathlib import Path\n28: \n29: # BTC/ETH on plain yfinance symbols resolve to Grayscale Mini Trust ETFs (quoteType\n30: # ETF, live price ~$34 / ~$23) -- NOT the cryptocurrency. tr_call_ledger.json's\n31: # frozen entry/exit prices for these tickers (e.g. BTC close=68078.5547 on\n32: # 2026-04-01, matching real BTC-USD spot magnitude) come from the market CSV that\n33: # priced them as the crypto asset. Verified live 2026-09-10: yf.Ticker(\"BTC-USD\")\n34: # ~= 78240, yf.Ticker(\"BTC\") (Grayscale ETF) ~= 34.59 -- a real symbol collision,\n35: # not an assumption. Override documented in the provenance output, never silent.\n36: CRYPTO_QUERY_OVERRIDE = {\"BTC\": \"BTC-USD\", \"ETH\": \"ETH-USD\"}\n37: CRYPTO_ASSET_CLASS_OVERRIDE = {\"BTC\": \"CRYPTO\", \"ETH\": \"CRYPTO\"}\n38: \n39: RAW_FIELDS = (\n40:     \"quoteType\", \"longName\", \"shortName\", \"longBusinessSummary\", \"sector\",\n41:     \"industry\", \"country\", \"fullTimeEmployees\", \"marketCap\", \"trailingPE\",\n42:     \"forwardPE\", \"priceToBook\", \"totalRevenue\", \"revenueGrowth\", \"totalCash\",\n43:     \"totalDebt\", \"profitMargins\", \"currentPrice\", \"regularMarketPrice\",\n44:     \"previousClose\", \"fiftyDayAverage\", \"twoHundredDayAverage\",\n45:     \"fiftyTwoWeekHigh\", \"fiftyTwoWeekLow\", \"averageVolume\",\n46:     \"averageDailyVolume10Day\", \"currency\", \"exchange\",\n47: )\n48: \n49: _PRICE_FIELDS = (\"currentPrice\", \"regularMarketPrice\", \"previousClose\")\n50: \n51: \n52: def load_ledger_tickers(ledger_path: Path) -> list:\n53:     ledger = json.loads(ledger_path.read_text(encoding=\"utf-8\"))\n54:     return sorted({ep[\"ticker\"] for ep in ledger[\"episodes\"]})\n55: \n56: \n57: def _fetch_one(ticker: str, yf_module) -> dict:\n58:     query_symbol = CRYPTO_QUERY_OVERRIDE.get(ticker, ticker)\n59:     asset_class_override = CRYPTO_ASSET_CLASS_OVERRIDE.get(ticker)\n60:     retrieved_at = datetime.now(timezone.utc).isoformat()\n61:     try:\n62:         info = yf_module.Ticker(query_symbol).info\n63:     except Exception as exc:  # network / rate-limit / provider errors — typed, not raised\n64:         return {\n65:             \"query_symbol\": query_symbol,\n66:             \"asset_class_override\": asset_class_override,\n67:             \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n68:             \"provider_error\": f\"{type(exc).__name__}: {exc}\",\n69:             \"retrieved_at\": retrieved_at,\n70:             \"raw\": {},\n71:         }\n72:     if not isinstance(info, dict) or not info:\n73:         return {\n74:             \"query_symbol\": query_symbol,\n75:             \"asset_class_override\": asset_class_override,\n76:             \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n77:             \"provider_error\": \"empty response\",\n78:             \"retrieved_at\": retrieved_at,\n79:             \"raw\": {},\n80:         }\n81:     has_quote_type = bool(info.get(\"quoteType\"))\n82:     has_price = any(info.get(f) is not None for f in _PRICE_FIELDS)\n83:     if not has_quote_type and not has_price:\n84:         return {\n85:             \"query_symbol\": query_symbol,\n86:             \"asset_class_override\": asset_class_override,\n87:             \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n88:             \"provider_error\": \"no quoteType and no price field — ticker likely not found\",\n89:             \"retrieved_at\": retrieved_at,\n90:             \"raw\": {},\n91:         }\n92:     raw = {f: info.get(f) for f in RAW_FIELDS if info.get(f) is not None}\n93:     return {\n94:         \"query_symbol\": query_symbol,\n95:         \"asset_class_override\": asset_class_override,\n96:         \"fetch_state\": \"OK\",\n97:         \"retrieved_at\": retrieved_at,\n98:         \"raw\": raw,\n99:     }\n100: \n101: \n102: def fetch_all(tickers: list, sleep_s: float = 0.0, yf_module=None) -> dict:\n103:     if yf_module is None:\n104:         import yfinance as yf_module  # deferred: keeps this importable without the dep in tests\n105:     results = {}\n106:     for i, ticker in enumerate(tickers):\n107:         results[ticker] = _fetch_one(ticker, yf_module)\n108:         if sleep_s and i < len(tickers) - 1:\n109:             time.sleep(sleep_s)\n110:     return results\n111: \n112: \n113: def build_cache(ledger_path: Path, sleep_s: float = 0.0, yf_module=None,\n114:                 tickers: \"list | None\" = None) -> dict:\n115:     ts = tickers if tickers is not None else load_ledger_tickers(ledger_path)\n116:     fetched = fetch_all(ts, sleep_s=sleep_s, yf_module=yf_module)\n117:     ok = sum(1 for v in fetched.values() if v[\"fetch_state\"] == \"OK\")\n118:     return {\n119:         \"schema\": \"tr-ticker-yfinance-cache/v1\",\n120:         \"generated_at\": datetime.now(timezone.utc).isoformat(),\n121:         \"provider\": \"yfinance\",\n122:         \"provider_version\": _yfinance_version(yf_module),\n123:         \"source_ledger\": str(ledger_path),\n124:         \"query_overrides\": CRYPTO_QUERY_OVERRIDE,\n125:         \"asset_class_overrides\": CRYPTO_ASSET_CLASS_OVERRIDE,\n126:         \"override_rationale\": (\n127:             \"BTC/ETH plain symbols resolve on yfinance to Grayscale Mini Trust ETFs \"\n128:             \"(quoteType=ETF), not the cryptocurrency. tr_call_ledger.json's frozen \"\n129:             \"entry/exit prices for BTC/ETH match real spot crypto price magnitude \"\n130:             \"(verified against the market CSV it was built from), not the ETF's. \"\n131:             \"Queried as BTC-USD/ETH-USD instead; asset_class forced to CRYPTO.\"\n132:         ),\n133:         \"ticker_count\": len(ts),\n134:         \"fetch_ok_count\": ok,\n135:         \"fetch_unavailable_count\": len(ts) - ok,\n136:         \"tickers\": fetched,\n137:     }\n138: \n139: \n140: def _yfinance_version(yf_module) -> str:\n141:     try:\n142:         if yf_module is None:\n143:             import yfinance as yf_module  # noqa: F811\n144:         return getattr(yf_module, \"__version__\", \"unknown\")\n145:     except Exception:\n146:         return \"unknown\"\n147: \n148: \n149: def main(argv=None) -> int:\n150:     ap = argparse.ArgumentParser(description=__doc__)\n151:     ap.add_argument(\"--ledger\", default=\"research/tr_call_ledger.json\")\n152:     ap.add_argument(\"--out\", default=\"research/tr_ticker_yfinance_cache.json\")\n153:     ap.add_argument(\"--sleep\", type=float, default=0.0,\n154:                      help=\"courtesy delay in seconds between requests\")\n155:     args = ap.parse_args(argv)\n156: \n157:     ledger_path = Path(args.ledger)\n158:     cache = build_cache(ledger_path, sleep_s=args.sleep)\n159:     out_path = Path(args.out)\n160:     out_path.write_text(json.dumps(cache, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n161:     print(f\"fetched {cache['ticker_count']} tickers: \"\n162:           f\"{cache['fetch_ok_count']} OK, {cache['fetch_unavailable_count']} PROVIDER_UNAVAILABLE \"\n163:           f\"-> {out_path}\")\n164:     return 0\n165: \n166: \n167: if __name__ == \"__main__\":\n168:     sys.exit(main())\n\n(End of file - total 168 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"tr_ticker_enrich_fetch.py — real yfinance fetch for every ticker in the TR call\nledger, written to a typed raw cache consumed by build_tr_ticker_table.py.\n\nKept separate from the aggregation script so the pytest suite can run against a\nsynthetic cache fixture with zero network dependency, while this script performs\nthe one real fetch that produces the delivered artifact.\n\nTyped states, never invented values:\n  PROVIDER_UNAVAILABLE — the fetch raised, or returned no quoteType and no price\n                          field at all (ticker not found / rate limited).\n  OK                    — the fetch itself succeeded; individual missing fields\n                          are typed FIELD_NOT_PROVIDED downstream, not here.\n\nUsage:\n    python3 scripts/tr_ticker_enrich_fetch.py \\\n        --ledger research/tr_call_ledger.json \\\n        --out research/tr_ticker_yfinance_cache.json\n\"\"\"\nfrom __future__ import annotations","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/scripts/tr_ticker_enrich_fetch.py","text":"#!/usr/bin/env python3\n\"\"\"tr_ticker_enrich_fetch.py — real yfinance fetch for every ticker in the TR call\nledger, written to a typed raw cache consumed by build_tr_ticker_table.py.\n\nKept separate from the aggregation script so the pytest suite can run against a\nsynthetic cache fixture with zero network dependency, while this script performs\nthe one real fetch that produces the delivered artifact.\n\nTyped states, never invented values:\n  PROVIDER_UNAVAILABLE — the fetch raised, or returned no quoteType and no price\n                          field at all (ticker not found / rate limited).\n  OK                    — the fetch itself succeeded; individual missing fields\n                          are typed FIELD_NOT_PROVIDED downstream, not here.\n\nUsage:\n    python3 scripts/tr_ticker_enrich_fetch.py \\\n        --ledger research/tr_call_ledger.json \\\n        --out research/tr_ticker_yfinance_cache.json\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\n# BTC/ETH on plain yfinance symbols resolve to Grayscale Mini Trust ETFs (quoteType\n# ETF, live price ~$34 / ~$23) -- NOT the cryptocurrency. tr_call_ledger.json's\n# frozen entry/exit prices for these tickers (e.g. BTC close=68078.5547 on\n# 2026-04-01, matching real BTC-USD spot magnitude) come from the market CSV that\n# priced them as the crypto asset. Verified live 2026-09-10: yf.Ticker(\"BTC-USD\")\n# ~= 78240, yf.Ticker(\"BTC\") (Grayscale ETF) ~= 34.59 -- a real symbol collision,\n# not an assumption. Override documented in the provenance output, never silent.\nCRYPTO_QUERY_OVERRIDE = {\"BTC\": \"BTC-USD\", \"ETH\": \"ETH-USD\"}\nCRYPTO_ASSET_CLASS_OVERRIDE = {\"BTC\": \"CRYPTO\", \"ETH\": \"CRYPTO\"}\n\nRAW_FIELDS = (\n    \"quoteType\", \"longName\", \"shortName\", \"longBusinessSummary\", \"sector\",\n    \"industry\", \"country\", \"fullTimeEmployees\", \"marketCap\", \"trailingPE\",\n    \"forwardPE\", \"priceToBook\", \"totalRevenue\", \"revenueGrowth\", \"totalCash\",\n    \"totalDebt\", \"profitMargins\", \"currentPrice\", \"regularMarketPrice\",\n    \"previousClose\", \"fiftyDayAverage\", \"twoHundredDayAverage\",\n    \"fiftyTwoWeekHigh\", \"fiftyTwoWeekLow\", \"averageVolume\",\n    \"averageDailyVolume10Day\", \"currency\", \"exchange\",\n)\n\n_PRICE_FIELDS = (\"currentPrice\", \"regularMarketPrice\", \"previousClose\")\n\n\ndef load_ledger_tickers(ledger_path: Path) -> list:\n    ledger = json.loads(ledger_path.read_text(encoding=\"utf-8\"))\n    return sorted({ep[\"ticker\"] for ep in ledger[\"episodes\"]})\n\n\ndef _fetch_one(ticker: str, yf_module) -> dict:\n    query_symbol = CRYPTO_QUERY_OVERRIDE.get(ticker, ticker)\n    asset_class_override = CRYPTO_ASSET_CLASS_OVERRIDE.get(ticker)\n    retrieved_at = datetime.now(timezone.utc).isoformat()\n    try:\n        info = yf_module.Ticker(query_symbol).info\n    except Exception as exc:  # network / rate-limit / provider errors — typed, not raised\n        return {\n            \"query_symbol\": query_symbol,\n            \"asset_class_override\": asset_class_override,\n            \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n            \"provider_error\": f\"{type(exc).__name__}: {exc}\",\n            \"retrieved_at\": retrieved_at,\n            \"raw\": {},\n        }\n    if not isinstance(info, dict) or not info:\n        return {\n            \"query_symbol\": query_symbol,\n            \"asset_class_override\": asset_class_override,\n            \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n            \"provider_error\": \"empty response\",\n            \"retrieved_at\": retrieved_at,\n            \"raw\": {},\n        }\n    has_quote_type = bool(info.get(\"quoteType\"))\n    has_price = any(info.get(f) is not None for f in _PRICE_FIELDS)\n    if not has_quote_type and not has_price:\n        return {\n            \"query_symbol\": query_symbol,\n            \"asset_class_override\": asset_class_override,\n            \"fetch_state\": \"PROVIDER_UNAVAILABLE\",\n            \"provider_error\": \"no quoteType and no price field — ticker likely not found\",\n            \"retrieved_at\": retrieved_at,\n            \"raw\": {},\n        }\n    raw = {f: info.get(f) for f in RAW_FIELDS if info.get(f) is not None}\n    return {\n        \"query_symbol\": query_symbol,\n        \"asset_class_override\": asset_class_override,\n        \"fetch_state\": \"OK\",\n        \"retrieved_at\": retrieved_at,\n        \"raw\": raw,\n    }\n\n\ndef fetch_all(tickers: list, sleep_s: float = 0.0, yf_module=None) -> dict:\n    if yf_module is None:\n        import yfinance as yf_module  # deferred: keeps this importable without the dep in tests\n    results = {}\n    for i, ticker in enumerate(tickers):\n        results[ticker] = _fetch_one(ticker, yf_module)\n        if sleep_s and i < len(tickers) - 1:\n            time.sleep(sleep_s)\n    return results\n\n\ndef build_cache(ledger_path: Path, sleep_s: float = 0.0, yf_module=None,\n                tickers: \"list | None\" = None) -> dict:\n    ts = tickers if tickers is not None else load_ledger_tickers(ledger_path)\n    fetched = fetch_all(ts, sleep_s=sleep_s, yf_module=yf_module)\n    ok = sum(1 for v in fetched.values() if v[\"fetch_state\"] == \"OK\")\n    return {\n        \"schema\": \"tr-ticker-yfinance-cache/v1\",\n        \"generated_at\": datetime.now(timezone.utc).isoformat(),\n        \"provider\": \"yfinance\",\n        \"provider_version\": _yfinance_version(yf_module),\n        \"source_ledger\": str(ledger_path),\n        \"query_overrides\": CRYPTO_QUERY_OVERRIDE,\n        \"asset_class_overrides\": CRYPTO_ASSET_CLASS_OVERRIDE,\n        \"override_rationale\": (\n            \"BTC/ETH plain symbols resolve on yfinance to Grayscale Mini Trust ETFs \"\n            \"(quoteType=ETF), not the cryptocurrency. tr_call_ledger.json's frozen \"\n            \"entry/exit prices for BTC/ETH match real spot crypto price magnitude \"\n            \"(verified against the market CSV it was built from), not the ETF's. \"\n            \"Queried as BTC-USD/ETH-USD instead; asset_class forced to CRYPTO.\"\n        ),\n        \"ticker_count\": len(ts),\n        \"fetch_ok_count\": ok,\n        \"fetch_unavailable_count\": len(ts) - ok,\n        \"tickers\": fetched,\n    }\n\n\ndef _yfinance_version(yf_module) -> str:\n    try:\n        if yf_module is None:\n            import yfinance as yf_module  # noqa: F811\n        return getattr(yf_module, \"__version__\", \"unknown\")\n    except Exception:\n        return \"unknown\"\n\n\ndef main(argv=None) -> int:\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--ledger\", default=\"research/tr_call_ledger.json\")\n    ap.add_argument(\"--out\", default=\"research/tr_ticker_yfinance_cache.json\")\n    ap.add_argument(\"--sleep\", type=float, default=0.0,\n                     help=\"courtesy delay in seconds between requests\")\n    args = ap.parse_args(argv)\n\n    ledger_path = Path(args.ledger)\n    cache = build_cache(ledger_path, sleep_s=args.sleep)\n    out_path = Path(args.out)\n    out_path.write_text(json.dumps(cache, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    print(f\"fetched {cache['ticker_count']} tickers: \"\n          f\"{cache['fetch_ok_count']} OK, {cache['fetch_unavailable_count']} PROVIDER_UNAVAILABLE \"\n          f\"-> {out_path}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","lineStart":1,"lineEnd":168,"totalLines":168,"truncated":false}},"title":"scripts/tr_ticker_enrich_fetch.py","time":{"start":1790183079471,"end":1790183079480}},"id":"prt_0cf39fe2c001dq9J2WJe9NrSGw","sessionID":"ses_f30c77858ffeQU0a2T0vQ13xKn","messageID":"msg_0cf39e9a8001dq7J2W1lHDJ7lu"}}
