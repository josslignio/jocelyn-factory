{"type":"tool_use","timestamp":1790183060773,"sessionID":"ses_f30c77858ffeQU0a2T0vQ13xKn","part":{"type":"tool","tool":"read","callID":"call_b0fdec70381e4ad08b48f212","state":{"status":"completed","input":{"filePath":"/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/tests/test_tr_ticker_intelligence.py"},"output":"<path>/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/tests/test_tr_ticker_intelligence.py</path>\n<type>file</type>\n<content>\n1: \"\"\"tests/test_tr_ticker_intelligence.py — TR_TICKER_INTELLIGENCE_V1.\n2: \n3: Reproduces every ADVERSARIAL case from PLAN.md against synthetic fixtures (no network\n4: dependency), plus an integration pass against the real research/tr_call_ledger.json.\n5: \"\"\"\n6: import json\n7: import subprocess\n8: import sys\n9: from datetime import date\n10: from pathlib import Path\n11: \n12: import pytest\n13: \n14: sys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n15: \n16: from scripts.build_tr_ticker_table import (\n17:     ACTIVE_CALL_WINDOW_DAYS,\n18:     OPPORTUNITY_WEIGHTS,\n19:     build,\n20:     build_enrichment,\n21:     compute_independence,\n22:     compute_lifecycle,\n23:     compute_risk,\n24:     episode_id,\n25:     size_bucket,\n26: )\n27: from scripts.tr_ticker_enrich_fetch import (\n28:     CRYPTO_ASSET_CLASS_OVERRIDE,\n29:     CRYPTO_QUERY_OVERRIDE,\n30:     build_cache,\n31:     fetch_all,\n32: )\n33: \n34: REPO_ROOT = Path(__file__).resolve().parents[1]\n35: \n36: \n37: # ── fixture builders ─────────────────────────────────────────────────────────\n38: \n39: def ep(account, ticker, tweet_date, opening_tweet_id, closure_state=\"OPEN_AT_WINDOW_END\",\n40:       thesis=\"LONG_POSITION\", pushes=0):\n41:     return {\n42:         \"account\": account, \"ticker\": ticker, \"thesis\": thesis,\n43:         \"opening_tweet_id\": str(opening_tweet_id), \"tweet_date\": tweet_date,\n44:         \"pushes\": pushes, \"outcome\": \"OK\",\n45:         \"closure\": {\"state\": closure_state},\n46:     }\n47: \n48: \n49: AS_OF = date(2026, 9, 9)  # matches max tweet_date of the real ledger\n50: \n51: \n52: # ── lifecycle ────────────────────────────────────────────────────────────────\n53: \n54: def test_lifecycle_single_closed_sold_stays_closed_not_old_call():\n55:     eps = [ep(\"A\", \"X\", \"2025-01-01\", 100, closure_state=\"CLOSED_SOLD\")]\n56:     lc = compute_lifecycle(eps, AS_OF)\n57:     assert lc[\"state\"] == \"CLOSED\"\n58:     assert lc[\"decided_by_episode_ids\"] == [episode_id(eps[0])]\n59: \n60: \n61: def test_lifecycle_latest_open_call_governs_over_older_closed():\n62:     old_closed = ep(\"A\", \"X\", \"2026-06-01\", 100, closure_state=\"CLOSED_SOLD\")\n63:     fresh_open = ep(\"B\", \"X\", \"2026-09-08\", 200, closure_state=\"OPEN_AT_WINDOW_END\")\n64:     lc = compute_lifecycle([old_closed, fresh_open], AS_OF)\n65:     assert lc[\"state\"] == \"NEW_CALL\"\n66:     assert lc[\"decided_by_episode_ids\"] == [episode_id(fresh_open)]\n67: \n68: \n69: def test_lifecycle_invalidated_wins_over_same_day_open():\n70:     invalidated = ep(\"A\", \"X\", \"2026-09-01\", 100, closure_state=\"INVALIDATED\")\n71:     still_open = ep(\"B\", \"X\", \"2026-09-01\", 200, closure_state=\"OPEN_AT_WINDOW_END\")\n72:     lc = compute_lifecycle([invalidated, still_open], AS_OF)\n73:     assert lc[\"state\"] == \"INVALIDATED\"\n74:     assert lc[\"decided_by_episode_ids\"] == [episode_id(invalidated)]\n75: \n76: \n77: def test_lifecycle_active_call_window_boundary():\n78:     boundary_date = \"2026-03-19\"  # exactly ACTIVE_CALL_WINDOW_DAYS before AS_OF\n79:     assert (AS_OF - date(2026, 3, 19)).days == ACTIVE_CALL_WINDOW_DAYS\n80:     at_boundary = ep(\"A\", \"X\", boundary_date, 100)\n81:     lc = compute_lifecycle([at_boundary], AS_OF)\n82:     assert lc[\"state\"] == \"ACTIVE_CALL\"\n83: \n84:     just_over = ep(\"A\", \"X\", \"2026-03-18\", 100)\n85:     lc2 = compute_lifecycle([just_over], AS_OF)\n86:     assert lc2[\"state\"] == \"OLD_CALL\"\n87: \n88: \n89: def test_lifecycle_new_call_within_seven_days():\n90:     lc = compute_lifecycle([ep(\"A\", \"X\", \"2026-09-05\", 100)], AS_OF)\n91:     assert lc[\"state\"] == \"NEW_CALL\"\n92: \n93: \n94: # ── independence ─────────────────────────────────────────────────────────────\n95: \n96: def test_ten_pushes_from_one_account_is_one_kol_not_ten():\n97:     eps = [ep(\"A\", \"X\", \"2026-01-01\", 100, pushes=10)]\n98:     ind = compute_independence(eps)\n99:     assert ind[\"supporting_kol_count\"] == 1\n100:     assert ind[\"accounts\"][0][\"total_pushes\"] == 10\n101: \n102: \n103: def test_originator_is_earliest_tweet_date_others_are_followers():\n104:     first = ep(\"A\", \"X\", \"2026-01-01\", 100)\n105:     second = ep(\"B\", \"X\", \"2026-02-01\", 200)\n106:     third = ep(\"C\", \"X\", \"2026-03-01\", 300)\n107:     ind = compute_independence([first, second, third])\n108:     assert ind[\"supporting_kol_count\"] == 3\n109:     roles = {a[\"account\"]: a[\"role\"] for a in ind[\"accounts\"]}\n110:     assert roles == {\"A\": \"ORIGINATOR\", \"B\": \"FOLLOWER\", \"C\": \"FOLLOWER\"}\n111:     weights = {a[\"account\"]: a[\"weight\"] for a in ind[\"accounts\"]}\n112:     assert weights[\"A\"] == 1.0 and weights[\"B\"] == 0.5 and weights[\"C\"] == 0.5\n113: \n114: \n115: def test_originator_tiebreak_same_date_lowest_tweet_id_wins():\n116:     a = ep(\"A\", \"X\", \"2026-01-01\", 2000000000000000002)\n117:     b = ep(\"B\", \"X\", \"2026-01-01\", 2000000000000000001)\n118:     ind = compute_independence([a, b])\n119:     assert ind[\"originator_account\"] == \"B\"\n120: \n121: \n122: # ── enrichment / provider states ─────────────────────────────────────────────\n123: \n124: def test_provider_exception_yields_provider_unavailable_not_a_crash():\n125:     class RaisingTicker:\n126:         def __init__(self, symbol):\n127:             raise RuntimeError(\"simulated network failure\")\n128: \n129:     class FakeYF:\n130:         Ticker = RaisingTicker\n131: \n132:     results = fetch_all([\"ZZZZ\"], yf_module=FakeYF)\n133:     assert results[\"ZZZZ\"][\"fetch_state\"] == \"PROVIDER_UNAVAILABLE\"\n134:     assert \"simulated network failure\" in results[\"ZZZZ\"][\"provider_error\"]\n135: \n136: \n137: def test_provider_empty_response_yields_provider_unavailable():\n138:     class EmptyTicker:\n139:         def __init__(self, symbol):\n140:             self.info = {}\n141: \n142:     class FakeYF:\n143:         Ticker = EmptyTicker\n144: \n145:     results = fetch_all([\"ZZZZ\"], yf_module=FakeYF)\n146:     assert results[\"ZZZZ\"][\"fetch_state\"] == \"PROVIDER_UNAVAILABLE\"\n147: \n148: \n149: def test_provider_unavailable_degrades_every_field_never_a_zero():\n150:     fields, fetch_state, asset_class, quote_type = build_enrichment(\"ZZZZ\", None)\n151:     assert fetch_state == \"PROVIDER_UNAVAILABLE\"\n152:     for name, f in fields.items():\n153:         assert f[\"state\"] == \"PROVIDER_UNAVAILABLE\", name\n154:         assert f[\"value\"] is None, name\n155: \n156: \n157: def test_one_missing_field_degrades_only_that_field():\n158:     cache_entry = {\n159:         \"fetch_state\": \"OK\",\n160:         \"retrieved_at\": \"2026-09-09T00:00:00+00:00\",\n161:         \"asset_class_override\": None,\n162:         \"raw\": {\n163:             \"quoteType\": \"EQUITY\", \"longName\": \"Widget Corp\",\n164:             \"sector\": \"Technology\", \"industry\": \"Semiconductors\",\n165:             \"currentPrice\": 42.0,\n166:             # marketCap deliberately absent\n167:         },\n168:     }\n169:     fields, fetch_state, asset_class, quote_type = build_enrichment(\"WDGT\", cache_entry)\n170:     assert fetch_state == \"OK\"\n171:     assert fields[\"market_cap\"][\"state\"] == \"FIELD_NOT_PROVIDED\"\n172:     assert fields[\"market_cap\"][\"value\"] is None\n173:     assert fields[\"company_name\"][\"state\"] == \"OK\"\n174:     assert fields[\"company_name\"][\"value\"] == \"Widget Corp\"\n175: \n176: \n177: def test_missing_account_in_ranking_gets_documented_low_score_not_a_crash():\n178:     ledger = {\"episodes\": [ep(\"GhostKOL\", \"GHST\", \"2026-01-01\", 100)]}\n179:     table, _ = build(ledger, ranking=None, cache=None)\n180:     row = table[\"rows\"][0]\n181:     track = next(c for c in row[\"opportunity_score\"][\"components\"]\n182:                 if c[\"name\"] == \"kol_track_record\")\n183:     assert track[\"value\"] == 0.05\n184:     assert \"no KOL ranking evidence\" in track[\"note\"]\n185: \n186: \n187: # ── crypto override ───────────────────────────────────────────────────────────\n188: \n189: def test_btc_eth_query_override_and_asset_class_documented():\n190:     assert CRYPTO_QUERY_OVERRIDE == {\"BTC\": \"BTC-USD\", \"ETH\": \"ETH-USD\"}\n191:     assert CRYPTO_ASSET_CLASS_OVERRIDE == {\"BTC\": \"CRYPTO\", \"ETH\": \"CRYPTO\"}\n192: \n193:     class FakeInfo(dict):\n194:         pass\n195: \n196:     class FakeTicker:\n197:         def __init__(self, symbol):\n198:             self.requested_symbol = symbol\n199:             self.info = {\"quoteType\": \"CRYPTOCURRENCY\", \"currentPrice\": 70000.0}\n200: \n201:     class FakeYF:\n202:         Ticker = FakeTicker\n203: \n204:     results = fetch_all([\"BTC\"], yf_module=FakeYF)\n205:     assert results[\"BTC\"][\"query_symbol\"] == \"BTC-USD\"\n206:     assert results[\"BTC\"][\"asset_class_override\"] == \"CRYPTO\"\n207: \n208: \n209: # ── risk tier cascade ─────────────────────────────────────────────────────────\n210: \n211: def test_micro_or_unknown_size_is_always_speculative_even_with_many_kols():\n212:     enrichment, _, _, _ = build_enrichment(\"MICRO1\", {\n213:         \"fetch_state\": \"OK\", \"retrieved_at\": \"t\",\n214:         \"raw\": {\"quoteType\": \"EQUITY\", \"marketCap\": 50_000_000, \"currentPrice\": 1.0,\n215:                \"averageVolume\": 500000},\n216:     })\n217:     risk = compute_risk(enrichment, asset_class=\"EQUITY\", supporting_kol_count=5)\n218:     assert risk[\"tier\"] == \"SPECULATIVE\"\n219:     assert risk[\"inputs\"][\"size_bucket\"] == \"MICRO\"\n220: \n221: \n222: def test_size_bucket_thresholds():\n223:     assert size_bucket(300_000_000_000) == \"MEGA\"\n224:     assert size_bucket(50_000_000_000) == \"LARGE\"\n225:     assert size_bucket(5_000_000_000) == \"MID\"\n226:     assert size_bucket(500_000_000) == \"SMALL\"\n227:     assert size_bucket(1_000_000) == \"MICRO\"\n228:     assert size_bucket(None) is None\n229: \n230: \n231: def test_crypto_asset_class_is_always_speculative():\n232:     enrichment, _, _, _ = build_enrichment(\"BTC\", {\n233:         \"fetch_state\": \"OK\", \"retrieved_at\": \"t\", \"asset_class_override\": \"CRYPTO\",\n234:         \"raw\": {\"quoteType\": \"CRYPTOCURRENCY\", \"marketCap\": 1_500_000_000_000,\n235:                \"currentPrice\": 70000.0, \"averageVolume\": 1_000_000},\n236:     })\n237:     risk = compute_risk(enrichment, asset_class=\"CRYPTO\", supporting_kol_count=5)\n238:     assert risk[\"tier\"] == \"SPECULATIVE\"\n239: \n240: \n241: # ── opportunity score invariants ─────────────────────────────────────────────\n242: \n243: def test_opportunity_weights_sum_to_one():\n244:     assert abs(sum(OPPORTUNITY_WEIGHTS.values()) - 1.0) < 1e-9\n245: \n246: \n247: def test_opportunity_component_names_match_weights():\n248:     ledger = {\"episodes\": [ep(\"A\", \"X\", \"2026-09-01\", 100)]}\n249:     table, _ = build(ledger, ranking=None, cache=None)\n250:     row = table[\"rows\"][0]\n251:     names = {c[\"name\"] for c in row[\"opportunity_score\"][\"components\"]}\n252:     assert names == set(OPPORTUNITY_WEIGHTS)\n253:     total_from_components = round(\n254:         sum(c[\"contribution\"] for c in row[\"opportunity_score\"][\"components\"]), 4)\n255:     assert total_from_components == row[\"opportunity_score\"][\"total\"]\n256: \n257: \n258: # ── universe provenance (KOL-first, never screener-first) ───────────────────\n259: \n260: def test_universe_exactly_matches_ledger_tickers_no_more_no_less():\n261:     ledger = {\"episodes\": [\n262:         ep(\"A\", \"AAA\", \"2026-01-01\", 100),\n263:         ep(\"B\", \"BBB\", \"2026-01-01\", 101),\n264:         ep(\"A\", \"AAA\", \"2026-02-01\", 102),  # second episode, same ticker\n265:     ]}\n266:     table, provenance = build(ledger, ranking=None, cache=None)\n267:     assert {r[\"ticker\"] for r in table[\"rows\"]} == {\"AAA\", \"BBB\"}\n268:     assert set(provenance[\"tickers\"]) == {\"AAA\", \"BBB\"}\n269:     assert table[\"row_count\"] == 2\n270: \n271: \n272: def test_no_short_path_all_episode_thesis_values_are_long():\n273:     ledger = json.loads((REPO_ROOT / \"research\" / \"tr_call_ledger.json\").read_text())\n274:     thesis_values = {e[\"thesis\"] for e in ledger[\"episodes\"]}\n275:     assert thesis_values <= {\"LONG_POSITION\", \"LONG_SWING\"}\n276: \n277: \n278: def test_no_credentials_in_scripts_or_outputs():\n279:     import re\n280:     pattern = re.compile(r\"(auth_token|ct0|password|bearer\\s|api[_-]?key|cookie)\", re.I)\n281:     for relpath in (\"scripts/tr_ticker_enrich_fetch.py\", \"scripts/build_tr_ticker_table.py\"):\n282:         text = (REPO_ROOT / relpath).read_text()\n283:         assert not pattern.search(text), relpath\n284: \n285: \n286: # ── real-ledger integration ──────────────────────────────────────────────────\n287: \n288: @pytest.fixture(scope=\"module\")\n289: def real_ledger():\n290:     return json.loads((REPO_ROOT / \"research\" / \"tr_call_ledger.json\").read_text())\n291: \n292: \n293: @pytest.fixture(scope=\"module\")\n294: def real_ranking():\n295:     return json.loads((REPO_ROOT / \"research\" / \"tr_kol_ranking.json\").read_text())\n296: \n297: \n298: def test_real_ledger_full_build_universe_and_schema(real_ledger, real_ranking):\n299:     table, provenance = build(real_ledger, real_ranking, cache=None)\n300:     expected_tickers = {e[\"ticker\"] for e in real_ledger[\"episodes\"]}\n301:     assert {r[\"ticker\"] for r in table[\"rows\"]} == expected_tickers\n302:     assert table[\"row_count\"] == len(expected_tickers) == 727\n303:     assert table[\"schema\"] == \"tr-ticker-table/v1\"\n304:     assert provenance[\"schema\"] == \"tr-ticker-enrichment-provenance/v1\"\n305: \n306:     # every episode_id referenced in every row must exist in the real ledger\n307:     real_ids = {episode_id(e) for e in real_ledger[\"episodes\"]}\n308:     for row in table[\"rows\"]:\n309:         for eid in row[\"episodes\"][\"episode_ids\"]:\n310:             assert eid in real_ids\n311:         for eid in row[\"lifecycle\"][\"decided_by_episode_ids\"]:\n312:             assert eid in real_ids\n313: \n314:     # lifecycle vocabulary exactly matches the spec-mandated closed set\n315:     allowed = {\"NEW_CALL\", \"ACTIVE_CALL\", \"OLD_CALL\", \"CLOSED\", \"INVALIDATED\"}\n316:     assert {r[\"lifecycle\"][\"state\"] for r in table[\"rows\"]} <= allowed\n317: \n318:     # risk tier vocabulary exactly matches the spec-mandated closed set\n319:     allowed_risk = {\"LOW\", \"MODERATE\", \"HIGH\", \"SPECULATIVE\"}\n320:     assert {r[\"risk\"][\"tier\"] for r in table[\"rows\"]} <= allowed_risk\n321: \n322: \n323: def test_real_ledger_nvda_has_multiple_independent_kols(real_ledger, real_ranking):\n324:     table, _ = build(real_ledger, real_ranking, cache=None)\n325:     nvda = next(r for r in table[\"rows\"] if r[\"ticker\"] == \"NVDA\")\n326:     assert nvda[\"independence\"][\"supporting_kol_count\"] >= 2\n327:     accounts = {a[\"account\"] for a in nvda[\"independence\"][\"accounts\"]}\n328:     episode_accounts = {e[\"account\"] for e in real_ledger[\"episodes\"] if e[\"ticker\"] == \"NVDA\"}\n329:     assert accounts == episode_accounts\n330: \n331: \n332: def test_real_ledger_btc_classified_as_crypto_not_equity(real_ledger, real_ranking):\n333:     cache = {\"tickers\": {\"BTC\": {\n334:         \"fetch_state\": \"OK\", \"retrieved_at\": \"t\", \"asset_class_override\": \"CRYPTO\",\n335:         \"raw\": {\"quoteType\": \"CRYPTOCURRENCY\", \"currentPrice\": 70000.0,\n336:                \"marketCap\": 1_500_000_000_000, \"averageVolume\": 1_000_000},\n337:     }}}\n338:     table, _ = build(real_ledger, real_ranking, cache)\n339:     btc = next(r for r in table[\"rows\"] if r[\"ticker\"] == \"BTC\")\n340:     assert btc[\"asset_class\"] == \"CRYPTO\"\n341:     assert btc[\"risk\"][\"tier\"] == \"SPECULATIVE\"\n342: \n343: \n344: # ── CLI end-to-end (subprocess, real files, no fabricated success) ───────────\n345: \n346: def test_cli_writes_both_artifacts(tmp_path):\n347:     ledger_path = tmp_path / \"ledger.json\"\n348:     ledger_path.write_text(json.dumps({\n349:         \"episodes\": [ep(\"A\", \"ZZZ\", \"2026-09-01\", 100)],\n350:     }))\n351:     out_table = tmp_path / \"table.json\"\n352:     out_prov = tmp_path / \"prov.json\"\n353: \n354:     result = subprocess.run(\n355:         [sys.executable, \"scripts/build_tr_ticker_table.py\",\n356:          \"--ledger\", str(ledger_path), \"--ranking\", str(tmp_path / \"missing.json\"),\n357:          \"--cache\", str(tmp_path / \"missing_cache.json\"),\n358:          \"--out-table\", str(out_table), \"--out-provenance\", str(out_prov)],\n359:         cwd=REPO_ROOT, capture_output=True, text=True,\n360:     )\n361:     assert result.returncode == 0, result.stderr\n362:     assert out_table.is_file()\n363:     assert out_prov.is_file()\n364:     written = json.loads(out_table.read_text())\n365:     assert written[\"row_count\"] == 1\n366:     assert written[\"rows\"][0][\"ticker\"] == \"ZZZ\"\n\n(End of file - total 366 lines)\n</content>","metadata":{"preview":"\"\"\"tests/test_tr_ticker_intelligence.py — TR_TICKER_INTELLIGENCE_V1.\n\nReproduces every ADVERSARIAL case from PLAN.md against synthetic fixtures (no network\ndependency), plus an integration pass against the real research/tr_call_ledger.json.\n\"\"\"\nimport json\nimport subprocess\nimport sys\nfrom datetime import date\nfrom pathlib import Path\n\nimport pytest\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n\nfrom scripts.build_tr_ticker_table import (\n    ACTIVE_CALL_WINDOW_DAYS,\n    OPPORTUNITY_WEIGHTS,\n    build,\n    build_enrichment,","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/tests/test_tr_ticker_intelligence.py","text":"\"\"\"tests/test_tr_ticker_intelligence.py — TR_TICKER_INTELLIGENCE_V1.\n\nReproduces every ADVERSARIAL case from PLAN.md against synthetic fixtures (no network\ndependency), plus an integration pass against the real research/tr_call_ledger.json.\n\"\"\"\nimport json\nimport subprocess\nimport sys\nfrom datetime import date\nfrom pathlib import Path\n\nimport pytest\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n\nfrom scripts.build_tr_ticker_table import (\n    ACTIVE_CALL_WINDOW_DAYS,\n    OPPORTUNITY_WEIGHTS,\n    build,\n    build_enrichment,\n    compute_independence,\n    compute_lifecycle,\n    compute_risk,\n    episode_id,\n    size_bucket,\n)\nfrom scripts.tr_ticker_enrich_fetch import (\n    CRYPTO_ASSET_CLASS_OVERRIDE,\n    CRYPTO_QUERY_OVERRIDE,\n    build_cache,\n    fetch_all,\n)\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\n\n\n# ── fixture builders ─────────────────────────────────────────────────────────\n\ndef ep(account, ticker, tweet_date, opening_tweet_id, closure_state=\"OPEN_AT_WINDOW_END\",\n      thesis=\"LONG_POSITION\", pushes=0):\n    return {\n        \"account\": account, \"ticker\": ticker, \"thesis\": thesis,\n        \"opening_tweet_id\": str(opening_tweet_id), \"tweet_date\": tweet_date,\n        \"pushes\": pushes, \"outcome\": \"OK\",\n        \"closure\": {\"state\": closure_state},\n    }\n\n\nAS_OF = date(2026, 9, 9)  # matches max tweet_date of the real ledger\n\n\n# ── lifecycle ────────────────────────────────────────────────────────────────\n\ndef test_lifecycle_single_closed_sold_stays_closed_not_old_call():\n    eps = [ep(\"A\", \"X\", \"2025-01-01\", 100, closure_state=\"CLOSED_SOLD\")]\n    lc = compute_lifecycle(eps, AS_OF)\n    assert lc[\"state\"] == \"CLOSED\"\n    assert lc[\"decided_by_episode_ids\"] == [episode_id(eps[0])]\n\n\ndef test_lifecycle_latest_open_call_governs_over_older_closed():\n    old_closed = ep(\"A\", \"X\", \"2026-06-01\", 100, closure_state=\"CLOSED_SOLD\")\n    fresh_open = ep(\"B\", \"X\", \"2026-09-08\", 200, closure_state=\"OPEN_AT_WINDOW_END\")\n    lc = compute_lifecycle([old_closed, fresh_open], AS_OF)\n    assert lc[\"state\"] == \"NEW_CALL\"\n    assert lc[\"decided_by_episode_ids\"] == [episode_id(fresh_open)]\n\n\ndef test_lifecycle_invalidated_wins_over_same_day_open():\n    invalidated = ep(\"A\", \"X\", \"2026-09-01\", 100, closure_state=\"INVALIDATED\")\n    still_open = ep(\"B\", \"X\", \"2026-09-01\", 200, closure_state=\"OPEN_AT_WINDOW_END\")\n    lc = compute_lifecycle([invalidated, still_open], AS_OF)\n    assert lc[\"state\"] == \"INVALIDATED\"\n    assert lc[\"decided_by_episode_ids\"] == [episode_id(invalidated)]\n\n\ndef test_lifecycle_active_call_window_boundary():\n    boundary_date = \"2026-03-19\"  # exactly ACTIVE_CALL_WINDOW_DAYS before AS_OF\n    assert (AS_OF - date(2026, 3, 19)).days == ACTIVE_CALL_WINDOW_DAYS\n    at_boundary = ep(\"A\", \"X\", boundary_date, 100)\n    lc = compute_lifecycle([at_boundary], AS_OF)\n    assert lc[\"state\"] == \"ACTIVE_CALL\"\n\n    just_over = ep(\"A\", \"X\", \"2026-03-18\", 100)\n    lc2 = compute_lifecycle([just_over], AS_OF)\n    assert lc2[\"state\"] == \"OLD_CALL\"\n\n\ndef test_lifecycle_new_call_within_seven_days():\n    lc = compute_lifecycle([ep(\"A\", \"X\", \"2026-09-05\", 100)], AS_OF)\n    assert lc[\"state\"] == \"NEW_CALL\"\n\n\n# ── independence ─────────────────────────────────────────────────────────────\n\ndef test_ten_pushes_from_one_account_is_one_kol_not_ten():\n    eps = [ep(\"A\", \"X\", \"2026-01-01\", 100, pushes=10)]\n    ind = compute_independence(eps)\n    assert ind[\"supporting_kol_count\"] == 1\n    assert ind[\"accounts\"][0][\"total_pushes\"] == 10\n\n\ndef test_originator_is_earliest_tweet_date_others_are_followers():\n    first = ep(\"A\", \"X\", \"2026-01-01\", 100)\n    second = ep(\"B\", \"X\", \"2026-02-01\", 200)\n    third = ep(\"C\", \"X\", \"2026-03-01\", 300)\n    ind = compute_independence([first, second, third])\n    assert ind[\"supporting_kol_count\"] == 3\n    roles = {a[\"account\"]: a[\"role\"] for a in ind[\"accounts\"]}\n    assert roles == {\"A\": \"ORIGINATOR\", \"B\": \"FOLLOWER\", \"C\": \"FOLLOWER\"}\n    weights = {a[\"account\"]: a[\"weight\"] for a in ind[\"accounts\"]}\n    assert weights[\"A\"] == 1.0 and weights[\"B\"] == 0.5 and weights[\"C\"] == 0.5\n\n\ndef test_originator_tiebreak_same_date_lowest_tweet_id_wins():\n    a = ep(\"A\", \"X\", \"2026-01-01\", 2000000000000000002)\n    b = ep(\"B\", \"X\", \"2026-01-01\", 2000000000000000001)\n    ind = compute_independence([a, b])\n    assert ind[\"originator_account\"] == \"B\"\n\n\n# ── enrichment / provider states ─────────────────────────────────────────────\n\ndef test_provider_exception_yields_provider_unavailable_not_a_crash():\n    class RaisingTicker:\n        def __init__(self, symbol):\n            raise RuntimeError(\"simulated network failure\")\n\n    class FakeYF:\n        Ticker = RaisingTicker\n\n    results = fetch_all([\"ZZZZ\"], yf_module=FakeYF)\n    assert results[\"ZZZZ\"][\"fetch_state\"] == \"PROVIDER_UNAVAILABLE\"\n    assert \"simulated network failure\" in results[\"ZZZZ\"][\"provider_error\"]\n\n\ndef test_provider_empty_response_yields_provider_unavailable():\n    class EmptyTicker:\n        def __init__(self, symbol):\n            self.info = {}\n\n    class FakeYF:\n        Ticker = EmptyTicker\n\n    results = fetch_all([\"ZZZZ\"], yf_module=FakeYF)\n    assert results[\"ZZZZ\"][\"fetch_state\"] == \"PROVIDER_UNAVAILABLE\"\n\n\ndef test_provider_unavailable_degrades_every_field_never_a_zero():\n    fields, fetch_state, asset_class, quote_type = build_enrichment(\"ZZZZ\", None)\n    assert fetch_state == \"PROVIDER_UNAVAILABLE\"\n    for name, f in fields.items():\n        assert f[\"state\"] == \"PROVIDER_UNAVAILABLE\", name\n        assert f[\"value\"] is None, name\n\n\ndef test_one_missing_field_degrades_only_that_field():\n    cache_entry = {\n        \"fetch_state\": \"OK\",\n        \"retrieved_at\": \"2026-09-09T00:00:00+00:00\",\n        \"asset_class_override\": None,\n        \"raw\": {\n            \"quoteType\": \"EQUITY\", \"longName\": \"Widget Corp\",\n            \"sector\": \"Technology\", \"industry\": \"Semiconductors\",\n            \"currentPrice\": 42.0,\n            # marketCap deliberately absent\n        },\n    }\n    fields, fetch_state, asset_class, quote_type = build_enrichment(\"WDGT\", cache_entry)\n    assert fetch_state == \"OK\"\n    assert fields[\"market_cap\"][\"state\"] == \"FIELD_NOT_PROVIDED\"\n    assert fields[\"market_cap\"][\"value\"] is None\n    assert fields[\"company_name\"][\"state\"] == \"OK\"\n    assert fields[\"company_name\"][\"value\"] == \"Widget Corp\"\n\n\ndef test_missing_account_in_ranking_gets_documented_low_score_not_a_crash():\n    ledger = {\"episodes\": [ep(\"GhostKOL\", \"GHST\", \"2026-01-01\", 100)]}\n    table, _ = build(ledger, ranking=None, cache=None)\n    row = table[\"rows\"][0]\n    track = next(c for c in row[\"opportunity_score\"][\"components\"]\n                if c[\"name\"] == \"kol_track_record\")\n    assert track[\"value\"] == 0.05\n    assert \"no KOL ranking evidence\" in track[\"note\"]\n\n\n# ── crypto override ───────────────────────────────────────────────────────────\n\ndef test_btc_eth_query_override_and_asset_class_documented():\n    assert CRYPTO_QUERY_OVERRIDE == {\"BTC\": \"BTC-USD\", \"ETH\": \"ETH-USD\"}\n    assert CRYPTO_ASSET_CLASS_OVERRIDE == {\"BTC\": \"CRYPTO\", \"ETH\": \"CRYPTO\"}\n\n    class FakeInfo(dict):\n        pass\n\n    class FakeTicker:\n        def __init__(self, symbol):\n            self.requested_symbol = symbol\n            self.info = {\"quoteType\": \"CRYPTOCURRENCY\", \"currentPrice\": 70000.0}\n\n    class FakeYF:\n        Ticker = FakeTicker\n\n    results = fetch_all([\"BTC\"], yf_module=FakeYF)\n    assert results[\"BTC\"][\"query_symbol\"] == \"BTC-USD\"\n    assert results[\"BTC\"][\"asset_class_override\"] == \"CRYPTO\"\n\n\n# ── risk tier cascade ─────────────────────────────────────────────────────────\n\ndef test_micro_or_unknown_size_is_always_speculative_even_with_many_kols():\n    enrichment, _, _, _ = build_enrichment(\"MICRO1\", {\n        \"fetch_state\": \"OK\", \"retrieved_at\": \"t\",\n        \"raw\": {\"quoteType\": \"EQUITY\", \"marketCap\": 50_000_000, \"currentPrice\": 1.0,\n               \"averageVolume\": 500000},\n    })\n    risk = compute_risk(enrichment, asset_class=\"EQUITY\", supporting_kol_count=5)\n    assert risk[\"tier\"] == \"SPECULATIVE\"\n    assert risk[\"inputs\"][\"size_bucket\"] == \"MICRO\"\n\n\ndef test_size_bucket_thresholds():\n    assert size_bucket(300_000_000_000) == \"MEGA\"\n    assert size_bucket(50_000_000_000) == \"LARGE\"\n    assert size_bucket(5_000_000_000) == \"MID\"\n    assert size_bucket(500_000_000) == \"SMALL\"\n    assert size_bucket(1_000_000) == \"MICRO\"\n    assert size_bucket(None) is None\n\n\ndef test_crypto_asset_class_is_always_speculative():\n    enrichment, _, _, _ = build_enrichment(\"BTC\", {\n        \"fetch_state\": \"OK\", \"retrieved_at\": \"t\", \"asset_class_override\": \"CRYPTO\",\n        \"raw\": {\"quoteType\": \"CRYPTOCURRENCY\", \"marketCap\": 1_500_000_000_000,\n               \"currentPrice\": 70000.0, \"averageVolume\": 1_000_000},\n    })\n    risk = compute_risk(enrichment, asset_class=\"CRYPTO\", supporting_kol_count=5)\n    assert risk[\"tier\"] == \"SPECULATIVE\"\n\n\n# ── opportunity score invariants ─────────────────────────────────────────────\n\ndef test_opportunity_weights_sum_to_one():\n    assert abs(sum(OPPORTUNITY_WEIGHTS.values()) - 1.0) < 1e-9\n\n\ndef test_opportunity_component_names_match_weights():\n    ledger = {\"episodes\": [ep(\"A\", \"X\", \"2026-09-01\", 100)]}\n    table, _ = build(ledger, ranking=None, cache=None)\n    row = table[\"rows\"][0]\n    names = {c[\"name\"] for c in row[\"opportunity_score\"][\"components\"]}\n    assert names == set(OPPORTUNITY_WEIGHTS)\n    total_from_components = round(\n        sum(c[\"contribution\"] for c in row[\"opportunity_score\"][\"components\"]), 4)\n    assert total_from_components == row[\"opportunity_score\"][\"total\"]\n\n\n# ── universe provenance (KOL-first, never screener-first) ───────────────────\n\ndef test_universe_exactly_matches_ledger_tickers_no_more_no_less():\n    ledger = {\"episodes\": [\n        ep(\"A\", \"AAA\", \"2026-01-01\", 100),\n        ep(\"B\", \"BBB\", \"2026-01-01\", 101),\n        ep(\"A\", \"AAA\", \"2026-02-01\", 102),  # second episode, same ticker\n    ]}\n    table, provenance = build(ledger, ranking=None, cache=None)\n    assert {r[\"ticker\"] for r in table[\"rows\"]} == {\"AAA\", \"BBB\"}\n    assert set(provenance[\"tickers\"]) == {\"AAA\", \"BBB\"}\n    assert table[\"row_count\"] == 2\n\n\ndef test_no_short_path_all_episode_thesis_values_are_long():\n    ledger = json.loads((REPO_ROOT / \"research\" / \"tr_call_ledger.json\").read_text())\n    thesis_values = {e[\"thesis\"] for e in ledger[\"episodes\"]}\n    assert thesis_values <= {\"LONG_POSITION\", \"LONG_SWING\"}\n\n\ndef test_no_credentials_in_scripts_or_outputs():\n    import re\n    pattern = re.compile(r\"(auth_token|ct0|password|bearer\\s|api[_-]?key|cookie)\", re.I)\n    for relpath in (\"scripts/tr_ticker_enrich_fetch.py\", \"scripts/build_tr_ticker_table.py\"):\n        text = (REPO_ROOT / relpath).read_text()\n        assert not pattern.search(text), relpath\n\n\n# ── real-ledger integration ──────────────────────────────────────────────────\n\n@pytest.fixture(scope=\"module\")\ndef real_ledger():\n    return json.loads((REPO_ROOT / \"research\" / \"tr_call_ledger.json\").read_text())\n\n\n@pytest.fixture(scope=\"module\")\ndef real_ranking():\n    return json.loads((REPO_ROOT / \"research\" / \"tr_kol_ranking.json\").read_text())\n\n\ndef test_real_ledger_full_build_universe_and_schema(real_ledger, real_ranking):\n    table, provenance = build(real_ledger, real_ranking, cache=None)\n    expected_tickers = {e[\"ticker\"] for e in real_ledger[\"episodes\"]}\n    assert {r[\"ticker\"] for r in table[\"rows\"]} == expected_tickers\n    assert table[\"row_count\"] == len(expected_tickers) == 727\n    assert table[\"schema\"] == \"tr-ticker-table/v1\"\n    assert provenance[\"schema\"] == \"tr-ticker-enrichment-provenance/v1\"\n\n    # every episode_id referenced in every row must exist in the real ledger\n    real_ids = {episode_id(e) for e in real_ledger[\"episodes\"]}\n    for row in table[\"rows\"]:\n        for eid in row[\"episodes\"][\"episode_ids\"]:\n            assert eid in real_ids\n        for eid in row[\"lifecycle\"][\"decided_by_episode_ids\"]:\n            assert eid in real_ids\n\n    # lifecycle vocabulary exactly matches the spec-mandated closed set\n    allowed = {\"NEW_CALL\", \"ACTIVE_CALL\", \"OLD_CALL\", \"CLOSED\", \"INVALIDATED\"}\n    assert {r[\"lifecycle\"][\"state\"] for r in table[\"rows\"]} <= allowed\n\n    # risk tier vocabulary exactly matches the spec-mandated closed set\n    allowed_risk = {\"LOW\", \"MODERATE\", \"HIGH\", \"SPECULATIVE\"}\n    assert {r[\"risk\"][\"tier\"] for r in table[\"rows\"]} <= allowed_risk\n\n\ndef test_real_ledger_nvda_has_multiple_independent_kols(real_ledger, real_ranking):\n    table, _ = build(real_ledger, real_ranking, cache=None)\n    nvda = next(r for r in table[\"rows\"] if r[\"ticker\"] == \"NVDA\")\n    assert nvda[\"independence\"][\"supporting_kol_count\"] >= 2\n    accounts = {a[\"account\"] for a in nvda[\"independence\"][\"accounts\"]}\n    episode_accounts = {e[\"account\"] for e in real_ledger[\"episodes\"] if e[\"ticker\"] == \"NVDA\"}\n    assert accounts == episode_accounts\n\n\ndef test_real_ledger_btc_classified_as_crypto_not_equity(real_ledger, real_ranking):\n    cache = {\"tickers\": {\"BTC\": {\n        \"fetch_state\": \"OK\", \"retrieved_at\": \"t\", \"asset_class_override\": \"CRYPTO\",\n        \"raw\": {\"quoteType\": \"CRYPTOCURRENCY\", \"currentPrice\": 70000.0,\n               \"marketCap\": 1_500_000_000_000, \"averageVolume\": 1_000_000},\n    }}}\n    table, _ = build(real_ledger, real_ranking, cache)\n    btc = next(r for r in table[\"rows\"] if r[\"ticker\"] == \"BTC\")\n    assert btc[\"asset_class\"] == \"CRYPTO\"\n    assert btc[\"risk\"][\"tier\"] == \"SPECULATIVE\"\n\n\n# ── CLI end-to-end (subprocess, real files, no fabricated success) ───────────\n\ndef test_cli_writes_both_artifacts(tmp_path):\n    ledger_path = tmp_path / \"ledger.json\"\n    ledger_path.write_text(json.dumps({\n        \"episodes\": [ep(\"A\", \"ZZZ\", \"2026-09-01\", 100)],\n    }))\n    out_table = tmp_path / \"table.json\"\n    out_prov = tmp_path / \"prov.json\"\n\n    result = subprocess.run(\n        [sys.executable, \"scripts/build_tr_ticker_table.py\",\n         \"--ledger\", str(ledger_path), \"--ranking\", str(tmp_path / \"missing.json\"),\n         \"--cache\", str(tmp_path / \"missing_cache.json\"),\n         \"--out-table\", str(out_table), \"--out-provenance\", str(out_prov)],\n        cwd=REPO_ROOT, capture_output=True, text=True,\n    )\n    assert result.returncode == 0, result.stderr\n    assert out_table.is_file()\n    assert out_prov.is_file()\n    written = json.loads(out_table.read_text())\n    assert written[\"row_count\"] == 1\n    assert written[\"rows\"][0][\"ticker\"] == \"ZZZ\"","lineStart":1,"lineEnd":366,"totalLines":366,"truncated":false}},"title":"tests/test_tr_ticker_intelligence.py","time":{"start":1790183060763,"end":1790183060770}},"id":"prt_0cf39b519001nYpy4TO6u4NhK4","sessionID":"ses_f30c77858ffeQU0a2T0vQ13xKn","messageID":"msg_0cf399f47001sTmaum2SoM70ca"}}
{"type":"tool_use","timestamp":1790183060834,"sessionID":"ses_f30c77858ffeQU0a2T0vQ13xKn","part":{"type":"tool","tool":"bash","callID":"call_f13919d3b4a7450e889c0dfe","state":{"status":"completed","input":{"command":"python3 -c \"\nimport json\nl = json.load(open('research/tr_call_ledger.json'))\neps = l['episodes']\nprint('episodes:', len(eps))\nprint('distinct tickers:', len({e[\\\"ticker\\\"] for e in eps}))\nfrom collections import Counter\nprint('schemas keys:', [k for k in l.keys()])\nprint(Counter(e.get('thesis') for e in eps))\nprint('date range:', min(e['tweet_date'] for e in eps), max(e['tweet_date'] for e in eps))\n\""},"output":"episodes: 2680\ndistinct tickers: 907\nschemas keys: ['schema', 'rules_frozen', 'market_csv', 'sector_map', 'episode_count', 'evaluable_count', 'push_count', 'short_or_other_posts_counted', 'outcome_counts', 'episodes']\nCounter({'LONG_POSITION': 2234, 'LONG_SWING': 446})\ndate range: 2023-02-22 2026-09-17\n","metadata":{"output":"episodes: 2680\ndistinct tickers: 907\nschemas keys: ['schema', 'rules_frozen', 'market_csv', 'sector_map', 'episode_count', 'evaluable_count', 'push_count', 'short_or_other_posts_counted', 'outcome_counts', 'episodes']\nCounter({'LONG_POSITION': 2234, 'LONG_SWING': 446})\ndate range: 2023-02-22 2026-09-17\n","exit":0,"truncated":false},"title":"python3 -c \"\nimport json\nl = json.load(open('research/tr_call_ledger.json'))\neps = l['episodes']\nprint('episodes:', len(eps))\nprint('distinct tickers:', len({e[\\\"ticker\\\"] for e in eps}))\nfrom collections import Counter\nprint('schemas keys:', [k for k in l.keys()])\nprint(Counter(e.get('thesis') for e in eps))\nprint('date range:', min(e['tweet_date'] for e in eps), max(e['tweet_date'] for e in eps))\n\"","time":{"start":1790183060821,"end":1790183060832}},"id":"prt_0cf39b50d001DAKwyz02GmTA6Q","sessionID":"ses_f30c77858ffeQU0a2T0vQ13xKn","messageID":"msg_0cf399f47001sTmaum2SoM70ca"}}
