{"type":"tool_use","timestamp":1790182998491,"sessionID":"ses_f30c77858ffeQU0a2T0vQ13xKn","part":{"type":"tool","tool":"read","callID":"call_2d6fe806d88247abafc15ffa","state":{"status":"completed","input":{"filePath":"/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/scripts/build_tr_ticker_table.py"},"output":"<path>/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/scripts/build_tr_ticker_table.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"build_tr_ticker_table.py — TR_TICKER_INTELLIGENCE_V1.\n3: \n4: Builds research/tr_ticker_table.json and research/tr_ticker_enrichment_provenance.json\n5: from research/tr_call_ledger.json — the ONLY admissible source of the ticker universe\n6: (SPEC.md, \"Universe provenance — KOL-first, never screener-first\"). Never seeds from an\n7: exchange list, index, screener or generic market feed. Read-only against the ledger: never\n8: touches entry_date/entry_price/horizons/closure (frozen, no re-selection after observing\n9: the future).\n10: \n11: See PLAN.md for the full rule derivation (lifecycle priority, independence weighting,\n12: taxonomy, risk cascade, opportunity-score weights) with the factual discovery behind each\n13: choice.\n14: \"\"\"\n15: from __future__ import annotations\n16: \n17: import argparse\n18: import json\n19: from collections import defaultdict\n20: from datetime import date, datetime, timezone\n21: from pathlib import Path\n22: \n23: SCHEMA_TABLE = \"tr-ticker-table/v1\"\n24: SCHEMA_PROVENANCE = \"tr-ticker-enrichment-provenance/v1\"\n25: \n26: OPEN_CLOSURE_STATES = {\"OPEN_AT_WINDOW_END\", \"NOT_EVALUABLE\", \"SAME_DAY_UNORDERED\"}\n27: NEW_CALL_WINDOW_DAYS = 7\n28: # 120 trading sessions (the longest frozen evaluation horizon in SPEC.md) * 365/252\n29: # calendar-to-trading-day ratio ~= 174 calendar days. Not an arbitrary business\n30: # threshold: tied to the already-frozen horizon set, so it can't silently drift.\n31: ACTIVE_CALL_WINDOW_DAYS = 174\n32: \n33: FOLLOWER_WEIGHT = 0.5\n34: ORIGINATOR_WEIGHT = 1.0\n35: \n36: SIZE_BUCKET_THRESHOLDS = (\n37:     (\"MEGA\", 200_000_000_000),\n38:     (\"LARGE\", 10_000_000_000),\n39:     (\"MID\", 2_000_000_000),\n40:     (\"SMALL\", 300_000_000),\n41: )\n42: \n43: TAXONOMY_RULES = [\n44:     (\"semiconductors_compute\",\n45:      [\"semiconductor\", \"chip\", \"foundry\", \"wafer\", \" gpu\", \" cpu\", \"asic\", \"fpga\",\n46:       \"integrated circuit\"]),\n47:     (\"cloud_datacenter_network\",\n48:      [\"data center\", \"datacenter\", \"cloud computing\", \"networking\", \"hyperscale\",\n49:       \"colocation\", \"internet service\"]),\n50:     (\"energy_cooling_infra\",\n51:      [\"cooling\", \"power generation\", \"electric utility\", \"nuclear\", \"battery storage\",\n52:       \"electrical grid\", \"liquid cooling\", \"hvac\", \"renewable\"]),\n53:     (\"enterprise_software\",\n54:      [\"enterprise software\", \"saas\", \"erp\", \" crm\", \"cybersecurity\", \"application software\",\n55:       \"infrastructure software\"]),\n56:     (\"consumer_software\",\n57:      [\"social media\", \"e-commerce\", \"internet content\", \"mobile application\",\n58:       \"consumer electronics\"]),\n59:     (\"robotics_automation\",\n60:      [\"robot\", \"automation\", \"industrial machinery\", \"drone\", \"unmanned\"]),\n61:     (\"defense_autonomy\",\n62:      [\"aerospace & defense\", \"aerospace and defense\", \"defense\", \"military\", \"satellite\",\n63:       \"space\", \"missile\"]),\n64:     (\"healthcare_biotech_ai\",\n65:      [\"biotechnology\", \"health care\", \"healthcare\", \"pharmaceutical\", \"medical device\",\n66:       \"diagnostics\"]),\n67:     (\"adjacent_supplier\",\n68:      [\"specialty chemicals\", \"mining\", \"metals\", \"materials\", \"industrial distribution\"]),\n69: ]\n70: \n71: VALUE_CHAIN_ROLE = {\n72:     \"semiconductors_compute\": \"upstream_compute_hardware\",\n73:     \"cloud_datacenter_network\": \"midstream_infrastructure\",\n74:     \"energy_cooling_infra\": \"midstream_infrastructure_power\",\n75:     \"enterprise_software\": \"downstream_application_layer\",\n76:     \"consumer_software\": \"downstream_application_layer\",\n77:     \"robotics_automation\": \"downstream_application_layer_physical\",\n78:     \"defense_autonomy\": \"downstream_application_layer_defense\",\n79:     \"healthcare_biotech_ai\": \"downstream_application_layer_healthcare\",\n80:     \"adjacent_supplier\": \"upstream_adjacent_materials\",\n81:     \"crypto_digital_asset\": \"not_applicable_non_equity_asset\",\n82:     \"broad_market_etf_index\": \"not_applicable_broad_market_vehicle\",\n83:     \"UNCLASSIFIED\": \"UNCLASSIFIED\",\n84: }\n85: \n86: OPPORTUNITY_WEIGHTS = {\n87:     \"kol_independence\": 0.30,\n88:     \"kol_track_record\": 0.25,\n89:     \"conviction_recency\": 0.20,\n90:     \"momentum_not_overextended\": 0.15,\n91:     \"data_quality\": 0.10,\n92: }\n93: assert abs(sum(OPPORTUNITY_WEIGHTS.values()) - 1.0) < 1e-9\n94: \n95: ENRICHMENT_FIELD_NAMES = (\n96:     \"company_name\", \"description\", \"ai_subindustry\", \"market_country\", \"market_cap\",\n97:     \"trailing_pe\", \"forward_pe\", \"price_to_book\", \"revenue\", \"revenue_growth\", \"cash\",\n98:     \"debt\", \"profitability\", \"current_price\", \"momentum_state\", \"average_volume\",\n99: )\n100: \n101: \n102: # ── helpers ──────────────────────────────────────────────────────────────────\n103: \n104: def episode_id(ep: dict) -> str:\n105:     return f\"{ep['account']}::{ep['ticker']}::{ep['thesis']}::{ep['opening_tweet_id']}\"\n106: \n107: \n108: def _parse_date(s: str) -> date:\n109:     return datetime.strptime(s, \"%Y-%m-%d\").date()\n110: \n111: \n112: def load_json(path: \"Path | None\"):\n113:     if path is None:\n114:         return None\n115:     p = Path(path)\n116:     if not p.is_file():\n117:         return None\n118:     return json.loads(p.read_text(encoding=\"utf-8\"))\n119: \n120: \n121: def group_by_ticker(episodes: list) -> dict:\n122:     grouped = defaultdict(list)\n123:     for ep in episodes:\n124:         grouped[ep[\"ticker\"]].append(ep)\n125:     return grouped\n126: \n127: \n128: # ── lifecycle ────────────────────────────────────────────────────────────────\n129: \n130: def compute_lifecycle(ticker_episodes: list, as_of: date) -> dict:\n131:     latest_date_str = max(ep[\"tweet_date\"] for ep in ticker_episodes)\n132:     latest_group = [ep for ep in ticker_episodes if ep[\"tweet_date\"] == latest_date_str]\n133: \n134:     invalidated = [ep for ep in latest_group\n135:                    if ep.get(\"closure\", {}).get(\"state\") == \"INVALIDATED\"]\n136:     still_open = [ep for ep in latest_group\n137:                   if ep.get(\"closure\", {}).get(\"state\") in OPEN_CLOSURE_STATES]\n138:     closed = [ep for ep in latest_group\n139:               if ep.get(\"closure\", {}).get(\"state\") == \"CLOSED_SOLD\"]\n140: \n141:     latest_date = _parse_date(latest_date_str)\n142:     age_days = (as_of - latest_date).days\n143: \n144:     if invalidated:\n145:         state = \"INVALIDATED\"\n146:         decided_by = invalidated\n147:         rule = (\"latest-episode-priority: an episode at the ticker's most recent \"\n148:                 \"tweet_date has closure.state==INVALIDATED — invalidation is never \"\n149:                 \"masked by a concurrently open call from another account\")\n150:     elif still_open:\n151:         decided_by = still_open\n152:         if age_days <= NEW_CALL_WINDOW_DAYS:\n153:             state = \"NEW_CALL\"\n154:             rule = (f\"latest open episode age_days={age_days} <= \"\n155:                     f\"{NEW_CALL_WINDOW_DAYS} (fast-loop weekly detection window)\")\n156:         elif age_days <= ACTIVE_CALL_WINDOW_DAYS:\n157:             state = \"ACTIVE_CALL\"\n158:             rule = (f\"latest open episode age_days={age_days} <= \"\n159:                     f\"{ACTIVE_CALL_WINDOW_DAYS} (120-trading-session frozen \"\n160:                     \"evaluation horizon expressed in calendar days)\")\n161:         else:\n162:             state = \"OLD_CALL\"\n163:             rule = (f\"latest open episode age_days={age_days} > \"\n164:                     f\"{ACTIVE_CALL_WINDOW_DAYS}, still no explicit closure/invalidation\")\n165:     else:\n166:         # every episode at the latest date is CLOSED_SOLD\n167:         state = \"CLOSED\"\n168:         decided_by = closed\n169:         rule = (\"latest-episode-priority: every episode at the ticker's most recent \"\n170:                 \"tweet_date has closure.state==CLOSED_SOLD, none open, none invalidated\")\n171: \n172:     return {\n173:         \"state\": state,\n174:         \"rule\": rule,\n175:         \"as_of_date\": as_of.isoformat(),\n176:         \"latest_tweet_date\": latest_date_str,\n177:         \"age_days_vs_as_of\": age_days,\n178:         \"decided_by_episode_ids\": sorted(episode_id(ep) for ep in decided_by),\n179:         \"decided_by_opening_tweet_ids\": sorted({ep[\"opening_tweet_id\"] for ep in decided_by}),\n180:     }\n181: \n182: \n183: # ── independence ─────────────────────────────────────────────────────────────\n184: \n185: def compute_independence(ticker_episodes: list) -> dict:\n186:     by_account = defaultdict(list)\n187:     for ep in ticker_episodes:\n188:         by_account[ep[\"account\"]].append(ep)\n189: \n190:     def first_ep(eps):\n191:         return min(eps, key=lambda e: (e[\"tweet_date\"], int(e[\"opening_tweet_id\"])))\n192: \n193:     originator_account = min(\n194:         by_account, key=lambda acc: (first_ep(by_account[acc])[\"tweet_date\"],\n195:                                       int(first_ep(by_account[acc])[\"opening_tweet_id\"])))\n196: \n197:     accounts = []\n198:     for acc, eps in sorted(by_account.items()):\n199:         fe = first_ep(eps)\n200:         role = \"ORIGINATOR\" if acc == originator_account else \"FOLLOWER\"\n201:         weight = ORIGINATOR_WEIGHT if role == \"ORIGINATOR\" else FOLLOWER_WEIGHT\n202:         accounts.append({\n203:             \"account\": acc,\n204:             \"role\": role,\n205:             \"weight\": weight,\n206:             \"first_tweet_date\": fe[\"tweet_date\"],\n207:             \"episode_id\": episode_id(fe),\n208:             \"episode_count\": len(eps),\n209:             \"total_pushes\": sum(e.get(\"pushes\", 0) for e in eps),\n210:         })\n211: \n212:     return {\n213:         \"supporting_kol_count\": len(by_account),\n214:         \"originator_account\": originator_account,\n215:         \"accounts\": accounts,\n216:         \"rule\": (\"distinct accounts with >=1 qualified LONG episode on this ticker; \"\n217:                  \"10 pushes from one account is one account, never 10. Originator = \"\n218:                  \"account with the earliest tweet_date (tie-break: lowest \"\n219:                  \"opening_tweet_id) across all its episodes on this ticker; every \"\n220:                  f\"other contributing account is FOLLOWER (weight {FOLLOWER_WEIGHT} \"\n221:                  f\"vs ORIGINATOR weight {ORIGINATOR_WEIGHT} — independent conviction \"\n222:                  \"recorded, but never silently equal to origination)\"),\n223:     }\n224: \n225: \n226: # ── enrichment / taxonomy ────────────────────────────────────────────────────\n227: \n228: def classify_taxonomy(asset_class: str, quote_type: \"str | None\", sector: \"str | None\",\n229:                       industry: \"str | None\", summary: \"str | None\") -> tuple:\n230:     if asset_class == \"CRYPTO\":\n231:         return \"crypto_digital_asset\", \"asset_class_override=CRYPTO\"\n232:     if quote_type in (\"ETF\", \"INDEX\", \"MUTUALFUND\"):\n233:         return \"broad_market_etf_index\", f\"quoteType={quote_type}\"\n234:     haystack = \" \".join(x for x in (sector, industry, summary) if x).lower()\n235:     if not haystack:\n236:         return None, \"sector/industry/summary all unavailable — cannot classify\"\n237:     for category, keywords in TAXONOMY_RULES:\n238:         for kw in keywords:\n239:             if kw in haystack:\n240:                 return category, f\"matched keyword {kw!r} in sector/industry/summary\"\n241:     return \"UNCLASSIFIED\", \"no taxonomy keyword matched sector/industry/summary\"\n242: \n243: \n244: def size_bucket(market_cap: \"float | None\") -> \"str | None\":\n245:     if market_cap is None:\n246:         return None\n247:     for label, floor in SIZE_BUCKET_THRESHOLDS:\n248:         if market_cap >= floor:\n249:             return label\n250:     return \"MICRO\"\n251: \n252: \n253: def momentum_state(current_price, fifty_day, two_hundred_day, fifty_two_wk_high) -> \"str | None\":\n254:     if current_price is None:\n255:         return None\n256:     if fifty_two_wk_high and current_price >= 0.95 * fifty_two_wk_high \\\n257:             and fifty_day and two_hundred_day and current_price > fifty_day > two_hundred_day:\n258:         return \"EXTENDED_NEAR_52W_HIGH\"\n259:     if fifty_day is not None and two_hundred_day is not None:\n260:         if current_price > fifty_day > two_hundred_day:\n261:             return \"UPTREND\"\n262:         if current_price < fifty_day < two_hundred_day:\n263:             return \"DOWNTREND\"\n264:         return \"NEUTRAL\"\n265:     return \"INSUFFICIENT_DATA\"\n266: \n267: \n268: def _field(value, source, retrieved_at, degraded_state=\"FIELD_NOT_PROVIDED\"):\n269:     if value is None:\n270:         return {\"value\": None, \"state\": degraded_state, \"source\": source,\n271:                 \"retrieved_at\": retrieved_at}\n272:     return {\"value\": value, \"state\": \"OK\", \"source\": source, \"retrieved_at\": retrieved_at}\n273: \n274: \n275: def build_enrichment(ticker: str, cache_entry: \"dict | None\") -> dict:\n276:     \"\"\"Returns (enrichment_dict, fetch_state, asset_class, quote_type).\"\"\"\n277:     now = datetime.now(timezone.utc).isoformat()\n278:     if cache_entry is None:\n279:         retrieved_at = now\n280:         fields = {name: {\"value\": None, \"state\": \"PROVIDER_UNAVAILABLE\",\n281:                           \"source\": None, \"retrieved_at\": retrieved_at}\n282:                   for name in ENRICHMENT_FIELD_NAMES}\n283:         return fields, \"PROVIDER_UNAVAILABLE\", None, None\n284: \n285:     retrieved_at = cache_entry.get(\"retrieved_at\", now)\n286:     if cache_entry.get(\"fetch_state\") != \"OK\":\n287:         fields = {name: {\"value\": None, \"state\": \"PROVIDER_UNAVAILABLE\",\n288:                           \"source\": \"yfinance\", \"retrieved_at\": retrieved_at}\n289:                   for name in ENRICHMENT_FIELD_NAMES}\n290:         return fields, \"PROVIDER_UNAVAILABLE\", cache_entry.get(\"asset_class_override\"), None\n291: \n292:     raw = cache_entry.get(\"raw\", {})\n293:     asset_class = cache_entry.get(\"asset_class_override\") or raw.get(\"quoteType\")\n294:     quote_type = raw.get(\"quoteType\")\n295:     src = lambda f: f\"yfinance.info.{f}\"  # noqa: E731\n296: \n297:     company_name = raw.get(\"longName\") or raw.get(\"shortName\")\n298:     market_cap = raw.get(\"marketCap\")\n299:     current_price = raw.get(\"currentPrice\") or raw.get(\"regularMarketPrice\") \\\n300:         or raw.get(\"previousClose\")\n301: \n302:     category, taxonomy_note = classify_taxonomy(\n303:         asset_class, quote_type, raw.get(\"sector\"), raw.get(\"industry\"),\n304:         raw.get(\"longBusinessSummary\"))\n305: \n306:     fields = {\n307:         \"company_name\": _field(company_name, src(\"longName/shortName\"), retrieved_at),\n308:         \"description\": _field(raw.get(\"longBusinessSummary\"), src(\"longBusinessSummary\"),\n309:                               retrieved_at),\n310:         \"ai_subindustry\": {\n311:             \"value\": category,\n312:             \"state\": \"OK\" if category is not None else \"FIELD_NOT_PROVIDED\",\n313:             \"source\": \"derived:yfinance.sector+industry+summary keyword taxonomy v1\",\n314:             \"retrieved_at\": retrieved_at,\n315:             \"note\": taxonomy_note,\n316:         },\n317:         \"market_country\": _field(raw.get(\"country\"), src(\"country\"), retrieved_at),\n318:         \"market_cap\": _field(market_cap, src(\"marketCap\"), retrieved_at),\n319:         \"trailing_pe\": _field(raw.get(\"trailingPE\"), src(\"trailingPE\"), retrieved_at),\n320:         \"forward_pe\": _field(raw.get(\"forwardPE\"), src(\"forwardPE\"), retrieved_at),\n321:         \"price_to_book\": _field(raw.get(\"priceToBook\"), src(\"priceToBook\"), retrieved_at),\n322:         \"revenue\": _field(raw.get(\"totalRevenue\"), src(\"totalRevenue\"), retrieved_at),\n323:         \"revenue_growth\": _field(raw.get(\"revenueGrowth\"), src(\"revenueGrowth\"), retrieved_at),\n324:         \"cash\": _field(raw.get(\"totalCash\"), src(\"totalCash\"), retrieved_at),\n325:         \"debt\": _field(raw.get(\"totalDebt\"), src(\"totalDebt\"), retrieved_at),\n326:         \"profitability\": _field(raw.get(\"profitMargins\"), src(\"profitMargins\"), retrieved_at),\n327:         \"current_price\": _field(current_price, src(\"currentPrice/regularMarketPrice\"),\n328:                                 retrieved_at),\n329:         \"average_volume\": _field(raw.get(\"averageVolume\"), src(\"averageVolume\"), retrieved_at),\n330:     }\n331:     ms = momentum_state(current_price, raw.get(\"fiftyDayAverage\"),\n332:                         raw.get(\"twoHundredDayAverage\"), raw.get(\"fiftyTwoWeekHigh\"))\n333:     fields[\"momentum_state\"] = {\n334:         \"value\": ms,\n335:         \"state\": \"OK\" if ms is not None else \"FIELD_NOT_PROVIDED\",\n336:         \"source\": \"derived:yfinance.currentPrice vs fiftyDayAverage/twoHundredDayAverage/\"\n337:                   \"fiftyTwoWeekHigh\",\n338:         \"retrieved_at\": retrieved_at,\n339:     }\n340:     return fields, \"OK\", asset_class, quote_type\n341: \n342: \n343: # ── risk ─────────────────────────────────────────────────────────────────────\n344: \n345: def compute_risk(enrichment: dict, asset_class: \"str | None\", supporting_kol_count: int) -> dict:\n346:     ok_count = sum(1 for f in enrichment.values() if f[\"state\"] == \"OK\")\n347:     data_quality_fraction = round(ok_count / len(enrichment), 4)\n348:     mc = enrichment[\"market_cap\"]\n349:     bucket = size_bucket(mc[\"value\"]) if mc[\"state\"] == \"OK\" else \"UNKNOWN\"\n350:     avg_vol_degraded = enrichment[\"average_volume\"][\"state\"] != \"OK\"\n351: \n352:     inputs = {\n353:         \"size_bucket\": bucket,\n354:         \"asset_class\": asset_class,\n355:         \"data_quality_fraction\": data_quality_fraction,\n356:         \"average_volume_degraded\": avg_vol_degraded,\n357:         \"supporting_kol_count\": supporting_kol_count,\n358:     }\n359: \n360:     if asset_class == \"CRYPTO\" or bucket in (\"MICRO\", \"UNKNOWN\") or data_quality_fraction < 0.4:\n361:         tier = \"SPECULATIVE\"\n362:         rule = \"asset_class==CRYPTO or size_bucket in {MICRO,UNKNOWN} or data_quality<0.4\"\n363:     elif bucket == \"SMALL\" or supporting_kol_count == 1 or avg_vol_degraded:\n364:         tier = \"HIGH\"\n365:         rule = \"size_bucket==SMALL or supporting_kol_count==1 or average_volume degraded\"\n366:     elif bucket == \"MID\":\n367:         tier = \"MODERATE\"\n368:         rule = \"size_bucket==MID\"\n369:     elif bucket in (\"LARGE\", \"MEGA\") and data_quality_fraction >= 0.7 and supporting_kol_count >= 2:\n370:         tier = \"LOW\"\n371:         rule = \"size_bucket in {LARGE,MEGA} and data_quality>=0.7 and supporting_kol_count>=2\"\n372:     else:\n373:         tier = \"MODERATE\"\n374:         rule = \"fallback: does not clear the LOW bar but no HIGH/SPECULATIVE trigger fired\"\n375: \n376:     return {\"tier\": tier, \"rule\": rule, \"inputs\": inputs}\n377: \n378: \n379: # ── opportunity score ────────────────────────────────────────────────────────\n380: \n381: def _kol_tier_score(handle: str, ranking_by_handle: dict) -> tuple:\n382:     entry = ranking_by_handle.get(handle)\n383:     if entry is None:\n384:         return 0.05, \"no KOL ranking evidence for this account\"\n385:     tier = entry.get(\"tier\", {}).get(\"tier\")\n386:     confidence = entry.get(\"tier\", {}).get(\"confidence\", 0.0) or 0.0\n387:     if tier == \"ELITE\":\n388:         return 1.0, f\"{handle} tier=ELITE\"\n389:     if tier == \"SOLID\":\n390:         return 0.8, f\"{handle} tier=SOLID\"\n391:     if tier == \"EARLY_EVIDENCE\":\n392:         return round(0.5 * confidence, 4), f\"{handle} tier=EARLY_EVIDENCE confidence={confidence}\"\n393:     if tier == \"UNRANKED\":\n394:         return round(0.1 * confidence, 4), f\"{handle} tier=UNRANKED confidence={confidence}\"\n395:     return 0.05, f\"{handle} tier={tier!r} unrecognized\"\n396: \n397: \n398: _LIFECYCLE_RECENCY_SCORE = {\n399:     \"NEW_CALL\": 1.0, \"ACTIVE_CALL\": 0.7, \"OLD_CALL\": 0.3, \"CLOSED\": 0.0, \"INVALIDATED\": 0.0,\n400: }\n401: _MOMENTUM_SCORE = {\n402:     \"EXTENDED_NEAR_52W_HIGH\": 0.2, \"UPTREND\": 0.8, \"NEUTRAL\": 0.6, \"DOWNTREND\": 0.4,\n403: }\n404: \n405: \n406: def compute_opportunity(independence: dict, lifecycle: dict, enrichment: dict,\n407:                         ranking_by_handle: dict) -> dict:\n408:     kol_independence_val = round(min(independence[\"supporting_kol_count\"] / 5.0, 1.0), 4)\n409: \n410:     track_candidates = [_kol_tier_score(a[\"account\"], ranking_by_handle)\n411:                         for a in independence[\"accounts\"]]\n412:     kol_track_record_val, kol_track_record_note = max(track_candidates, key=lambda t: t[0])\n413: \n414:     conviction_val = _LIFECYCLE_RECENCY_SCORE.get(lifecycle[\"state\"], 0.0)\n415: \n416:     ms = enrichment[\"momentum_state\"][\"value\"]\n417:     momentum_val = _MOMENTUM_SCORE.get(ms, 0.5)\n418:     momentum_note = f\"momentum_state={ms!r}\" if ms is not None \\\n419:         else \"momentum_state unavailable — neutral fallback, flagged degraded\"\n420: \n421:     ok_count = sum(1 for f in enrichment.values() if f[\"state\"] == \"OK\")\n422:     data_quality_val = round(ok_count / len(enrichment), 4)\n423: \n424:     components = [\n425:         {\"name\": \"kol_independence\", \"value\": kol_independence_val,\n426:          \"weight\": OPPORTUNITY_WEIGHTS[\"kol_independence\"],\n427:          \"contribution\": round(kol_independence_val * OPPORTUNITY_WEIGHTS[\"kol_independence\"], 4),\n428:          \"note\": f\"{independence['supporting_kol_count']} distinct supporting account(s)\"},\n429:         {\"name\": \"kol_track_record\", \"value\": kol_track_record_val,\n430:          \"weight\": OPPORTUNITY_WEIGHTS[\"kol_track_record\"],\n431:          \"contribution\": round(kol_track_record_val * OPPORTUNITY_WEIGHTS[\"kol_track_record\"], 4),\n432:          \"note\": kol_track_record_note},\n433:         {\"name\": \"conviction_recency\", \"value\": conviction_val,\n434:          \"weight\": OPPORTUNITY_WEIGHTS[\"conviction_recency\"],\n435:          \"contribution\": round(conviction_val * OPPORTUNITY_WEIGHTS[\"conviction_recency\"], 4),\n436:          \"note\": f\"lifecycle={lifecycle['state']!r}\"},\n437:         {\"name\": \"momentum_not_overextended\", \"value\": momentum_val,\n438:          \"weight\": OPPORTUNITY_WEIGHTS[\"momentum_not_overextended\"],\n439:          \"contribution\": round(momentum_val * OPPORTUNITY_WEIGHTS[\"momentum_not_overextended\"], 4),\n440:          \"note\": momentum_note},\n441:         {\"name\": \"data_quality\", \"value\": data_quality_val,\n442:          \"weight\": OPPORTUNITY_WEIGHTS[\"data_quality\"],\n443:          \"contribution\": round(data_quality_val * OPPORTUNITY_WEIGHTS[\"data_quality\"], 4),\n444:          \"note\": f\"{ok_count}/{len(enrichment)} enrichment fields OK\"},\n445:     ]\n446:     total = round(sum(c[\"contribution\"] for c in components), 4)\n447: \n448:     reasons_for, reasons_against = [], []\n449:     for c in components:\n450:         if c[\"value\"] >= 0.6:\n451:             reasons_for.append(f\"{c['name']}: {c['note']} (score {c['value']})\")\n452:         elif c[\"value\"] <= 0.35:\n453:             reasons_against.append(f\"{c['name']}: {c['note']} (score {c['value']})\")\n454: \n455:     # A one-sided rationale is a recommendation, not research: when no component\n456:     # clears either threshold (all mid-range), the strongest and weakest components\n457:     # still stand in for FOR/AGAINST rather than leaving a side empty.\n458:     if not reasons_for:\n459:         best = max(components, key=lambda c: c[\"value\"])\n460:         reasons_for.append(\n461:             f\"{best['name']}: {best['note']} (score {best['value']}) — \"\n462:             \"highest-scoring factor, no component cleared the >=0.6 bar\")\n463:     if not reasons_against:\n464:         worst = min(components, key=lambda c: c[\"value\"])\n465:         reasons_against.append(\n466:             f\"{worst['name']}: {worst['note']} (score {worst['value']}) — \"\n467:             \"lowest-scoring factor, no component fell below the <=0.35 bar\")\n468: \n469:     return {\"total\": total, \"components\": components,\n470:             \"reasons_for\": reasons_for, \"reasons_against\": reasons_against}\n471: \n472: \n473: # ── verifier-contract view ───────────────────────────────────────────────────\n474: # factory_v2.product_verifiers.verify_tr_ticker (control repo) recomputes acceptance\n475: # from a flat, closed-vocabulary shape (top-level \"tickers\", per-row scalar lifecycle/\n476: # risk_tier, a typed \"fundamentals\" section keyed market_cap/size_bucket/country/\n477: # momentum_state/liquidity_warning with value/source/as_of/status). That shape is a\n478: # projection of the same data already computed in `row`, not a second source of truth.\n479: \n480: def _provenance_field(field: dict) -> dict:\n481:     return {\"value\": field[\"value\"], \"source\": field[\"source\"],\n482:             \"as_of\": field[\"retrieved_at\"], \"status\": field[\"state\"]}\n483: \n484: \n485: def build_fundamentals(row: dict) -> dict:\n486:     enrichment = row[\"enrichment\"]\n487:     mc = enrichment[\"market_cap\"]\n488:     bucket = row[\"risk\"][\"inputs\"][\"size_bucket\"]\n489:     return {\n490:         \"market_cap\": _provenance_field(mc),\n491:         \"size_bucket\": {\n492:             \"value\": bucket,\n493:             \"source\": \"derived:risk cascade size_bucket thresholds vs market_cap\",\n494:             \"as_of\": mc[\"retrieved_at\"],\n495:             \"status\": \"OK\" if bucket not in (None, \"UNKNOWN\") else \"FIELD_NOT_PROVIDED\",\n496:         },\n497:         \"country\": _provenance_field(enrichment[\"market_country\"]),\n498:         \"momentum_state\": _provenance_field(enrichment[\"momentum_state\"]),\n499:         \"liquidity_warning\": {\n500:             \"value\": row[\"warnings\"][\"liquidity\"],\n501:             \"source\": \"derived:average_volume provider state\",\n502:             \"as_of\": enrichment[\"average_volume\"][\"retrieved_at\"],\n503:             \"status\": \"OK\",\n504:         },\n505:     }\n506: \n507: \n508: def build_ticker_view(row: dict) -> dict:\n509:     return {\n510:         \"ticker\": row[\"ticker\"],\n511:         \"supporting_kol_count\": row[\"independence\"][\"supporting_kol_count\"],\n512:         \"lifecycle\": row[\"lifecycle\"][\"state\"],\n513:         \"lifecycle_rule\": row[\"lifecycle\"][\"rule\"],\n514:         \"lifecycle_source_episode_ids\": row[\"lifecycle\"][\"decided_by_opening_tweet_ids\"],\n515:         \"risk_tier\": row[\"risk\"][\"tier\"],\n516:         \"opportunity_score\": row[\"opportunity_score\"],\n517:         \"fundamentals\": build_fundamentals(row),\n518:     }\n519: \n520: \n521: # ── row assembly ─────────────────────────────────────────────────────────────\n522: \n523: def build_row(ticker: str, ticker_episodes: list, as_of: date, ranking_by_handle: dict,\n524:              cache_entry: \"dict | None\") -> tuple:\n525:     lifecycle = compute_lifecycle(ticker_episodes, as_of)\n526:     independence = compute_independence(ticker_episodes)\n527:     enrichment, fetch_state, asset_class, quote_type = build_enrichment(ticker, cache_entry)\n528:     risk = compute_risk(enrichment, asset_class, independence[\"supporting_kol_count\"])\n529:     opportunity = compute_opportunity(independence, lifecycle, enrichment, ranking_by_handle)\n530: \n531:     first_ep = min(ticker_episodes,\n532:                    key=lambda e: (e[\"tweet_date\"], int(e[\"opening_tweet_id\"])))\n533:     pushes_by_account = defaultdict(int)\n534:     for ep in ticker_episodes:\n535:         pushes_by_account[ep[\"account\"]] += ep.get(\"pushes\", 0)\n536: \n537:     liquidity_warnings = []\n538:     if enrichment[\"average_volume\"][\"state\"] != \"OK\":\n539:         liquidity_warnings.append(\"average trading volume unavailable from provider\")\n540:     dq_fields = [f for f, v in enrichment.items() if v[\"state\"] != \"OK\"]\n541:     data_quality_warnings = [f\"{f}: {enrichment[f]['state']}\" for f in dq_fields]\n542: \n543:     row = {\n544:         \"ticker\": ticker,\n545:         \"asset_class\": asset_class,\n546:         \"lifecycle\": lifecycle,\n547:         \"episodes\": {\n548:             \"count\": len(ticker_episodes),\n549:             \"episode_ids\": sorted(episode_id(e) for e in ticker_episodes),\n550:         },\n551:         \"first_call\": {\n552:             \"account\": first_ep[\"account\"],\n553:             \"tweet_date\": first_ep[\"tweet_date\"],\n554:             \"opening_tweet_id\": first_ep[\"opening_tweet_id\"],\n555:             \"thesis\": first_ep[\"thesis\"],\n556:             \"episode_id\": episode_id(first_ep),\n557:         },\n558:         \"independence\": independence,\n559:         \"conviction_evolution\": {\n560:             \"total_pushes\": sum(pushes_by_account.values()),\n561:             \"pushes_by_account\": dict(sorted(pushes_by_account.items())),\n562:         },\n563:         \"enrichment\": enrichment,\n564:         \"enrichment_fetch_state\": fetch_state,\n565:         \"value_chain_role\": VALUE_CHAIN_ROLE.get(enrichment[\"ai_subindustry\"][\"value\"]),\n566:         \"risk\": risk,\n567:         \"opportunity_score\": opportunity,\n568:         \"warnings\": {\n569:             \"liquidity\": liquidity_warnings,\n570:             \"data_quality\": data_quality_warnings,\n571:         },\n572:     }\n573:     provenance_entry = {\n574:         \"asset_class\": asset_class,\n575:         \"fetch_state\": fetch_state,\n576:         \"fields\": {name: {k: v for k, v in field.items() if k != \"value\"}\n577:                   for name, field in enrichment.items()},\n578:     }\n579:     return row, provenance_entry\n580: \n581: \n582: # ── top level ────────────────────────────────────────────────────────────────\n583: \n584: def build(ledger: dict, ranking: \"dict | None\", cache: \"dict | None\") -> tuple:\n585:     episodes = ledger[\"episodes\"]\n586:     grouped = group_by_ticker(episodes)\n587:     as_of = _parse_date(max(ep[\"tweet_date\"] for ep in episodes))\n588: \n589:     ranking_by_handle = {}\n590:     if ranking is not None:\n591:         for acc in ranking.get(\"accounts\", []):\n592:             ranking_by_handle[acc[\"handle\"]] = acc\n593: \n594:     cache_tickers = (cache or {}).get(\"tickers\", {})\n595: \n596:     rows, provenance = [], {}\n597:     for ticker in sorted(grouped):\n598:         row, prov_entry = build_row(ticker, grouped[ticker], as_of, ranking_by_handle,\n599:                                     cache_tickers.get(ticker))\n600:         rows.append(row)\n601:         provenance[ticker] = prov_entry\n602: \n603:     generated_at = datetime.now(timezone.utc).isoformat()\n604:     table = {\n605:         \"schema\": SCHEMA_TABLE,\n606:         \"generated_at\": generated_at,\n607:         \"source_ledger\": {\n608:             \"path\": \"research/tr_call_ledger.json\",\n609:             \"episode_count_total\": len(episodes),\n610:             \"distinct_tickers\": len(grouped),\n611:         },\n612:         \"as_of_date\": as_of.isoformat(),\n613:         \"lifecycle_rule\": {\n614:             \"new_call_window_days\": NEW_CALL_WINDOW_DAYS,\n615:             \"active_call_window_days\": ACTIVE_CALL_WINDOW_DAYS,\n616:             \"active_call_window_rationale\": (\n617:                 \"120 trading sessions (SPEC.md's longest frozen evaluation horizon) \"\n618:                 \"* 365/252 calendar-to-trading-day ratio ~= 174 calendar days\"),\n619:         },\n620:         \"opportunity_weights\": OPPORTUNITY_WEIGHTS,\n621:         \"row_count\": len(rows),\n622:         \"rows\": rows,\n623:         \"tickers\": [build_ticker_view(row) for row in rows],\n624:     }\n625:     provenance_doc = {\n626:         \"schema\": SCHEMA_PROVENANCE,\n627:         \"generated_at\": generated_at,\n628:         \"provider\": (cache or {}).get(\"provider\", \"yfinance\"),\n629:         \"provider_version\": (cache or {}).get(\"provider_version\"),\n630:         \"query_overrides\": (cache or {}).get(\"query_overrides\", {}),\n631:         \"override_rationale\": (cache or {}).get(\"override_rationale\"),\n632:         \"ticker_count\": len(provenance),\n633:         \"tickers\": provenance,\n634:     }\n635:     return table, provenance_doc\n636: \n637: \n638: def main(argv=None) -> int:\n639:     ap = argparse.ArgumentParser(description=__doc__)\n640:     ap.add_argument(\"--ledger\", default=\"research/tr_call_ledger.json\")\n641:     ap.add_argument(\"--ranking\", default=\"research/tr_kol_ranking.json\")\n642:     ap.add_argument(\"--cache\", default=\"research/tr_ticker_yfinance_cache.json\")\n643:     ap.add_argument(\"--out-table\", default=\"research/tr_ticker_table.json\")\n644:     ap.add_argument(\"--out-provenance\", default=\"research/tr_ticker_enrichment_provenance.json\")\n645:     args = ap.parse_args(argv)\n646: \n647:     ledger = load_json(args.ledger)\n648:     if ledger is None:\n649:         raise SystemExit(f\"required ledger not found: {args.ledger}\")\n650:     ranking = load_json(args.ranking)\n651:     cache = load_json(args.cache)\n652: \n653:     table, provenance = build(ledger, ranking, cache)\n654: \n655:     Path(args.out_table).write_text(json.dumps(table, indent=2, sort_keys=True) + \"\\n\",\n656:                                     encoding=\"utf-8\")\n657:     Path(args.out_provenance).write_text(\n658:         json.dumps(provenance, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n659:     print(f\"wrote {table['row_count']} ticker rows -> {args.out_table}\")\n660:     print(f\"wrote provenance for {provenance['ticker_count']} tickers -> {args.out_provenance}\")\n661:     return 0\n662: \n663: \n664: if __name__ == \"__main__\":\n665:     raise SystemExit(main())\n\n(End of file - total 665 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"build_tr_ticker_table.py — TR_TICKER_INTELLIGENCE_V1.\n\nBuilds research/tr_ticker_table.json and research/tr_ticker_enrichment_provenance.json\nfrom research/tr_call_ledger.json — the ONLY admissible source of the ticker universe\n(SPEC.md, \"Universe provenance — KOL-first, never screener-first\"). Never seeds from an\nexchange list, index, screener or generic market feed. Read-only against the ledger: never\ntouches entry_date/entry_price/horizons/closure (frozen, no re-selection after observing\nthe future).\n\nSee PLAN.md for the full rule derivation (lifecycle priority, independence weighting,\ntaxonomy, risk cascade, opportunity-score weights) with the factual discovery behind each\nchoice.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nfrom collections import defaultdict\nfrom datetime import date, datetime, timezone","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/var/folders/3n/cp7h29p55gzds1ttv9rkjdgw0000gn/T/v3-TR_TICKER_INTELLIGENCE_V1-ce7s755_/scripts/build_tr_ticker_table.py","text":"#!/usr/bin/env python3\n\"\"\"build_tr_ticker_table.py — TR_TICKER_INTELLIGENCE_V1.\n\nBuilds research/tr_ticker_table.json and research/tr_ticker_enrichment_provenance.json\nfrom research/tr_call_ledger.json — the ONLY admissible source of the ticker universe\n(SPEC.md, \"Universe provenance — KOL-first, never screener-first\"). Never seeds from an\nexchange list, index, screener or generic market feed. Read-only against the ledger: never\ntouches entry_date/entry_price/horizons/closure (frozen, no re-selection after observing\nthe future).\n\nSee PLAN.md for the full rule derivation (lifecycle priority, independence weighting,\ntaxonomy, risk cascade, opportunity-score weights) with the factual discovery behind each\nchoice.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nfrom collections import defaultdict\nfrom datetime import date, datetime, timezone\nfrom pathlib import Path\n\nSCHEMA_TABLE = \"tr-ticker-table/v1\"\nSCHEMA_PROVENANCE = \"tr-ticker-enrichment-provenance/v1\"\n\nOPEN_CLOSURE_STATES = {\"OPEN_AT_WINDOW_END\", \"NOT_EVALUABLE\", \"SAME_DAY_UNORDERED\"}\nNEW_CALL_WINDOW_DAYS = 7\n# 120 trading sessions (the longest frozen evaluation horizon in SPEC.md) * 365/252\n# calendar-to-trading-day ratio ~= 174 calendar days. Not an arbitrary business\n# threshold: tied to the already-frozen horizon set, so it can't silently drift.\nACTIVE_CALL_WINDOW_DAYS = 174\n\nFOLLOWER_WEIGHT = 0.5\nORIGINATOR_WEIGHT = 1.0\n\nSIZE_BUCKET_THRESHOLDS = (\n    (\"MEGA\", 200_000_000_000),\n    (\"LARGE\", 10_000_000_000),\n    (\"MID\", 2_000_000_000),\n    (\"SMALL\", 300_000_000),\n)\n\nTAXONOMY_RULES = [\n    (\"semiconductors_compute\",\n     [\"semiconductor\", \"chip\", \"foundry\", \"wafer\", \" gpu\", \" cpu\", \"asic\", \"fpga\",\n      \"integrated circuit\"]),\n    (\"cloud_datacenter_network\",\n     [\"data center\", \"datacenter\", \"cloud computing\", \"networking\", \"hyperscale\",\n      \"colocation\", \"internet service\"]),\n    (\"energy_cooling_infra\",\n     [\"cooling\", \"power generation\", \"electric utility\", \"nuclear\", \"battery storage\",\n      \"electrical grid\", \"liquid cooling\", \"hvac\", \"renewable\"]),\n    (\"enterprise_software\",\n     [\"enterprise software\", \"saas\", \"erp\", \" crm\", \"cybersecurity\", \"application software\",\n      \"infrastructure software\"]),\n    (\"consumer_software\",\n     [\"social media\", \"e-commerce\", \"internet content\", \"mobile application\",\n      \"consumer electronics\"]),\n    (\"robotics_automation\",\n     [\"robot\", \"automation\", \"industrial machinery\", \"drone\", \"unmanned\"]),\n    (\"defense_autonomy\",\n     [\"aerospace & defense\", \"aerospace and defense\", \"defense\", \"military\", \"satellite\",\n      \"space\", \"missile\"]),\n    (\"healthcare_biotech_ai\",\n     [\"biotechnology\", \"health care\", \"healthcare\", \"pharmaceutical\", \"medical device\",\n      \"diagnostics\"]),\n    (\"adjacent_supplier\",\n     [\"specialty chemicals\", \"mining\", \"metals\", \"materials\", \"industrial distribution\"]),\n]\n\nVALUE_CHAIN_ROLE = {\n    \"semiconductors_compute\": \"upstream_compute_hardware\",\n    \"cloud_datacenter_network\": \"midstream_infrastructure\",\n    \"energy_cooling_infra\": \"midstream_infrastructure_power\",\n    \"enterprise_software\": \"downstream_application_layer\",\n    \"consumer_software\": \"downstream_application_layer\",\n    \"robotics_automation\": \"downstream_application_layer_physical\",\n    \"defense_autonomy\": \"downstream_application_layer_defense\",\n    \"healthcare_biotech_ai\": \"downstream_application_layer_healthcare\",\n    \"adjacent_supplier\": \"upstream_adjacent_materials\",\n    \"crypto_digital_asset\": \"not_applicable_non_equity_asset\",\n    \"broad_market_etf_index\": \"not_applicable_broad_market_vehicle\",\n    \"UNCLASSIFIED\": \"UNCLASSIFIED\",\n}\n\nOPPORTUNITY_WEIGHTS = {\n    \"kol_independence\": 0.30,\n    \"kol_track_record\": 0.25,\n    \"conviction_recency\": 0.20,\n    \"momentum_not_overextended\": 0.15,\n    \"data_quality\": 0.10,\n}\nassert abs(sum(OPPORTUNITY_WEIGHTS.values()) - 1.0) < 1e-9\n\nENRICHMENT_FIELD_NAMES = (\n    \"company_name\", \"description\", \"ai_subindustry\", \"market_country\", \"market_cap\",\n    \"trailing_pe\", \"forward_pe\", \"price_to_book\", \"revenue\", \"revenue_growth\", \"cash\",\n    \"debt\", \"profitability\", \"current_price\", \"momentum_state\", \"average_volume\",\n)\n\n\n# ── helpers ──────────────────────────────────────────────────────────────────\n\ndef episode_id(ep: dict) -> str:\n    return f\"{ep['account']}::{ep['ticker']}::{ep['thesis']}::{ep['opening_tweet_id']}\"\n\n\ndef _parse_date(s: str) -> date:\n    return datetime.strptime(s, \"%Y-%m-%d\").date()\n\n\ndef load_json(path: \"Path | None\"):\n    if path is None:\n        return None\n    p = Path(path)\n    if not p.is_file():\n        return None\n    return json.loads(p.read_text(encoding=\"utf-8\"))\n\n\ndef group_by_ticker(episodes: list) -> dict:\n    grouped = defaultdict(list)\n    for ep in episodes:\n        grouped[ep[\"ticker\"]].append(ep)\n    return grouped\n\n\n# ── lifecycle ────────────────────────────────────────────────────────────────\n\ndef compute_lifecycle(ticker_episodes: list, as_of: date) -> dict:\n    latest_date_str = max(ep[\"tweet_date\"] for ep in ticker_episodes)\n    latest_group = [ep for ep in ticker_episodes if ep[\"tweet_date\"] == latest_date_str]\n\n    invalidated = [ep for ep in latest_group\n                   if ep.get(\"closure\", {}).get(\"state\") == \"INVALIDATED\"]\n    still_open = [ep for ep in latest_group\n                  if ep.get(\"closure\", {}).get(\"state\") in OPEN_CLOSURE_STATES]\n    closed = [ep for ep in latest_group\n              if ep.get(\"closure\", {}).get(\"state\") == \"CLOSED_SOLD\"]\n\n    latest_date = _parse_date(latest_date_str)\n    age_days = (as_of - latest_date).days\n\n    if invalidated:\n        state = \"INVALIDATED\"\n        decided_by = invalidated\n        rule = (\"latest-episode-priority: an episode at the ticker's most recent \"\n                \"tweet_date has closure.state==INVALIDATED — invalidation is never \"\n                \"masked by a concurrently open call from another account\")\n    elif still_open:\n        decided_by = still_open\n        if age_days <= NEW_CALL_WINDOW_DAYS:\n            state = \"NEW_CALL\"\n            rule = (f\"latest open episode age_days={age_days} <= \"\n                    f\"{NEW_CALL_WINDOW_DAYS} (fast-loop weekly detection window)\")\n        elif age_days <= ACTIVE_CALL_WINDOW_DAYS:\n            state = \"ACTIVE_CALL\"\n            rule = (f\"latest open episode age_days={age_days} <= \"\n                    f\"{ACTIVE_CALL_WINDOW_DAYS} (120-trading-session frozen \"\n                    \"evaluation horizon expressed in calendar days)\")\n        else:\n            state = \"OLD_CALL\"\n            rule = (f\"latest open episode age_days={age_days} > \"\n                    f\"{ACTIVE_CALL_WINDOW_DAYS}, still no explicit closure/invalidation\")\n    else:\n        # every episode at the latest date is CLOSED_SOLD\n        state = \"CLOSED\"\n        decided_by = closed\n        rule = (\"latest-episode-priority: every episode at the ticker's most recent \"\n                \"tweet_date has closure.state==CLOSED_SOLD, none open, none invalidated\")\n\n    return {\n        \"state\": state,\n        \"rule\": rule,\n        \"as_of_date\": as_of.isoformat(),\n        \"latest_tweet_date\": latest_date_str,\n        \"age_days_vs_as_of\": age_days,\n        \"decided_by_episode_ids\": sorted(episode_id(ep) for ep in decided_by),\n        \"decided_by_opening_tweet_ids\": sorted({ep[\"opening_tweet_id\"] for ep in decided_by}),\n    }\n\n\n# ── independence ─────────────────────────────────────────────────────────────\n\ndef compute_independence(ticker_episodes: list) -> dict:\n    by_account = defaultdict(list)\n    for ep in ticker_episodes:\n        by_account[ep[\"account\"]].append(ep)\n\n    def first_ep(eps):\n        return min(eps, key=lambda e: (e[\"tweet_date\"], int(e[\"opening_tweet_id\"])))\n\n    originator_account = min(\n        by_account, key=lambda acc: (first_ep(by_account[acc])[\"tweet_date\"],\n                                      int(first_ep(by_account[acc])[\"opening_tweet_id\"])))\n\n    accounts = []\n    for acc, eps in sorted(by_account.items()):\n        fe = first_ep(eps)\n        role = \"ORIGINATOR\" if acc == originator_account else \"FOLLOWER\"\n        weight = ORIGINATOR_WEIGHT if role == \"ORIGINATOR\" else FOLLOWER_WEIGHT\n        accounts.append({\n            \"account\": acc,\n            \"role\": role,\n            \"weight\": weight,\n            \"first_tweet_date\": fe[\"tweet_date\"],\n            \"episode_id\": episode_id(fe),\n            \"episode_count\": len(eps),\n            \"total_pushes\": sum(e.get(\"pushes\", 0) for e in eps),\n        })\n\n    return {\n        \"supporting_kol_count\": len(by_account),\n        \"originator_account\": originator_account,\n        \"accounts\": accounts,\n        \"rule\": (\"distinct accounts with >=1 qualified LONG episode on this ticker; \"\n                 \"10 pushes from one account is one account, never 10. Originator = \"\n                 \"account with the earliest tweet_date (tie-break: lowest \"\n                 \"opening_tweet_id) across all its episodes on this ticker; every \"\n                 f\"other contributing account is FOLLOWER (weight {FOLLOWER_WEIGHT} \"\n                 f\"vs ORIGINATOR weight {ORIGINATOR_WEIGHT} — independent conviction \"\n                 \"recorded, but never silently equal to origination)\"),\n    }\n\n\n# ── enrichment / taxonomy ────────────────────────────────────────────────────\n\ndef classify_taxonomy(asset_class: str, quote_type: \"str | None\", sector: \"str | None\",\n                      industry: \"str | None\", summary: \"str | None\") -> tuple:\n    if asset_class == \"CRYPTO\":\n        return \"crypto_digital_asset\", \"asset_class_override=CRYPTO\"\n    if quote_type in (\"ETF\", \"INDEX\", \"MUTUALFUND\"):\n        return \"broad_market_etf_index\", f\"quoteType={quote_type}\"\n    haystack = \" \".join(x for x in (sector, industry, summary) if x).lower()\n    if not haystack:\n        return None, \"sector/industry/summary all unavailable — cannot classify\"\n    for category, keywords in TAXONOMY_RULES:\n        for kw in keywords:\n            if kw in haystack:\n                return category, f\"matched keyword {kw!r} in sector/industry/summary\"\n    return \"UNCLASSIFIED\", \"no taxonomy keyword matched sector/industry/summary\"\n\n\ndef size_bucket(market_cap: \"float | None\") -> \"str | None\":\n    if market_cap is None:\n        return None\n    for label, floor in SIZE_BUCKET_THRESHOLDS:\n        if market_cap >= floor:\n            return label\n    return \"MICRO\"\n\n\ndef momentum_state(current_price, fifty_day, two_hundred_day, fifty_two_wk_high) -> \"str | None\":\n    if current_price is None:\n        return None\n    if fifty_two_wk_high and current_price >= 0.95 * fifty_two_wk_high \\\n            and fifty_day and two_hundred_day and current_price > fifty_day > two_hundred_day:\n        return \"EXTENDED_NEAR_52W_HIGH\"\n    if fifty_day is not None and two_hundred_day is not None:\n        if current_price > fifty_day > two_hundred_day:\n            return \"UPTREND\"\n        if current_price < fifty_day < two_hundred_day:\n            return \"DOWNTREND\"\n        return \"NEUTRAL\"\n    return \"INSUFFICIENT_DATA\"\n\n\ndef _field(value, source, retrieved_at, degraded_state=\"FIELD_NOT_PROVIDED\"):\n    if value is None:\n        return {\"value\": None, \"state\": degraded_state, \"source\": source,\n                \"retrieved_at\": retrieved_at}\n    return {\"value\": value, \"state\": \"OK\", \"source\": source, \"retrieved_at\": retrieved_at}\n\n\ndef build_enrichment(ticker: str, cache_entry: \"dict | None\") -> dict:\n    \"\"\"Returns (enrichment_dict, fetch_state, asset_class, quote_type).\"\"\"\n    now = datetime.now(timezone.utc).isoformat()\n    if cache_entry is None:\n        retrieved_at = now\n        fields = {name: {\"value\": None, \"state\": \"PROVIDER_UNAVAILABLE\",\n                          \"source\": None, \"retrieved_at\": retrieved_at}\n                  for name in ENRICHMENT_FIELD_NAMES}\n        return fields, \"PROVIDER_UNAVAILABLE\", None, None\n\n    retrieved_at = cache_entry.get(\"retrieved_at\", now)\n    if cache_entry.get(\"fetch_state\") != \"OK\":\n        fields = {name: {\"value\": None, \"state\": \"PROVIDER_UNAVAILABLE\",\n                          \"source\": \"yfinance\", \"retrieved_at\": retrieved_at}\n                  for name in ENRICHMENT_FIELD_NAMES}\n        return fields, \"PROVIDER_UNAVAILABLE\", cache_entry.get(\"asset_class_override\"), None\n\n    raw = cache_entry.get(\"raw\", {})\n    asset_class = cache_entry.get(\"asset_class_override\") or raw.get(\"quoteType\")\n    quote_type = raw.get(\"quoteType\")\n    src = lambda f: f\"yfinance.info.{f}\"  # noqa: E731\n\n    company_name = raw.get(\"longName\") or raw.get(\"shortName\")\n    market_cap = raw.get(\"marketCap\")\n    current_price = raw.get(\"currentPrice\") or raw.get(\"regularMarketPrice\") \\\n        or raw.get(\"previousClose\")\n\n    category, taxonomy_note = classify_taxonomy(\n        asset_class, quote_type, raw.get(\"sector\"), raw.get(\"industry\"),\n        raw.get(\"longBusinessSummary\"))\n\n    fields = {\n        \"company_name\": _field(company_name, src(\"longName/shortName\"), retrieved_at),\n        \"description\": _field(raw.get(\"longBusinessSummary\"), src(\"longBusinessSummary\"),\n                              retrieved_at),\n        \"ai_subindustry\": {\n            \"value\": category,\n            \"state\": \"OK\" if category is not None else \"FIELD_NOT_PROVIDED\",\n            \"source\": \"derived:yfinance.sector+industry+summary keyword taxonomy v1\",\n            \"retrieved_at\": retrieved_at,\n            \"note\": taxonomy_note,\n        },\n        \"market_country\": _field(raw.get(\"country\"), src(\"country\"), retrieved_at),\n        \"market_cap\": _field(market_cap, src(\"marketCap\"), retrieved_at),\n        \"trailing_pe\": _field(raw.get(\"trailingPE\"), src(\"trailingPE\"), retrieved_at),\n        \"forward_pe\": _field(raw.get(\"forwardPE\"), src(\"forwardPE\"), retrieved_at),\n        \"price_to_book\": _field(raw.get(\"priceToBook\"), src(\"priceToBook\"), retrieved_at),\n        \"revenue\": _field(raw.get(\"totalRevenue\"), src(\"totalRevenue\"), retrieved_at),\n        \"revenue_growth\": _field(raw.get(\"revenueGrowth\"), src(\"revenueGrowth\"), retrieved_at),\n        \"cash\": _field(raw.get(\"totalCash\"), src(\"totalCash\"), retrieved_at),\n        \"debt\": _field(raw.get(\"totalDebt\"), src(\"totalDebt\"), retrieved_at),\n        \"profitability\": _field(raw.get(\"profitMargins\"), src(\"profitMargins\"), retrieved_at),\n        \"current_price\": _field(current_price, src(\"currentPrice/regularMarketPrice\"),\n                                retrieved_at),\n        \"average_volume\": _field(raw.get(\"averageVolume\"), src(\"averageVolume\"), retrieved_at),\n    }\n    ms = momentum_state(current_price, raw.get(\"fiftyDayAverage\"),\n                        raw.get(\"twoHundredDayAverage\"), raw.get(\"fiftyTwoWeekHigh\"))\n    fields[\"momentum_state\"] = {\n        \"value\": ms,\n        \"state\": \"OK\" if ms is not None else \"FIELD_NOT_PROVIDED\",\n        \"source\": \"derived:yfinance.currentPrice vs fiftyDayAverage/twoHundredDayAverage/\"\n                  \"fiftyTwoWeekHigh\",\n        \"retrieved_at\": retrieved_at,\n    }\n    return fields, \"OK\", asset_class, quote_type\n\n\n# ── risk ─────────────────────────────────────────────────────────────────────\n\ndef compute_risk(enrichment: dict, asset_class: \"str | None\", supporting_kol_count: int) -> dict:\n    ok_count = sum(1 for f in enrichment.values() if f[\"state\"] == \"OK\")\n    data_quality_fraction = round(ok_count / len(enrichment), 4)\n    mc = enrichment[\"market_cap\"]\n    bucket = size_bucket(mc[\"value\"]) if mc[\"state\"] == \"OK\" else \"UNKNOWN\"\n    avg_vol_degraded = enrichment[\"average_volume\"][\"state\"] != \"OK\"\n\n    inputs = {\n        \"size_bucket\": bucket,\n        \"asset_class\": asset_class,\n        \"data_quality_fraction\": data_quality_fraction,\n        \"average_volume_degraded\": avg_vol_degraded,\n        \"supporting_kol_count\": supporting_kol_count,\n    }\n\n    if asset_class == \"CRYPTO\" or bucket in (\"MICRO\", \"UNKNOWN\") or data_quality_fraction < 0.4:\n        tier = \"SPECULATIVE\"\n        rule = \"asset_class==CRYPTO or size_bucket in {MICRO,UNKNOWN} or data_quality<0.4\"\n    elif bucket == \"SMALL\" or supporting_kol_count == 1 or avg_vol_degraded:\n        tier = \"HIGH\"\n        rule = \"size_bucket==SMALL or supporting_kol_count==1 or average_volume degraded\"\n    elif bucket == \"MID\":\n        tier = \"MODERATE\"\n        rule = \"size_bucket==MID\"\n    elif bucket in (\"LARGE\", \"MEGA\") and data_quality_fraction >= 0.7 and supporting_kol_count >= 2:\n        tier = \"LOW\"\n        rule = \"size_bucket in {LARGE,MEGA} and data_quality>=0.7 and supporting_kol_count>=2\"\n    else:\n        tier = \"MODERATE\"\n        rule = \"fallback: does not clear the LOW bar but no HIGH/SPECULATIVE trigger fired\"\n\n    return {\"tier\": tier, \"rule\": rule, \"inputs\": inputs}\n\n\n# ── opportunity score ────────────────────────────────────────────────────────\n\ndef _kol_tier_score(handle: str, ranking_by_handle: dict) -> tuple:\n    entry = ranking_by_handle.get(handle)\n    if entry is None:\n        return 0.05, \"no KOL ranking evidence for this account\"\n    tier = entry.get(\"tier\", {}).get(\"tier\")\n    confidence = entry.get(\"tier\", {}).get(\"confidence\", 0.0) or 0.0\n    if tier == \"ELITE\":\n        return 1.0, f\"{handle} tier=ELITE\"\n    if tier == \"SOLID\":\n        return 0.8, f\"{handle} tier=SOLID\"\n    if tier == \"EARLY_EVIDENCE\":\n        return round(0.5 * confidence, 4), f\"{handle} tier=EARLY_EVIDENCE confidence={confidence}\"\n    if tier == \"UNRANKED\":\n        return round(0.1 * confidence, 4), f\"{handle} tier=UNRANKED confidence={confidence}\"\n    return 0.05, f\"{handle} tier={tier!r} unrecognized\"\n\n\n_LIFECYCLE_RECENCY_SCORE = {\n    \"NEW_CALL\": 1.0, \"ACTIVE_CALL\": 0.7, \"OLD_CALL\": 0.3, \"CLOSED\": 0.0, \"INVALIDATED\": 0.0,\n}\n_MOMENTUM_SCORE = {\n    \"EXTENDED_NEAR_52W_HIGH\": 0.2, \"UPTREND\": 0.8, \"NEUTRAL\": 0.6, \"DOWNTREND\": 0.4,\n}\n\n\ndef compute_opportunity(independence: dict, lifecycle: dict, enrichment: dict,\n                        ranking_by_handle: dict) -> dict:\n    kol_independence_val = round(min(independence[\"supporting_kol_count\"] / 5.0, 1.0), 4)\n\n    track_candidates = [_kol_tier_score(a[\"account\"], ranking_by_handle)\n                        for a in independence[\"accounts\"]]\n    kol_track_record_val, kol_track_record_note = max(track_candidates, key=lambda t: t[0])\n\n    conviction_val = _LIFECYCLE_RECENCY_SCORE.get(lifecycle[\"state\"], 0.0)\n\n    ms = enrichment[\"momentum_state\"][\"value\"]\n    momentum_val = _MOMENTUM_SCORE.get(ms, 0.5)\n    momentum_note = f\"momentum_state={ms!r}\" if ms is not None \\\n        else \"momentum_state unavailable — neutral fallback, flagged degraded\"\n\n    ok_count = sum(1 for f in enrichment.values() if f[\"state\"] == \"OK\")\n    data_quality_val = round(ok_count / len(enrichment), 4)\n\n    components = [\n        {\"name\": \"kol_independence\", \"value\": kol_independence_val,\n         \"weight\": OPPORTUNITY_WEIGHTS[\"kol_independence\"],\n         \"contribution\": round(kol_independence_val * OPPORTUNITY_WEIGHTS[\"kol_independence\"], 4),\n         \"note\": f\"{independence['supporting_kol_count']} distinct supporting account(s)\"},\n        {\"name\": \"kol_track_record\", \"value\": kol_track_record_val,\n         \"weight\": OPPORTUNITY_WEIGHTS[\"kol_track_record\"],\n         \"contribution\": round(kol_track_record_val * OPPORTUNITY_WEIGHTS[\"kol_track_record\"], 4),\n         \"note\": kol_track_record_note},\n        {\"name\": \"conviction_recency\", \"value\": conviction_val,\n         \"weight\": OPPORTUNITY_WEIGHTS[\"conviction_recency\"],\n         \"contribution\": round(conviction_val * OPPORTUNITY_WEIGHTS[\"conviction_recency\"], 4),\n         \"note\": f\"lifecycle={lifecycle['state']!r}\"},\n        {\"name\": \"momentum_not_overextended\", \"value\": momentum_val,\n         \"weight\": OPPORTUNITY_WEIGHTS[\"momentum_not_overextended\"],\n         \"contribution\": round(momentum_val * OPPORTUNITY_WEIGHTS[\"momentum_not_overextended\"], 4),\n         \"note\": momentum_note},\n        {\"name\": \"data_quality\", \"value\": data_quality_val,\n         \"weight\": OPPORTUNITY_WEIGHTS[\"data_quality\"],\n         \"contribution\": round(data_quality_val * OPPORTUNITY_WEIGHTS[\"data_quality\"], 4),\n         \"note\": f\"{ok_count}/{len(enrichment)} enrichment fields OK\"},\n    ]\n    total = round(sum(c[\"contribution\"] for c in components), 4)\n\n    reasons_for, reasons_against = [], []\n    for c in components:\n        if c[\"value\"] >= 0.6:\n            reasons_for.append(f\"{c['name']}: {c['note']} (score {c['value']})\")\n        elif c[\"value\"] <= 0.35:\n            reasons_against.append(f\"{c['name']}: {c['note']} (score {c['value']})\")\n\n    # A one-sided rationale is a recommendation, not research: when no component\n    # clears either threshold (all mid-range), the strongest and weakest components\n    # still stand in for FOR/AGAINST rather than leaving a side empty.\n    if not reasons_for:\n        best = max(components, key=lambda c: c[\"value\"])\n        reasons_for.append(\n            f\"{best['name']}: {best['note']} (score {best['value']}) — \"\n            \"highest-scoring factor, no component cleared the >=0.6 bar\")\n    if not reasons_against:\n        worst = min(components, key=lambda c: c[\"value\"])\n        reasons_against.append(\n            f\"{worst['name']}: {worst['note']} (score {worst['value']}) — \"\n            \"lowest-scoring factor, no component fell below the <=0.35 bar\")\n\n    return {\"total\": total, \"components\": components,\n            \"reasons_for\": reasons_for, \"reasons_against\": reasons_against}\n\n\n# ── verifier-contract view ───────────────────────────────────────────────────\n# factory_v2.product_verifiers.verify_tr_ticker (control repo) recomputes acceptance\n# from a flat, closed-vocabulary shape (top-level \"tickers\", per-row scalar lifecycle/\n# risk_tier, a typed \"fundamentals\" section keyed market_cap/size_bucket/country/\n# momentum_state/liquidity_warning with value/source/as_of/status). That shape is a\n# projection of the same data already computed in `row`, not a second source of truth.\n\ndef _provenance_field(field: dict) -> dict:\n    return {\"value\": field[\"value\"], \"source\": field[\"source\"],\n            \"as_of\": field[\"retrieved_at\"], \"status\": field[\"state\"]}\n\n\ndef build_fundamentals(row: dict) -> dict:\n    enrichment = row[\"enrichment\"]\n    mc = enrichment[\"market_cap\"]\n    bucket = row[\"risk\"][\"inputs\"][\"size_bucket\"]\n    return {\n        \"market_cap\": _provenance_field(mc),\n        \"size_bucket\": {\n            \"value\": bucket,\n            \"source\": \"derived:risk cascade size_bucket thresholds vs market_cap\",\n            \"as_of\": mc[\"retrieved_at\"],\n            \"status\": \"OK\" if bucket not in (None, \"UNKNOWN\") else \"FIELD_NOT_PROVIDED\",\n        },\n        \"country\": _provenance_field(enrichment[\"market_country\"]),\n        \"momentum_state\": _provenance_field(enrichment[\"momentum_state\"]),\n        \"liquidity_warning\": {\n            \"value\": row[\"warnings\"][\"liquidity\"],\n            \"source\": \"derived:average_volume provider state\",\n            \"as_of\": enrichment[\"average_volume\"][\"retrieved_at\"],\n            \"status\": \"OK\",\n        },\n    }\n\n\ndef build_ticker_view(row: dict) -> dict:\n    return {\n        \"ticker\": row[\"ticker\"],\n        \"supporting_kol_count\": row[\"independence\"][\"supporting_kol_count\"],\n        \"lifecycle\": row[\"lifecycle\"][\"state\"],\n        \"lifecycle_rule\": row[\"lifecycle\"][\"rule\"],\n        \"lifecycle_source_episode_ids\": row[\"lifecycle\"][\"decided_by_opening_tweet_ids\"],\n        \"risk_tier\": row[\"risk\"][\"tier\"],\n        \"opportunity_score\": row[\"opportunity_score\"],\n        \"fundamentals\": build_fundamentals(row),\n    }\n\n\n# ── row assembly ─────────────────────────────────────────────────────────────\n\ndef build_row(ticker: str, ticker_episodes: list, as_of: date, ranking_by_handle: dict,\n             cache_entry: \"dict | None\") -> tuple:\n    lifecycle = compute_lifecycle(ticker_episodes, as_of)\n    independence = compute_independence(ticker_episodes)\n    enrichment, fetch_state, asset_class, quote_type = build_enrichment(ticker, cache_entry)\n    risk = compute_risk(enrichment, asset_class, independence[\"supporting_kol_count\"])\n    opportunity = compute_opportunity(independence, lifecycle, enrichment, ranking_by_handle)\n\n    first_ep = min(ticker_episodes,\n                   key=lambda e: (e[\"tweet_date\"], int(e[\"opening_tweet_id\"])))\n    pushes_by_account = defaultdict(int)\n    for ep in ticker_episodes:\n        pushes_by_account[ep[\"account\"]] += ep.get(\"pushes\", 0)\n\n    liquidity_warnings = []\n    if enrichment[\"average_volume\"][\"state\"] != \"OK\":\n        liquidity_warnings.append(\"average trading volume unavailable from provider\")\n    dq_fields = [f for f, v in enrichment.items() if v[\"state\"] != \"OK\"]\n    data_quality_warnings = [f\"{f}: {enrichment[f]['state']}\" for f in dq_fields]\n\n    row = {\n        \"ticker\": ticker,\n        \"asset_class\": asset_class,\n        \"lifecycle\": lifecycle,\n        \"episodes\": {\n            \"count\": len(ticker_episodes),\n            \"episode_ids\": sorted(episode_id(e) for e in ticker_episodes),\n        },\n        \"first_call\": {\n            \"account\": first_ep[\"account\"],\n            \"tweet_date\": first_ep[\"tweet_date\"],\n            \"opening_tweet_id\": first_ep[\"opening_tweet_id\"],\n            \"thesis\": first_ep[\"thesis\"],\n            \"episode_id\": episode_id(first_ep),\n        },\n        \"independence\": independence,\n        \"conviction_evolution\": {\n            \"total_pushes\": sum(pushes_by_account.values()),\n            \"pushes_by_account\": dict(sorted(pushes_by_account.items())),\n        },\n        \"enrichment\": enrichment,\n        \"enrichment_fetch_state\": fetch_state,\n        \"value_chain_role\": VALUE_CHAIN_ROLE.get(enrichment[\"ai_subindustry\"][\"value\"]),\n        \"risk\": risk,\n        \"opportunity_score\": opportunity,\n        \"warnings\": {\n            \"liquidity\": liquidity_warnings,\n            \"data_quality\": data_quality_warnings,\n        },\n    }\n    provenance_entry = {\n        \"asset_class\": asset_class,\n        \"fetch_state\": fetch_state,\n        \"fields\": {name: {k: v for k, v in field.items() if k != \"value\"}\n                  for name, field in enrichment.items()},\n    }\n    return row, provenance_entry\n\n\n# ── top level ────────────────────────────────────────────────────────────────\n\ndef build(ledger: dict, ranking: \"dict | None\", cache: \"dict | None\") -> tuple:\n    episodes = ledger[\"episodes\"]\n    grouped = group_by_ticker(episodes)\n    as_of = _parse_date(max(ep[\"tweet_date\"] for ep in episodes))\n\n    ranking_by_handle = {}\n    if ranking is not None:\n        for acc in ranking.get(\"accounts\", []):\n            ranking_by_handle[acc[\"handle\"]] = acc\n\n    cache_tickers = (cache or {}).get(\"tickers\", {})\n\n    rows, provenance = [], {}\n    for ticker in sorted(grouped):\n        row, prov_entry = build_row(ticker, grouped[ticker], as_of, ranking_by_handle,\n                                    cache_tickers.get(ticker))\n        rows.append(row)\n        provenance[ticker] = prov_entry\n\n    generated_at = datetime.now(timezone.utc).isoformat()\n    table = {\n        \"schema\": SCHEMA_TABLE,\n        \"generated_at\": generated_at,\n        \"source_ledger\": {\n            \"path\": \"research/tr_call_ledger.json\",\n            \"episode_count_total\": len(episodes),\n            \"distinct_tickers\": len(grouped),\n        },\n        \"as_of_date\": as_of.isoformat(),\n        \"lifecycle_rule\": {\n            \"new_call_window_days\": NEW_CALL_WINDOW_DAYS,\n            \"active_call_window_days\": ACTIVE_CALL_WINDOW_DAYS,\n            \"active_call_window_rationale\": (\n                \"120 trading sessions (SPEC.md's longest frozen evaluation horizon) \"\n                \"* 365/252 calendar-to-trading-day ratio ~= 174 calendar days\"),\n        },\n        \"opportunity_weights\": OPPORTUNITY_WEIGHTS,\n        \"row_count\": len(rows),\n        \"rows\": rows,\n        \"tickers\": [build_ticker_view(row) for row in rows],\n    }\n    provenance_doc = {\n        \"schema\": SCHEMA_PROVENANCE,\n        \"generated_at\": generated_at,\n        \"provider\": (cache or {}).get(\"provider\", \"yfinance\"),\n        \"provider_version\": (cache or {}).get(\"provider_version\"),\n        \"query_overrides\": (cache or {}).get(\"query_overrides\", {}),\n        \"override_rationale\": (cache or {}).get(\"override_rationale\"),\n        \"ticker_count\": len(provenance),\n        \"tickers\": provenance,\n    }\n    return table, provenance_doc\n\n\ndef main(argv=None) -> int:\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--ledger\", default=\"research/tr_call_ledger.json\")\n    ap.add_argument(\"--ranking\", default=\"research/tr_kol_ranking.json\")\n    ap.add_argument(\"--cache\", default=\"research/tr_ticker_yfinance_cache.json\")\n    ap.add_argument(\"--out-table\", default=\"research/tr_ticker_table.json\")\n    ap.add_argument(\"--out-provenance\", default=\"research/tr_ticker_enrichment_provenance.json\")\n    args = ap.parse_args(argv)\n\n    ledger = load_json(args.ledger)\n    if ledger is None:\n        raise SystemExit(f\"required ledger not found: {args.ledger}\")\n    ranking = load_json(args.ranking)\n    cache = load_json(args.cache)\n\n    table, provenance = build(ledger, ranking, cache)\n\n    Path(args.out_table).write_text(json.dumps(table, indent=2, sort_keys=True) + \"\\n\",\n                                    encoding=\"utf-8\")\n    Path(args.out_provenance).write_text(\n        json.dumps(provenance, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n    print(f\"wrote {table['row_count']} ticker rows -> {args.out_table}\")\n    print(f\"wrote provenance for {provenance['ticker_count']} tickers -> {args.out_provenance}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","lineStart":1,"lineEnd":665,"totalLines":665,"truncated":false}},"title":"scripts/build_tr_ticker_table.py","time":{"start":1790182998462,"end":1790182998487}},"id":"prt_0cf38c1b4001yJFjCRlKp23bN5","sessionID":"ses_f30c77858ffeQU0a2T0vQ13xKn","messageID":"msg_0cf38b106001EypwDrBgm8qULP"}}
