{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "verdict",
    "milestone",
    "spec_sha256",
    "plan_sha256",
    "blocking_findings"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "PLAN_ACCEPT",
        "PLAN_BLOCK"
      ]
    },
    "milestone": {
      "type": "string"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blocking_findings": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    }
  },
  "additionalProperties": true
}